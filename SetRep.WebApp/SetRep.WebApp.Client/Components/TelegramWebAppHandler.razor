@using SetRep.WebApp.Client.Services
@using SetRep.Shared.Telegram
@inject ITelegramWebAppService TelegramWebAppService
@implements IAsyncDisposable
@rendermode InteractiveWebAssembly

@if (_isValidating)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    <MudText>Проверка данных Telegram WebApp...</MudText>
}
else if (_validationResult != null)
{
    if (_validationResult.IsValid && _validationResult.Data != null)
    {
        <MudAlert Severity="Severity.Success">
            <MudText Typo="Typo.h6">Данные Telegram WebApp успешно проверены!</MudText>
            <MudText>Пользователь: @_validationResult.Data.User.FirstName @_validationResult.Data.User.LastName</MudText>
            <MudText>ID: @_validationResult.Data.User.Id</MudText>
            @if (!string.IsNullOrEmpty(_validationResult.Data.User.Username))
            {
                <MudText>Username: @_validationResult.Data.User.Username</MudText>
            }
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Error">
            <MudText Typo="Typo.h6">Ошибка валидации</MudText>
            <MudText>@_validationResult.ErrorMessage</MudText>
        </MudAlert>
    }
}
else if (!_hasTgWebAppData)
{
    <MudAlert Severity="Severity.Info">
        <MudText>Приложение не запущено из Telegram WebApp. Параметр tgWebAppData отсутствует.</MudText>
    </MudAlert>
}

@code {
    private bool _isValidating = false;
    private bool _hasTgWebAppData = false;
    private TelegramWebAppValidationResult? _validationResult;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ValidateTelegramWebAppData();
        }
    }

    private async Task ValidateTelegramWebAppData()
    {
        var tgWebAppData = TelegramWebAppService.GetTgWebAppDataFromQuery();
        
        if (string.IsNullOrEmpty(tgWebAppData))
        {
            _hasTgWebAppData = false;
            StateHasChanged();
            return;
        }

        _hasTgWebAppData = true;
        _isValidating = true;
        StateHasChanged();

        _validationResult = await TelegramWebAppService.ValidateAsync(tgWebAppData);

        _isValidating = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        // Cleanup if needed
        await Task.CompletedTask;
    }
}

