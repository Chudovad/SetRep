# База данных PostgreSQL
POSTGRES_DB=SetRepDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=localdb
POSTGRES_PORT=5432

# Бэкапы PostgreSQL (сервис postgres-backup)
# Дамп всего кластера (pg_dumpall): все БД, роли, права.
# Путь на хосте. Для автозагрузки в Яндекс.Диск укажите папку внутри синхронизируемого каталога, например:
#   macOS: /Users/ваш_логин/Yandex.Disk/SetRep/backups
#   Linux: /home/ваш_логин/Yandex.Disk/SetRep/backups
POSTGRES_BACKUP_DIR=./backups/postgres
# Расписание cron: @hourly, @daily, @weekly или выражение (например 0 3 * * *)
POSTGRES_BACKUP_SCHEDULE=@daily
POSTGRES_BACKUP_KEEP_DAYS=7
POSTGRES_BACKUP_KEEP_WEEKS=4
POSTGRES_BACKUP_KEEP_MONTHS=6
# Сделать бэкап сразу при старте контейнера
POSTGRES_BACKUP_ON_START=TRUE
# Часовой пояс для расписания
TZ=Europe/Moscow

# Токен Telegram бота (обязательно)
BOT_TOKEN=your_bot_token_here

# JWT Secret Key для API (обязательно, минимум 32 символа)
JWT_SECRET_KEY=your-secret-key-here-change-in-production-min-32-characters

# URL для webhook бота (обязательно)
# Пример: https://yourdomain.com/bot или http://localhost:5083/bot
BOT_WEBHOOK_URL=https://yourdomain.com/bot

# Порты для API
API_HTTP_PORT=5181
API_HTTPS_PORT=7097

# Порты для Bot
BOT_HTTP_PORT=5083
BOT_HTTPS_PORT=7150

# Порты для MiniApp
MINIAPP_HTTP_PORT=5096
MINIAPP_HTTPS_PORT=7001

# Базовый URL API для MiniApp
# Внутри Docker сети используйте: http://api:8080
# Для внешнего доступа используйте ваш домен или IP
API_BASE_URL=http://api:8080

# Yandex Object Storage настройки
YANDEX_OBJECT_STORAGE_ACCESS_KEY=your_access_key_here
YANDEX_OBJECT_STORAGE_SECRET_KEY=your_secret_key_here
YANDEX_OBJECT_STORAGE_ENDPOINT=https://storage.yandexcloud.net
YANDEX_OBJECT_STORAGE_BUCKET_NAME=setrep.image
YANDEX_OBJECT_STORAGE_SERVICE_URL=https://storage.yandexcloud.net

# Ограничения загрузки файлов
FILE_UPLOAD_MAX_SIZE_BYTES=1048576
FILE_UPLOAD_MAX_UPLOADS_PER_USER=10
