@page "/"
@rendermode InteractiveServer

<PageTitle>SetRep - Главная</PageTitle>

<div class="home-container">
    <!-- Карточка текущего веса -->
    <MudCard Elevation="2" Class="mb-4 stat-card">
        <MudCardContent>
            <div class="stat-header">
                <MudIcon Icon="@Icons.Material.Filled.MonitorWeight" Size="Size.Large" Color="Color.Primary" />
                <div class="stat-content">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Текущий вес</MudText>
                    <MudText Typo="Typo.h4" Class="mt-1">@(CurrentWeight?.ToString("F1") ?? "--") кг</MudText>
                </div>
            </div>
        </MudCardContent>
    </MudCard>

    <!-- Карточка тренировок за неделю -->
    <MudCard Elevation="2" Class="mb-4 stat-card">
        <MudCardContent>
            <div class="stat-header">
                <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Large" Color="Color.Success" />
                <div class="stat-content">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Тренировок за неделю</MudText>
                    <MudText Typo="Typo.h4" Class="mt-1">@WeeklyWorkouts</MudText>
                </div>
            </div>
        </MudCardContent>
    </MudCard>

    <!-- Карточка ближайшей тренировки -->
    @if (NextWorkout != null)
    {
        <MudCard Elevation="2" Class="mb-4 workout-card">
            <MudCardContent>
                <MudText Typo="Typo.h6" GutterBottom="true">Ближайшая тренировка</MudText>
                <MudText Typo="Typo.body1" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" Class="mr-2" />
                    @NextWorkout.Date.ToString("dd MMMM yyyy")
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @NextWorkout.ExerciseCount упражнений
                </MudText>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <MudCard Elevation="2" Class="mb-4 workout-card">
            <MudCardContent>
                <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center">
                    Нет запланированных тренировок
                </MudText>
            </MudCardContent>
        </MudCard>
    }

    <!-- Быстрые действия -->
    <MudText Typo="Typo.h6" Class="mb-3 mt-4">Быстрые действия</MudText>
    
    <div class="quick-actions">
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   FullWidth="true" 
                   Class="mb-3 quick-action-btn"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddWorkout">
            Добавить тренировку
        </MudButton>
        
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Primary" 
                   FullWidth="true" 
                   Class="quick-action-btn"
                   StartIcon="@Icons.Material.Filled.Scale"
                   OnClick="RecordWeight">
            Записать вес
        </MudButton>
    </div>
</div>

<style>
    .home-container {
        max-width: 100%;
    }

    .stat-card {
        border-radius: 12px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-2px);
    }

    .stat-header {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .stat-content {
        flex: 1;
    }

    .workout-card {
        border-radius: 12px;
    }

    .quick-actions {
        margin-top: 8px;
    }

    .quick-action-btn {
        height: 48px;
        border-radius: 12px;
        text-transform: none;
        font-weight: 500;
    }
</style>

@code {
    private double? CurrentWeight { get; set; } = 75.5;
    private int WeeklyWorkouts { get; set; } = 3;
    private WorkoutInfo? NextWorkout { get; set; } = new WorkoutInfo 
    { 
        Date = DateTime.Now.AddDays(1), 
        ExerciseCount = 5 
    };

    private void AddWorkout()
    {
        // TODO: Навигация на страницу добавления тренировки
    }

    private void RecordWeight()
    {
        // TODO: Открыть диалог записи веса
    }

    private class WorkoutInfo
    {
        public DateTime Date { get; set; }
        public int ExerciseCount { get; set; }
    }
}
