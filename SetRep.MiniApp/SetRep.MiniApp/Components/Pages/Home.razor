@page "/"
@using SetRep.Core.ApiRequestServices
@using SetRep.Core.Entities
@using SetRep.MiniApp.Client.Services
@using SetRep.MiniApp.Components.Dialog
@using SetRep.Shared.DTO
@using static SetRep.MiniApp.Client.Services.InitializationHelper

@rendermode InteractiveWebAssembly

@inject IWorkoutHistoryService WorkoutHistoryService
@inject IWorkoutService WorkoutService
@inject IMeasurementsHistoryService MeasurementsHistoryService
@inject ITelegramWebAppStateService TelegramWebAppStateService
@inject ITelegramBackButtonService TelegramBackButtonService
@inject ITelegramHapticService TelegramHapticService
@inject IAppInitializationService AppInitializationService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>SetRep - Главная страница</PageTitle>

<div class="home-container">

    <!-- Карточка тренировок за неделю -->
    <MudCard Elevation="2" Class="mb-4 stat-card">
        <MudCardContent>
            <div class="stat-header">
                <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Large" Color="Color.Success" />
                <div class="stat-content">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Тренировок за неделю</MudText>
                    <MudText Typo="Typo.h4" Class="mt-1">@WeeklyWorkouts</MudText>
                </div>
            </div>
        </MudCardContent>
    </MudCard>

    <!-- Карточка записи веса -->
    <MudCard Elevation="2" Class="mb-4">
        <MudCardContent>
            <MudStack Row AlignItems="AlignItems.Center">
                <MudNumericField T="decimal?"
                                 Step="0.1m"
                                 Label="Текущий вес (кг)"
                                 @bind-Value="currentWeightInput"
                                 Variant="Variant.Outlined"
                                 Adornment="Adornment.End"
                                 AdornmentIcon="@Icons.Material.Filled.Scale" />
                <MudButton Variant="Variant.Filled"
                           Size="Size.Small"
                           Color="Color.Primary"
                           Disabled="isSavingWeight"
                           Style="height: 56px;"
                           OnClick="RecordWeightAsync">
                    @if (isSavingWeight)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <span>Записать</span>
                    }
                </MudButton>
            </MudStack>
        </MudCardContent>
    </MudCard>

    <!-- Карточка активной тренировки или выбор тренировки -->
    @if (isLoadingWorkout)
    {
        <MudCard Elevation="2" Class="mb-4 workout-card">
            <MudCardContent>
                <MudSkeleton Width="50%" Height="24px" Class="mb-3" />
                <MudSkeleton Width="100%" Height="48px" />
            </MudCardContent>
        </MudCard>
    }
    else if (activeWorkoutHistory != null)
    {
        <MudCard Elevation="2" Class="mb-4 workout-card active-workout-card">
            <MudCardContent>
                <div class="active-workout-header">
                    <div class="active-workout-info">
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text" Class="mb-2">
                            Активная тренировка
                        </MudChip>
                        <MudText Typo="Typo.h6" Class="mb-1">
                            @(activeWorkoutHistory.Workout?.Name ?? "Тренировка")
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Начата: @FormatDate(activeWorkoutHistory.StartTime)
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                            Длительность: @FormatDuration(DateTime.UtcNow - activeWorkoutHistory.StartTime)
                        </MudText>
                    </div>
                </div>
                <div class="active-workout-actions">
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Info" 
                               FullWidth="true" 
                               Class="mt-3"
                               OnClick="() => NavigateToActiveWorkout()">
                        Продолжить тренировку
                    </MudButton>
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Error" 
                               FullWidth="true" 
                               Class="mt-2"
                               OnClick="OpenEndActiveWorkoutDialog"
                               Disabled="isEndingWorkout">
                        @if (isEndingWorkout)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <span class="ms-2">Завершение...</span>
                        }
                        else
                        {
                            <span>Завершить тренировку</span>
                        }
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <MudCard Elevation="2" Class="mb-4 workout-card">
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-3">Начать тренировку</MudText>
                @if (workouts != null && workouts.Any())
                {
                    <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" FullWidth="true">
                        <MudButton OnClick="StartSelectedWorkout" Disabled="!selectedWorkoutId.HasValue || isStartingWorkout">
                            @if (isStartingWorkout)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <span class="ms-2">Запуск...</span>
                            }
                            else
                            {
                                <span>@(selectedWorkoutName ?? "Выберите тренировку")</span>
                            }
                        </MudButton>
                        <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" Style="align-self: auto;" Disabled="isStartingWorkout">
                            @foreach (var workout in workouts)
                            {
                                <MudMenuItem OnClick="() => SelectWorkout(workout.Id, workout.Name)">
                                    @workout.Name
                                </MudMenuItem>
                            }
                        </MudMenu>
                    </MudButtonGroup>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddWorkout">
                        Добавить тренировку
                    </MudButton>
                }
            </MudCardContent>
        </MudCard>
    }
</div>

<style>
    .home-container {
        max-width: 100%;
    }

    .stat-card {
        border-radius: 12px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-2px);
    }

    .stat-header {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .stat-content {
        flex: 1;
    }

    .workout-card {
        border-radius: 12px;
    }

    .quick-actions {
        margin-top: 8px;
    }

    .loading-state-small {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }

    .active-workout-card {
        border: 2px solid var(--mud-palette-primary);
    }

    .active-workout-header {
        display: flex;
        flex-direction: column;
    }

    .active-workout-info {
        flex: 1;
    }

    .active-workout-actions {
        display: flex;
        flex-direction: column;
    }
</style>

@code {
    private int WeeklyWorkouts { get; set; } = 0;

    private WorkoutHistory? activeWorkoutHistory;
    private List<SetRep.Core.Entities.Workout>? workouts;
    private bool isLoadingWorkout = true;
    private bool isStartingWorkout = false;
    private bool isEndingWorkout = false;
    private Guid? selectedWorkoutId;
    private string? selectedWorkoutName;

    private decimal? currentWeightInput;
    private bool isSavingWeight = false;

    private bool _isDataLoaded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isDataLoaded)
        {
            await WaitForInitializationAsync(AppInitializationService);
            await LoadWorkoutData();
            _isDataLoaded = true;
            await TelegramBackButtonService.HideAsync();
            StateHasChanged();
        }
    }

    private async Task LoadWorkoutData()
    {
        isLoadingWorkout = true;

        try
        {
            Guid userId = Guid.Empty;
            if (TelegramWebAppStateService.ValidationResult?.Data?.User != null)
            {
                userId = TelegramWebAppStateService.ValidationResult.Data.User.Id;
            }

            if (userId == Guid.Empty)
            {
                isLoadingWorkout = false;
                return;
            }

            var activeWorkoutTask = WorkoutHistoryService.GetActiveWorkoutAsync(userId);
            var workoutsTask = WorkoutService.GetWorkoutsAsync(userId);
            var workoutHistoryTask = WorkoutHistoryService.GetWorkoutHistoryByUserIdAsync(userId);
            var measurementsTask = MeasurementsHistoryService.GetMeasurementsHistoryByUserIdAsync(userId);

            await Task.WhenAll(activeWorkoutTask, workoutsTask, workoutHistoryTask, measurementsTask);

            activeWorkoutHistory = await activeWorkoutTask;
            workouts = await workoutsTask;
            var workoutHistory = await workoutHistoryTask;
            var measurements = await measurementsTask;

            // Предыдущий вес в поле ввода
            if (measurements != null && measurements.Any())
            {
                var lastWithWeight = measurements
                    .Where(m => m.BodyWeight.HasValue)
                    .OrderByDescending(m => m.Date)
                    .FirstOrDefault();
                currentWeightInput = lastWithWeight?.BodyWeight;
            }
            else
            {
                currentWeightInput = null;
            }

            // Подсчет тренировок за последние 7 дней
            if (workoutHistory != null)
            {
                var weekAgo = DateTime.UtcNow.AddDays(-7);
                WeeklyWorkouts = workoutHistory
                    .Where(wh => wh.EndTime.HasValue && wh.EndTime.Value >= weekAgo)
                    .Count();
            }
            else
            {
                WeeklyWorkouts = 0;
            }

            if (activeWorkoutHistory == null && workouts != null && workouts.Any())
            {
                selectedWorkoutId = workouts.First().Id;
                selectedWorkoutName = workouts.First().Name;
            }
        }
        catch
        {
            // Игнорируем ошибки загрузки
            WeeklyWorkouts = 0;
        }
        finally
        {
            isLoadingWorkout = false;
        }
    }

    private void SelectWorkout(Guid workoutId, string workoutName)
    {
        selectedWorkoutId = workoutId;
        selectedWorkoutName = workoutName;
        StateHasChanged();
    }

    private async Task StartSelectedWorkout()
    {
        if (!selectedWorkoutId.HasValue || isStartingWorkout)
        {
            return;
        }

        isStartingWorkout = true;
        StateHasChanged();

        try
        {
            Guid userId = Guid.Empty;
            if (TelegramWebAppStateService.ValidationResult?.Data?.User != null)
            {
                userId = TelegramWebAppStateService.ValidationResult.Data.User.Id;
            }

            if (userId == Guid.Empty)
            {
                await TelegramHapticService.NotificationErrorAsync();
                Snackbar.Add("Не удалось определить пользователя", Severity.Error);
                return;
            }

            var workoutId = selectedWorkoutId.Value;
            var workoutHistory = await WorkoutHistoryService.StartWorkoutAsync(workoutId, userId);

            if (workoutHistory != null)
            {
                await WorkoutHistoryService.CopySetsFromWorkoutAsync(workoutHistory.Id, workoutId);
                activeWorkoutHistory = workoutHistory;
                Navigation.NavigateTo($"/workouts/{workoutHistory.WorkoutId}/active/{workoutHistory.Id}");
            }
            else
            {
                await TelegramHapticService.NotificationErrorAsync();
                Snackbar.Add("Не удалось начать тренировку. Попробуйте еще раз.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            await TelegramHapticService.NotificationErrorAsync();
            Snackbar.Add($"Ошибка при начале тренировки: {ex.Message}", Severity.Error);
        }
        finally
        {
            isStartingWorkout = false;
            StateHasChanged();
        }
    }

    private void NavigateToActiveWorkout()
    {
        if (activeWorkoutHistory != null)
        {
            Navigation.NavigateTo($"/workouts/{activeWorkoutHistory.WorkoutId}/active/{activeWorkoutHistory.Id}");
        }
    }

    private async Task OpenEndActiveWorkoutDialog()
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { nameof(ConfirmDialog.Title), "Подтверждение завершения" },
            { nameof(ConfirmDialog.ContentText), $"Вы уверены, что хотите завершить тренировку?" },
            { nameof(ConfirmDialog.ButtonText), "Завершить" },
            { nameof(ConfirmDialog.Color), Color.Error },
            { nameof(ConfirmDialog.ShowUpdateWorkoutTemplateCheckbox), true }
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialogReference = await DialogService.ShowAsync<ConfirmDialog>("Подтверждение завершения", parameters, options);
        var result = await dialogReference.Result;

        if (result != null && !result.Canceled)
        {
            var updateTemplate = result.Data is bool b ? b : true;
            await EndActiveWorkout(updateTemplate);
        }
    }

    private async Task EndActiveWorkout(bool updateWorkoutTemplateFromHistory = true)
    {
        if (activeWorkoutHistory == null)
        {
            return;
        }

        isEndingWorkout = true;
        StateHasChanged();

        try
        {
            var success = await WorkoutHistoryService.EndWorkoutAsync(activeWorkoutHistory.Id, updateWorkoutTemplateFromHistory);

            if (success)
            {
                activeWorkoutHistory = null;
                await LoadWorkoutData();
            }
            else
            {
                await TelegramHapticService.NotificationErrorAsync();
                Snackbar.Add("Не удалось завершить тренировку. Попробуйте еще раз.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            await TelegramHapticService.NotificationErrorAsync();
            Snackbar.Add($"Ошибка при завершении тренировки: {ex.Message}", Severity.Error);
        }
        finally
        {
            isEndingWorkout = false;
            StateHasChanged();
        }
    }

    private string FormatDate(DateTime date)
    {
        var localDate = date.AddHours(3); // UTC+3
        return localDate.ToString("dd.MM.yyyy HH:mm");
    }

    private string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalHours >= 1)
        {
            return $"{(int)duration.TotalHours}ч {duration.Minutes}м";
        }
        return $"{duration.Minutes}м {duration.Seconds}с";
    }

    private void AddWorkout()
    {
        Navigation.NavigateTo("/workouts/add");
    }

    private async Task RecordWeightAsync()
    {
        if (isSavingWeight)
        {
            return;
        }

        Guid userId = Guid.Empty;
        if (TelegramWebAppStateService.ValidationResult?.Data?.User != null)
        {
            userId = TelegramWebAppStateService.ValidationResult.Data.User.Id;
        }

        if (userId == Guid.Empty)
        {
            await TelegramHapticService.NotificationErrorAsync();
            Snackbar.Add("Не удалось определить пользователя", Severity.Error);
            return;
        }

        if (!currentWeightInput.HasValue || currentWeightInput.Value <= 0)
        {
            Snackbar.Add("Введите корректный текущий вес", Severity.Warning);
            return;
        }

        isSavingWeight = true;
        StateHasChanged();

        try
        {
            var dto = new CreateMeasurementsHistoryDto
            {
                UserId = userId,
                Date = DateTime.UtcNow.Date,
                BodyWeight = currentWeightInput
            };

            var created = await MeasurementsHistoryService.CreateMeasurementsHistoryAsync(dto);

            if (created != null)
            {
                await TelegramHapticService.NotificationSuccessAsync();
                Snackbar.Add("Текущий вес успешно записан", Severity.Success);
            }
            else
            {
                await TelegramHapticService.NotificationErrorAsync();
                Snackbar.Add("Не удалось записать вес. Попробуйте еще раз.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            await TelegramHapticService.NotificationErrorAsync();
            Snackbar.Add($"Ошибка при записи веса: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSavingWeight = false;
            StateHasChanged();
        }
    }
}
