@page "/workouts/plans/{PlanId:guid}"
@using SetRep.Core.ApiRequestServices
@using SetRep.Core.Entities
@using SetRep.Core.Extensions
@using SetRep.MiniApp.Client.Services
@using static SetRep.MiniApp.Client.Services.InitializationHelper
@rendermode InteractiveServer
@inject IWorkoutPlanService WorkoutPlanService
@inject IReadyWorkoutPlanService ReadyWorkoutPlanService
@inject ITelegramWebAppStateService TelegramWebAppStateService
@inject ITelegramBackButtonService TelegramBackButtonService
@inject IAppInitializationService AppInitializationService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>SetRep - @(plan?.Name ?? "План")</PageTitle>

<div class="plan-view-container">
    @if (isLoading)
    {
        <MudSkeleton Height="32px" Width="70%" Class="mb-3" />
        <MudSkeleton Height="24px" Width="100%" Class="mb-2" />
        <MudSkeleton Height="24px" Width="80%" />
    }
    else if (errorMessage != null)
    {
        <MudCard Elevation="2" Class="error-card">
            <MudCardContent>
                <div class="error-state">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" Class="mb-4" />
                    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-2">Ошибка загрузки</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4">@errorMessage</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadPlan">
                        Попробовать снова
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
    else if (plan != null)
    {
        <MudText Typo="Typo.h4" Class="mb-4">@plan.Name</MudText>

        @if (readyPlan != null)
        {
            <MudCard Elevation="2" Class="mb-4 ready-plan-info-card">
                <MudCardContent>
                    @if (!string.IsNullOrWhiteSpace(readyPlan.Note))
                    {
                        <MudText Typo="Typo.body1" Class="mb-2">@readyPlan.Note</MudText>
                    }
                    <div class="badges-row">
                        <MudChip T="ReadyPlanLevel" Size="Size.Small" Class="mr-1">@readyPlan.Level.GetDescription()</MudChip>
                        <MudChip T="ReadyPlanGoal" Size="Size.Small" Class="mr-1">@readyPlan.Goal.GetDescription()</MudChip>
                        <MudChip T="ReadyPlanEquipment" Size="Size.Small">@readyPlan.Equipment.GetDescription()</MudChip>
                    </div>
                </MudCardContent>
            </MudCard>
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Class="mb-4"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="@isSaving"
                   OnClick="SavePlan">
            @if (isSaving)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Сохранение...</MudText>
            }
            else
            {
                <MudText>Сохранить план</MudText>
            }
        </MudButton>

        <MudText Typo="Typo.h6" Class="mb-3">Тренировки в плане</MudText>
        @if (plan.Workouts != null && plan.Workouts.Any())
        {
            var orderedWorkouts = plan.Workouts.OrderByDescending(w => w.CreatedAt).ToList();
            @foreach (var w in orderedWorkouts)
            {
                <MudCard Elevation="2" Class="mb-3 workout-link-card" @onclick="() => NavigateToWorkout(w.Id)">
                    <MudCardContent>
                        <div class="d-flex align-center justify-space-between">
                            <MudText Typo="Typo.body1">@w.Name</MudText>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
                        </div>
                    </MudCardContent>
                </MudCard>
            }
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">В плане пока нет тренировок.</MudText>
        }
    }
</div>

<style>
    .plan-view-container { max-width: 100%; }
    .ready-plan-info-card { }
    .badges-row { display: flex; flex-wrap: wrap; gap: 4px; }
    .workout-link-card { cursor: pointer; }
</style>

@code {
    [Parameter] public Guid PlanId { get; set; }

    private WorkoutPlan? plan;
    private ReadyWorkoutPlan? readyPlan;
    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await WaitForInitializationAsync(AppInitializationService);
            await LoadPlan();
            await TelegramBackButtonService.ShowAsync();
            StateHasChanged();
        }
    }

    private async Task LoadPlan()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();
        try
        {
            plan = await WorkoutPlanService.GetWorkoutPlanDetailsAsync(PlanId);
            readyPlan = await ReadyWorkoutPlanService.GetReadyPlanByWorkoutPlanIdAsync(PlanId);
            if (plan == null)
                errorMessage = "План не найден.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void NavigateToWorkout(Guid workoutId)
    {
        Navigation.NavigateTo($"/workouts/{workoutId}");
    }

    private async Task SavePlan()
    {
        if (plan == null || isSaving) return;
        isSaving = true;
        StateHasChanged();
        try
        {
            var newPlan = await WorkoutPlanService.CopyPlanToMyPlansAsync(PlanId);
            if (newPlan != null)
            {
                Snackbar.Add("План сохранён в ваши тренировки", Severity.Success);
                Navigation.NavigateTo("/workouts");
            }
            else
            {
                Snackbar.Add("Не удалось сохранить план", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }
}
