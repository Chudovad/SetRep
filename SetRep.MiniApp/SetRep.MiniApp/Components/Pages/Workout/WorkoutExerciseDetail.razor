@page "/workouts/{WorkoutId:guid}/exercises/{WorkoutExerciseId:guid}"
@using SetRep.Core.ApiRequestServices
@using SetRep.Core.Entities
@using SetRep.MiniApp.Client.Services
@using SetRep.MiniApp.Components.Dialog
@using SetRep.Shared.DTO
@using static SetRep.MiniApp.Client.Services.InitializationHelper
@rendermode InteractiveServer
@inject IWorkoutExerciseService WorkoutExerciseService
@inject IWorkoutService WorkoutService
@inject NavigationManager Navigation
@inject ITelegramBackButtonService TelegramBackButtonService
@inject ITelegramWebAppStateService TelegramWebAppStateService
@inject IAppInitializationService AppInitializationService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IAsyncDisposable

<PageTitle>SetRep - @(workoutExercise?.Exercise?.Name ?? "Упражнение")</PageTitle>

@if (isLoading)
{
    <div class="workout-exercise-detail-container">
        @* Скелетон навигации *@
        <MudCard Elevation="2" Class="mb-4 navigation-card">
            <MudCardContent>
                <div class="navigation-header">
                    <MudSkeleton Width="40px" Height="40px" SkeletonType="SkeletonType.Circle" />
                    <div class="navigation-display d-flex flex-column align-center justify-center flex-grow-1">
                        <MudSkeleton Width="80px" Height="24px" Class="mb-1" />
                        <MudSkeleton Width="150px" Height="20px" />
                    </div>
                    <MudSkeleton Width="40px" Height="40px" SkeletonType="SkeletonType.Circle" />
                </div>
            </MudCardContent>
        </MudCard>

        @* Скелетон изображения упражнения *@
        <MudCard Elevation="2" Class="mb-4 exercise-image-card">
            <MudCardContent Class="pa-0">
                <MudSkeleton Height="300px" Width="100%" />
            </MudCardContent>
        </MudCard>

        @* Скелетон описания *@
        <MudSkeleton Width="100%" Height="60px" Class="mb-4" />

        @* Скелетон таблицы подходов *@
        <MudCard Elevation="2" Class="mb-4 sets-table-card">
            <MudCardContent>
                <MudSkeleton Typo="Typo.h6" Width="100px" Height="24px" Class="mb-3" />
                @* Скелетон таблицы *@
                <div class="skeleton-table">
                    <div class="skeleton-table-header">
                        <MudSkeleton Width="30px" Height="20px" />
                        <MudSkeleton Width="50px" Height="20px" />
                        <MudSkeleton Width="60px" Height="20px" />
                        <MudSkeleton Width="40px" Height="20px" />
                    </div>
                    @for (int j = 0; j < 3; j++)
                    {
                        <div class="skeleton-table-row">
                            <MudSkeleton Width="20px" Height="20px" />
                            <MudSkeleton Width="40px" Height="20px" />
                            <MudSkeleton Width="30px" Height="20px" />
                            <MudSkeleton Width="30px" Height="30px" SkeletonType="SkeletonType.Circle" />
                        </div>
                    }
                </div>
            </MudCardContent>
        </MudCard>
    </div>
}
else if (errorMessage != null)
{
    <div class="workout-exercise-detail-container">
        <MudCard Elevation="2" Class="error-card">
            <MudCardContent>
                <div class="error-state">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" Class="mb-4" />
                    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-2">
                        Ошибка загрузки
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4">
                        @errorMessage
                    </MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadWorkout">
                        Попробовать снова
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    </div>
}
else if (workoutExercise != null && workoutExercise.Exercise != null)
{
    <div class="workout-exercise-detail-container">
        <!-- Навигация между упражнениями -->
        @if (exercises != null && exercises.Any())
        {
            <MudCard Elevation="2" Class="mb-4 navigation-card">
                <MudCardContent>
                    <div class="navigation-header">
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                       Color="Color.Primary"
                                       OnClick="PreviousExercise"
                                       Disabled="currentExerciseIndex == 0" />
                        <div class="navigation-display">
                            <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-1">
                                @(currentExerciseIndex + 1) из @exercises.Count
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                                @workoutExercise.Exercise.Name
                            </MudText>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowForward"
                                       Color="Color.Primary"
                                       OnClick="NextExercise"
                                       Disabled="currentExerciseIndex >= exercises.Count - 1" />
                    </div>
                </MudCardContent>
            </MudCard>
        }

        <!-- Табы -->
        <MudTabs Elevation="2" Class="mb-4 tabs-sticky" @bind-ActivePanelIndex="activeTabIndex" Centered="true">
            <!-- Таб 1: Подходы -->
            <MudTabPanel Text="Подходы">
                <!-- Картинка упражнения -->
                @if (!string.IsNullOrWhiteSpace(workoutExercise.Exercise.Image))
                {
                    <MudCard Elevation="2" Class="mb-4 mt-4 exercise-image-card">
                        <MudCardContent Class="pa-0">
                            @if (workoutExercise.Exercise.Image.EndsWith(".mp4"))
                            {
                                <video src="@workoutExercise.Exercise.Image"
                                       autoplay
                                       loop
                                       playsinline
                                       muted
                                       class="exercise-video"
                                       title="@workoutExercise.Exercise.Name"></video>
                            }
                            else
                            {
                                <img src="@workoutExercise.Exercise.Image" alt="@workoutExercise.Exercise.Name" class="exercise-image" />
                            }
                        </MudCardContent>
                    </MudCard>
                }
                else
                {
                    <MudCard Elevation="2" Class="mb-4 exercise-image-card">
                        <MudCardContent>
                            <div class="exercise-image-placeholder">
                                <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Large" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mt-2">
                                    Изображение отсутствует
                                </MudText>
                            </div>
                        </MudCardContent>
                    </MudCard>
                }

                <!-- Название упражнения -->
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardContent>
                        <div class="exercise-header-with-actions">
                            <MudText Typo="Typo.h6" Class="exercise-name-header">@workoutExercise.Exercise.Name</MudText>
                            @if (!isReadOnly)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz"
                                               Color="Color.Primary"
                                               Size="Size.Medium"
                                               OnClick="ReplaceExercise"
                                               Title="Заменить упражнение" />
                            }
                        </div>
                    </MudCardContent>
                </MudCard>

                <!-- Заметки к упражнению в тренировке (сворачиваемая) -->
                @if (!string.IsNullOrWhiteSpace(workoutExercise.Notes))
                {
                    <MudExpansionPanels Class="mb-4">
                        <MudExpansionPanel Text="Заметки к упражнению">
                            <MudText Typo="Typo.body1" Style="white-space: pre-wrap;">@workoutExercise.Notes</MudText>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                }

                <!-- Таблица подходов -->
                @if (sets != null && sets.Any())
                {
                    <MudCard Elevation="2" Class="sets-table-card">
                        <MudCardContent>
                            <MudText Typo="Typo.h6" Class="mb-3">Подходы</MudText>
                            <MudTable Items="@sets" Hover="true" Dense="true" Class="compact-table" Breakpoint="Breakpoint.None">
                                <HeaderContent>
                                    <MudTh>№</MudTh>
                                    <MudTh>Вес</MudTh>
                                    <MudTh>Повт.</MudTh>
                                    @if (!isReadOnly)
                                    {
                                        <MudTh> </MudTh>
                                    }
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="№">@context.SetNumber</MudTd>
                                    <MudTd DataLabel="Вес">
                                        @if (isReadOnly)
                                        {
                                            @if (context.Weight.HasValue)
                                            {
                                                @context.Weight.Value.ToString("0.##")
                                                @(workoutExercise.Exercise.WeightUnit)
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                                            }
                                        }
                                        else if (editingSetId == context.Id && editingField == "weight")
                                        {
                                            <MudNumericField T="decimal?"
                                                             @bind-Value="editingWeight"
                                                             Variant="Variant.Outlined"
                                                             Min="0"
                                                             Step="@((decimal?)GetWeightStep())"
                                                             Immediate="true"
                                                             Style="width: 80px;"
                                                             Margin="Margin.Dense"
                                                             @onblur="() => SaveSet(context.Id)" />
                                        }
                                        else
                                        {
                                            <span @onclick="() => StartEditing(context.Id, weightString, context.Weight)" style="cursor: pointer;">
                                                @if (context.Weight.HasValue)
                                                {
                                                    @context.Weight.Value.ToString("0.##")
                                                    @(workoutExercise.Exercise.WeightUnit)
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                                                }
                                            </span>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Повторения">
                                        @if (isReadOnly)
                                        {
                                            @if (context.Reps > 0)
                                            {
                                                @context.Reps
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                                            }
                                        }
                                        else if (editingSetId == context.Id && editingField == "reps")
                                        {
                                            <MudNumericField T="int"
                                                             @bind-Value="editingReps"
                                                             Variant="Variant.Outlined"
                                                             Min="0"
                                                             Step="1"
                                                             Immediate="true"
                                                             Style="width: 80px;"
                                                             Margin="Margin.Dense"
                                                             @onblur="() => SaveSet(context.Id)" />
                                        }
                                        else
                                        {
                                            <span @onclick="() => StartEditing(context.Id, repsString, context.Reps)" style="cursor: pointer;">
                                                @if (context.Reps > 0)
                                                {
                                                    @context.Reps
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                                                }
                                            </span>
                                        }
                                    </MudTd>
                                    @if (!isReadOnly)
                                    {
                                        <MudTd DataLabel="Действия">
                                            @if (editingSetId == context.Id)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Check"
                                                               Color="Color.Success"
                                                               Size="Size.Small"
                                                               OnClick="() => SaveSet(context.Id)" />
                                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                               Color="Color.Default"
                                                               Size="Size.Small"
                                                               OnClick="CancelEditing" />
                                            }
                                            else
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                               Color="Color.Error"
                                                               Size="Size.Small"
                                                               OnClick="() => DeleteSet(context.Id)" />
                                            }
                                        </MudTd>
                                    }
                                </RowTemplate>
                            </MudTable>
                            @if (!isReadOnly)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="AddSet"
                                           Disabled="@isAddingSet"
                                           Class="mt-2">
                                    @if (isAddingSet)
                                    {
                                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                        <span class="ms-2">Добавление...</span>
                                    }
                                    else
                                    {
                                        <span>Добавить подход</span>
                                    }
                                </MudButton>
                            }
                        </MudCardContent>
                    </MudCard>
                }
                else
                {
                    <MudCard Elevation="2" Class="empty-state-card">
                        <MudCardContent>
                            <div class="empty-state">
                                <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Large" Color="Color.Secondary" Class="mb-4" />
                                <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-2">
                                    Нет подходов
                                </MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4">
                                    @(isReadOnly ? "В этом упражнении нет подходов" : "Добавьте первый подход")
                                </MudText>
                                @if (!isReadOnly)
                                {
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Add"
                                               OnClick="AddSet"
                                               Disabled="@isAddingSet">
                                        @if (isAddingSet)
                                        {
                                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                            <span class="ms-2">Добавление...</span>
                                        }
                                        else
                                        {
                                            <span>Добавить подход</span>
                                        }
                                    </MudButton>
                                }
                            </div>
                        </MudCardContent>
                    </MudCard>
                }
            </MudTabPanel>

            <!-- Таб 2: Инструкция -->
            <MudTabPanel Text="Инструкция">
                <!-- Как делать упражнение -->
                <MudCard Elevation="2" Class="mb-4 mt-4">
                    <MudCardContent>
                        <MudText Typo="Typo.h6">Как делать упражнение</MudText>
                    </MudCardContent>
                </MudCard>

                <!-- Видео как делать упражнение -->
                @if (!string.IsNullOrEmpty(workoutExercise.Exercise.VideoUrl))
                {
                    <MudCard Elevation="2" Class="mb-4">
                        <MudCardContent Class="pa-0">
                            <video src="@workoutExercise.Exercise.VideoUrl"
                                   loop
                                   playsinline
                                   muted
                                   controls
                                   class="exercise-video"
                                   title="@workoutExercise.Exercise.Name"></video>
                        </MudCardContent>
                    </MudCard>
                }

                <!-- Название упражнения -->
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardContent>
                        <MudText Typo="Typo.h6">@workoutExercise.Exercise.Name</MudText>
                    </MudCardContent>
                </MudCard>

                <!-- Описание упражнения -->
                @if (!string.IsNullOrWhiteSpace(workoutExercise.Exercise.Description))
                {
                    <MudCard Elevation="2" Class="mb-4">
                        <MudCardContent>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Style="white-space: pre-wrap;">
                                @workoutExercise.Exercise.Description
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                }
            </MudTabPanel>
        </MudTabs>
    </div>
}

<style>
    .exercise-header-with-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }

    .exercise-name-header {
        flex: 1;
    }

    .workout-exercise-detail-container {
        max-width: 100%;
        position: relative;
    }

    .navigation-card {
        border-radius: 12px;
        position: sticky;
        top: 0;
        z-index: 10;
        background-color: var(--mud-palette-background);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        margin-top: 0;
    }

    .tabs-sticky .mud-tabs-tabbar {
        position: sticky;
        top: 80px;
        z-index: 9;
        background-color: var(--mud-palette-background);
    }

    .navigation-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }

    .navigation-display {
        flex: 1;
        text-align: center;
    }

    .exercise-image {
        max-height: 400px;
    }

    .exercise-video {
        max-height: 400px;
    }

    .exercise-image-placeholder {
        padding: 48px 24px;
        min-height: 200px;
    }

    .skeleton-table {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .skeleton-table-header {
        display: flex;
        gap: 16px;
        padding: 8px 0;
        border-bottom: 1px solid var(--mud-palette-divider);
    }

    .skeleton-table-row {
        display: flex;
        gap: 16px;
        padding: 8px 0;
    }
</style>

@code {
    [Parameter] public Guid WorkoutId { get; set; }
    [Parameter] public Guid WorkoutExerciseId { get; set; }

    private Workout? workout;
    private WorkoutExercise? workoutExercise;
    private List<Set> sets = new();
    private List<WorkoutExercise> exercises = new();
    private int currentExerciseIndex = 0;
    private bool isLoading = true;
    private bool isAddingSet = false;
    private bool isReadOnly = false;
    private string? errorMessage;
    private string weightLabel = "Вес (кг)";
    private string weightString = "weight";
    private string repsString = "reps";
    private int activeTabIndex = 0;

    // Редактирование подхода
    private Guid? editingSetId;
    private string? editingField;
    private decimal? editingWeight;
    private int editingReps;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await WaitForInitializationAsync(AppInitializationService);
            await TelegramBackButtonService.ShowAsync();
            await LoadWorkout();
            StateHasChanged();
        }
    }

    private async Task LoadWorkout()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            workout = await WorkoutService.GetWorkoutDetailsAsync(WorkoutId);
            if (workout == null || workout.WorkoutExercises == null || !workout.WorkoutExercises.Any())
            {
                errorMessage = "В тренировке нет упражнений";
                return;
            }

            var currentUserId = TelegramWebAppStateService.ValidationResult?.Data?.User?.Id ?? Guid.Empty;
            isReadOnly = workout.UserId != currentUserId;

            exercises = workout.WorkoutExercises.OrderBy(we => we.Order).ToList();
            
            // Находим текущий индекс упражнения
            var currentIndex = exercises.FindIndex(we => we.Id == WorkoutExerciseId);
            if (currentIndex >= 0)
            {
                currentExerciseIndex = currentIndex;
            }
            else
            {
                currentExerciseIndex = 0;
            }
            
            workoutExercise = exercises[currentExerciseIndex];

            if (workoutExercise?.Exercise != null)
            {
                weightLabel = $"Вес ({workoutExercise.Exercise.WeightUnit})";
            }

            await LoadSetsForCurrentExercise();
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Ошибка сети при подключении к API: {ex.Message}. " +
                          "Убедитесь, что API сервер запущен и доступен.";
            workout = null;
        }
        catch (TaskCanceledException ex) when (ex.InnerException is TimeoutException)
        {
            errorMessage = "Превышено время ожидания ответа от API. Сервер может быть перегружен или недоступен.";
            workout = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось загрузить тренировку: {ex.Message}";
            workout = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadSetsForCurrentExercise()
    {
        if (workoutExercise == null)
        {
            return;
        }

        try
        {
            var loadedExercise = await WorkoutExerciseService.GetWorkoutExerciseWithSetsAsync(workoutExercise.Id);
            if (loadedExercise != null && loadedExercise.Sets != null)
            {
                sets = loadedExercise.Sets.OrderBy(s => s.SetNumber).ToList();
                // Обновляем workoutExercise, чтобы получить актуальные данные об упражнении
                workoutExercise = loadedExercise;
            }
            else
            {
                sets = new List<Set>();
            }
        }
        catch
        {
            sets = new List<Set>();
        }
    }

    private async Task AddSet()
    {
        if (workoutExercise == null)
        {
            return;
        }

        isAddingSet = true;

        try
        {
            var nextSetNumber = sets.Any() ? sets.Max(s => s.SetNumber) + 1 : 1;
            var lastSet = sets.OrderBy(s => s.SetNumber).LastOrDefault();
            var reps = lastSet?.Reps ?? 0;
            var weight = lastSet?.Weight;

            var createSetDto = new CreateSetDto
            {
                WorkoutExerciseId = workoutExercise.Id,
                SetNumber = nextSetNumber,
                Reps = reps,
                Weight = weight,
                IsCompleted = true,
                CompletedAt = DateTime.UtcNow
            };

            var createdSet = await WorkoutExerciseService.CreateSetAsync(createSetDto);
            if (createdSet != null)
            {
                await LoadSetsForCurrentExercise();
                StateHasChanged();
            }
            else
            {
                Snackbar.Add("Ошибка при добавлении подхода", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Не удалось добавить подход: {ex.Message}", Severity.Error);
        }
        finally
        {
            isAddingSet = false;
        }
    }

    private void StartEditing(Guid setId, string field, object? value)
    {
        editingSetId = setId;
        editingField = field;

        if (field == "weight" && value is decimal weight)
        {
            editingWeight = weight;
        }
        else if (field == "reps" && value is int reps)
        {
            editingReps = reps;
        }
    }

    private void CancelEditing()
    {
        editingSetId = null;
        editingField = null;
        editingWeight = null;
        editingReps = 0;
    }

    private async Task SaveSet(Guid setId)
    {
        if (workoutExercise == null || editingSetId != setId)
        {
            return;
        }

        try
        {
            var set = sets.FirstOrDefault(s => s.Id == setId);
            if (set == null)
            {
                return;
            }

            var updateDto = new CreateSetDto
            {
                WorkoutExerciseId = workoutExercise.Id,
                SetNumber = set.SetNumber,
                Reps = editingField == "reps" ? editingReps : set.Reps,
                Weight = editingField == "weight" ? editingWeight : set.Weight,
                DurationSeconds = set.DurationSeconds,
                DistanceMeters = set.DistanceMeters,
                RestSeconds = set.RestSeconds,
                IsCompleted = set.IsCompleted,
                Notes = set.Notes,
                //CompletedAt = set.CompletedAt ?? DateTime.UtcNow
            };

            var success = await WorkoutExerciseService.UpdateSetAsync(setId, updateDto);
            if (success)
            {
                await LoadSetsForCurrentExercise();
                CancelEditing();
                StateHasChanged();
            }
            else
            {
                Snackbar.Add("Ошибка при обновлении подхода", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteSet(Guid setId)
    {
        try
        {
            var success = await WorkoutExerciseService.DeleteSetAsync(setId);

            if (success)
            {
                await LoadSetsForCurrentExercise();
                CancelEditing();
                StateHasChanged();
            }
            else
            {
                Snackbar.Add("Ошибка при удалении подхода", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Не удалось удалить подход: {ex.Message}", Severity.Error);
        }
    }

    private async Task PreviousExercise()
    {
        if (currentExerciseIndex > 0 && exercises != null && exercises.Any())
        {
            currentExerciseIndex--;
            workoutExercise = exercises[currentExerciseIndex];
            if (workoutExercise?.Exercise != null)
            {
                weightLabel = $"Вес ({workoutExercise.Exercise.WeightUnit})";
            }
            await LoadSetsForCurrentExercise();
            CancelEditing();
            StateHasChanged();
        }
    }

    private async Task NextExercise()
    {
        if (currentExerciseIndex < exercises.Count - 1 && exercises != null && exercises.Any())
        {
            currentExerciseIndex++;
            workoutExercise = exercises[currentExerciseIndex];
            if (workoutExercise?.Exercise != null)
            {
                weightLabel = $"Вес ({workoutExercise.Exercise.WeightUnit})";
            }
            await LoadSetsForCurrentExercise();
            CancelEditing();
            StateHasChanged();
        }
    }

    private decimal GetWeightStep()
    {
        return ExerciseStepHelper.GetWeightStep(workoutExercise?.Exercise?.MuscleGroup);
    }

    public async ValueTask DisposeAsync()
    {

    }

    private async Task ReplaceExercise()
    {
        if (workoutExercise == null || workout == null)
            return;

        // Получаем список ID упражнений, которые уже есть в тренировке (кроме текущего)
        var excludedExerciseIds = workout.WorkoutExercises?
            .Where(we => we.Id != workoutExercise.Id)
            .Select(we => we.ExerciseId)
            .ToList() ?? new List<Guid>();

        var parameters = new DialogParameters<ReplaceExerciseDialog>
        {
            { nameof(ReplaceExerciseDialog.CurrentWorkoutExercise), workoutExercise },
            { nameof(ReplaceExerciseDialog.ExcludedExerciseIds), excludedExerciseIds }
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialogReference = await DialogService.ShowAsync<ReplaceExerciseDialog>("Заменить упражнение", parameters, options);
        var result = await dialogReference.Result;

        if (result != null && !result.Canceled && result.Data is Exercise selectedExercise)
        {
            // Проверяем, что выбранное упражнение не совпадает с текущим
            if (selectedExercise.Id == workoutExercise.ExerciseId)
            {
                Snackbar.Add("Выбрано то же самое упражнение", Severity.Info);
                return;
            }

            // Проверяем, что выбранное упражнение еще не добавлено в тренировку
            var existingExerciseIds = workout.WorkoutExercises?
                .Where(we => we.Id != workoutExercise.Id)
                .Select(we => we.ExerciseId)
                .ToHashSet() ?? new HashSet<Guid>();

            if (existingExerciseIds.Contains(selectedExercise.Id))
            {
                Snackbar.Add("Это упражнение уже есть в тренировке", Severity.Warning);
                return;
            }

            await ReplaceCurrentExercise(selectedExercise);
        }
    }

    private async Task ReplaceCurrentExercise(Exercise newExercise)
    {
        if (workoutExercise == null || workout == null)
            return;

        try
        {
            var updateDto = new CreateWorkoutExerciseDto
            {
                WorkoutId = workoutExercise.WorkoutId,
                ExerciseId = newExercise.Id,
                Order = workoutExercise.Order,
                Notes = workoutExercise.Notes
            };

            var success = await WorkoutExerciseService.UpdateWorkoutExerciseAsync(workoutExercise.Id, updateDto);
            if (success)
            {
                await LoadWorkout();
            }
            else
            {
                Snackbar.Add("Ошибка при замене упражнения", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка при замене упражнения: {ex.Message}", Severity.Error);
        }
    }
}

