@page "/workouts/{WorkoutId:guid}"
@using SetRep.Core.ApiRequestServices
@using SetRep.Core.Entities
@using SetRep.Core.Enums
@using SetRep.MiniApp.Client.Services
@using SetRep.MiniApp.Components.Dialog
@using SetRep.Shared.DTO
@using static SetRep.MiniApp.Client.Services.InitializationHelper
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@rendermode InteractiveServer
@inject IWorkoutService WorkoutService
@inject IWorkoutExerciseService WorkoutExerciseService
@inject IExerciseService ExerciseService
@inject NavigationManager Navigation
@inject ITelegramBackButtonService TelegramBackButtonService
@inject ITelegramHapticService TelegramHapticService
@inject IWorkoutHistoryService WorkoutHistoryService
@inject ITelegramWebAppStateService TelegramWebAppStateService
@inject IAppInitializationService AppInitializationService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>SetRep - @(workout?.Name ?? "Тренировка")</PageTitle>

@if (isLoading)
{
    <div class="workout-detail-container">
        @* Скелетон карточки информации о тренировке *@
        <MudCard Elevation="2" Class="mb-4 workout-info-card">
            <MudCardContent>
                <MudSkeleton Width="60%" Height="32px" Class="mb-2" />
                <MudSkeleton Width="90%" Height="20px" Class="mb-1" />
                <MudSkeleton Width="70%" Height="20px" />
            </MudCardContent>
        </MudCard>

        @* Скелетон кнопки начала тренировки *@
        <MudSkeleton Width="100%" Height="48px" Class="mb-4" />

        @* Скелетон кнопки добавления упражнений *@
        <MudSkeleton Width="100%" Height="48px"Class="mb-4" />

        @* Скелетон списка упражнений *@
        <MudSkeleton Typo="Typo.h6" Width="150px" Height="24px" Class="mb-3" />
        @for (int i = 0; i < 3; i++)
        {
            <div class="exercise-card-wrapper">
                <MudCard Elevation="2" Class="mb-3 exercise-card">
                    <MudCardContent>
                        <div class="exercise-header">
                            <MudSkeleton Width="24px" Height="24px" />
                            <MudSkeleton Width="48px" Height="48px" SkeletonType="SkeletonType.Circle" />
                            <div class="exercise-header-content">
                                <MudSkeleton Width="70%" Height="20px" />
                            </div>
                            <MudSkeleton Width="24px" Height="24px" SkeletonType="SkeletonType.Circle" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </div>
        }
    </div>
}
else if (errorMessage != null)
{
    <div class="workout-detail-container">
        <MudCard Elevation="2" Class="error-card">
            <MudCardContent>
                <div class="error-state">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" Class="mb-4" />
                    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-2">
                        Ошибка загрузки
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4">
                        @errorMessage
                    </MudText>
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadWorkout">
                        Попробовать снова
                    </MudButton>
                    <MudButton Variant="Variant.Text" 
                               Color="Color.Primary" 
                               Class="mt-2"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="GoBack">
                        Вернуться к списку
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    </div>
}
else if (workout != null)
{
    <div class="workout-detail-container">
        <!-- Название и описание тренировки -->
        <MudCard Elevation="2" Class="mb-4 workout-info-card">
            <MudCardContent>
                <div class="workout-header">
                    <MudText Typo="Typo.h4" Class="workout-title">@workout.Name</MudText>
                </div>
                
                @if (!string.IsNullOrWhiteSpace(workout.Notes))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="workout-description">
                        @workout.Notes
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Описание отсутствует
                    </MudText>
                }
            </MudCardContent>
        </MudCard>

        <!-- Кнопка начала тренировки (только для своей тренировки) -->
        @if (!isReadOnly && workout.WorkoutExercises != null && workout.WorkoutExercises.Any())
        {
            var isCurrentWorkoutActive = activeWorkoutHistory != null && activeWorkoutHistory.WorkoutId == WorkoutId;
            var hasOtherActiveWorkout = activeWorkoutHistory != null && activeWorkoutHistory.WorkoutId != WorkoutId;
            @if (isCurrentWorkoutActive)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Info"
                           FullWidth="true"
                           Class="mb-4 start-workout-button"
                           StartIcon="@Icons.Material.Filled.FitnessCenter"
                           OnClick="ContinueWorkout"
                           Disabled="isStartingWorkout">
                    <span>Тренировка начата - Продолжить</span>
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           FullWidth="true"
                           Class="mb-4 start-workout-button"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           OnClick="StartWorkout"
                           Disabled="isStartingWorkout || hasOtherActiveWorkout">
                    @if (isStartingWorkout)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <span class="ms-2">Запуск тренировки...</span>
                    }
                    else
                    {
                        <span>Начать тренировку</span>
                    }
                </MudButton>
            }
        }

        <!-- Кнопка добавления упражнений (только для своей тренировки) -->
        @if (!isReadOnly)
        {
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       FullWidth="true" 
                       Class="mb-4 add-exercise-btn"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenSelectExercisesDialog">
                Добавить упражнение
            </MudButton>
        }

        <!-- Список упражнений -->
        @if (workout.WorkoutExercises != null && workout.WorkoutExercises.Any())
        {
            <MudText Typo="Typo.h6" Class="mb-3">Упражнения</MudText>
            
            <div id="exercise-list-container" class="exercise-list-container">
                @for (int i = 0; i < exerciseItems.Count; i++)
                {
                    var item = exerciseItems[i];
                    <div @onclick="() => ViewWorkoutExercise(item.WorkoutExercise.Id)" class="exercise-card-wrapper">
                        <MudCard Elevation="2" Class="mb-3 exercise-card">
                            <MudCardContent>
                                <div class="exercise-header">
                                    @if (!isReadOnly)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Menu" 
                                                 Color="Color.Secondary" 
                                                 Class="drag-handle-icon" />
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.WorkoutExercise.Exercise?.MainImage))
                                    {
                                        <MudAvatar Size="Size.Large" Class="exercise-image-avatar">
                                            <img src="@item.WorkoutExercise.Exercise.MainImage" alt="@(item.WorkoutExercise.Exercise?.Name ?? "Упражнение")" />
                                        </MudAvatar>
                                    }
                                    <div class="exercise-header-content">
                                        <MudText Typo="Typo.body1" Class="exercise-name-text">
                                            @(item.WorkoutExercise.Exercise?.Name ?? "Неизвестное упражнение")
                                        </MudText>
                                    </div>
                                    <div class="exercise-header-right" @onclick:stopPropagation="true">
                                        @if (isReadOnly)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Default" />
                                        }
                                        else
                                        {
                                            <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                                     Color="Color.Default"
                                                     AnchorOrigin="Origin.BottomRight"
                                                     TransformOrigin="Origin.TopRight"
                                                     Variant="Variant.Text"
                                                     Size="Size.Medium"
                                                     Class="exercise-menu-button"
                                                     StopPropagation="true">
                                                <MudMenuItem OnClick="@(() => OpenEditNotesDialog(item.WorkoutExercise))" Icon="@Icons.Material.Filled.Edit">
                                                    Редактировать заметку
                                                </MudMenuItem>
                                                <MudDivider />
                                                <MudMenuItem OnClick="@(() => ReplaceExerciseFromDialog(item.WorkoutExercise))" Icon="@Icons.Material.Filled.SwapHoriz">
                                                    Заменить упражнение
                                                </MudMenuItem>
                                                <MudDivider />
                                                <MudMenuItem OnClick="@(() => ConfirmDeleteExercise(item.WorkoutExercise))" Icon="@Icons.Material.Filled.Delete" Color="Color.Error">
                                                    Удалить
                                                </MudMenuItem>
                                            </MudMenu>
                                        }
                                    </div>
                                </div>
                            </MudCardContent>
                        </MudCard>
                    </div>
                }
            </div>
        }
        else
        {
            <MudCard Elevation="2" Class="empty-state-card">
                <MudCardContent>
                    <div class="empty-state">
                        <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Large" Color="Color.Secondary" Class="mb-4" />
                        <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-2">
                            Нет упражнений
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                            В этой тренировке пока нет упражнений
                        </MudText>
                    </div>
                </MudCardContent>
            </MudCard>
        }
    </div>
}

