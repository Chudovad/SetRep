@page "/workouts/{WorkoutId:guid}"
@using SetRep.Core.ApiRequestServices
@using SetRep.Core.Entities
@using SetRep.MiniApp.Client.Services
@using SetRep.MiniApp.Components.Dialog
@using SetRep.Shared.DTO
@using static SetRep.MiniApp.Client.Services.InitializationHelper
@rendermode InteractiveServer
@inject IWorkoutService WorkoutService
@inject IWorkoutExerciseService WorkoutExerciseService
@inject NavigationManager Navigation
@inject ITelegramBackButtonService TelegramBackButtonService
@inject IWorkoutHistoryService WorkoutHistoryService
@inject ITelegramWebAppStateService TelegramWebAppStateService
@inject IAppInitializationService AppInitializationService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IAsyncDisposable

<PageTitle>SetRep - @(workout?.Name ?? "Тренировка")</PageTitle>

@if (isLoading)
{
    <div class="workout-detail-container">
        <MudCard Elevation="2" Class="loading-card">
            <MudCardContent>
                <div class="loading-state">
                    <MudProgressCircular Indeterminate="true" Size="Size.Large" Class="mb-4" />
                    <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center">
                        Загрузка тренировки...
                    </MudText>
                </div>
            </MudCardContent>
        </MudCard>
    </div>
}
else if (errorMessage != null)
{
    <div class="workout-detail-container">
        <MudCard Elevation="2" Class="error-card">
            <MudCardContent>
                <div class="error-state">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" Class="mb-4" />
                    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-2">
                        Ошибка загрузки
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4">
                        @errorMessage
                    </MudText>
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadWorkout">
                        Попробовать снова
                    </MudButton>
                    <MudButton Variant="Variant.Text" 
                               Color="Color.Primary" 
                               Class="mt-2"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="GoBack">
                        Вернуться к списку
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    </div>
}
else if (workout != null)
{
    <div class="workout-detail-container">
        <!-- Название и описание тренировки -->
        <MudCard Elevation="2" Class="mb-4 workout-info-card">
            <MudCardContent>
                <div class="workout-header">
                    <MudText Typo="Typo.h4" Class="workout-title">@workout.Name</MudText>
                    <div class="workout-actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Medium"
                                       OnClick="OpenEditDialog"
                                       Disabled="isDeleting"
                                       Class="edit-workout-btn" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                       Color="Color.Error" 
                                       Size="Size.Medium"
                                       OnClick="ConfirmDeleteWorkout"
                                       Disabled="isDeleting"
                                       Class="delete-workout-btn" />
                    </div>
                </div>
                
                @if (!string.IsNullOrWhiteSpace(workout.Notes))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="workout-description">
                        @workout.Notes
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Описание отсутствует
                    </MudText>
                }
            </MudCardContent>
        </MudCard>

        <!-- Кнопка начала тренировки -->
        @if (workout.WorkoutExercises != null && workout.WorkoutExercises.Any())
        {
            @if (activeWorkoutHistory != null)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Info"
                           FullWidth="true"
                           Class="mb-4 start-workout-button"
                           StartIcon="@Icons.Material.Filled.FitnessCenter"
                           OnClick="ContinueWorkout"
                           Disabled="isStartingWorkout">
                    <span>Тренировка начата - Продолжить</span>
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           FullWidth="true"
                           Class="mb-4 start-workout-button"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           OnClick="StartWorkout"
                           Disabled="isStartingWorkout">
                    @if (isStartingWorkout)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <span class="ms-2">Запуск тренировки...</span>
                    }
                    else
                    {
                        <span>Начать тренировку</span>
                    }
                </MudButton>
            }
        }

        <!-- Кнопка добавления упражнений -->
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   FullWidth="true" 
                   Class="mb-4 add-exercise-btn"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenSelectExercisesDialog">
            Добавить упражнение
        </MudButton>

        <!-- Список упражнений -->
        @if (workout.WorkoutExercises != null && workout.WorkoutExercises.Any())
        {
            <MudText Typo="Typo.h6" Class="mb-3">Упражнения</MudText>
            
            <MudDropContainer T="WorkoutExerciseItem" 
                              Items="@exerciseItems" 
                              ItemsSelector="@((item, dropzone) => item.Zone == dropzone)"
                              ItemDropped="OnExerciseDropped" 
                              Class="exercise-drop-container"
                              @key="@($"exercises-{exerciseItems.Count}")">
                <ChildContent>
                    <MudDropZone T="WorkoutExerciseItem" 
                                 Identifier="exercises-zone" 
                                 AllowReorder="true" 
                                 Class="exercise-drop-zone" />
                </ChildContent>
                <ItemRenderer>
                    <div @onclick="() => ViewWorkoutExercise(context.WorkoutExercise.Id)" class="exercise-card-wrapper">
                        <MudCard Elevation="2" Class="mb-3 exercise-card">
                            <MudCardContent>
                                <div class="exercise-header">
                                    <MudIcon Icon="@Icons.Material.Filled.Menu" 
                                             Color="Color.Secondary" 
                                             Class="drag-handle-icon" />
                                    <div class="exercise-header-content">
                                        <MudText Typo="Typo.h6">
                                            @(context.WorkoutExercise.Exercise?.Name ?? "Неизвестное упражнение")
                                        </MudText>
                                    </div>
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" 
                                             Color="Color.Secondary" 
                                             Class="exercise-arrow-icon" />
                                </div>
                            </MudCardContent>
                        </MudCard>
                    </div>
                </ItemRenderer>
            </MudDropContainer>
        }
        else
        {
            <MudCard Elevation="2" Class="empty-state-card">
                <MudCardContent>
                    <div class="empty-state">
                        <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Large" Color="Color.Secondary" Class="mb-4" />
                        <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-2">
                            Нет упражнений
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                            В этой тренировке пока нет упражнений
                        </MudText>
                    </div>
                </MudCardContent>
            </MudCard>
        }
    </div>
}

<style>
    .workout-detail-container {
        max-width: 100%;
    }

    .workout-info-card {
        border-radius: 12px;
    }

    .workout-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 12px;
    }

    .workout-title {
        flex: 1;
    }

    .workout-actions {
        display: flex;
        gap: 8px;
        align-items: center;
        flex-shrink: 0;
    }

    .edit-workout-btn, .delete-workout-btn {
        min-width: 40px;
    }

    .workout-description {
        white-space: pre-wrap;
        word-wrap: break-word;
    }

    .workout-meta {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .exercise-drop-container {
        width: 100%;
    }

    .exercise-drop-zone {
        min-height: 50px;
    }

    .exercise-card-wrapper {
        cursor: pointer;
    }

    .drag-handle-icon {
        cursor: grab;
        margin-right: 8px;
        user-select: none;
    }

    .drag-handle-icon:active {
        cursor: grabbing;
    }

    .exercise-card {
        border-radius: 12px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .exercise-card-wrapper:hover .exercise-card {
        transform: translateY(-2px);
    }

    .exercise-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
    }

    .exercise-header-content {
        flex: 1;
    }

    .exercise-arrow-icon {
        flex-shrink: 0;
        margin-top: 4px;
    }

    .sets-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 12px;
    }

    .set-item {
        padding: 12px;
        background-color: #f5f5f5;
        border-radius: 8px;
    }

    .set-number {
        font-weight: 500;
        margin-bottom: 8px;
    }

    .set-details {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }

    .empty-state-card {
        border-radius: 12px;
        margin-top: 16px;
    }

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 24px;
    }

    .start-workout-button {
        border-radius: 12px;
        height: 48px;
        font-size: 1rem;
        font-weight: 500;
    }

    .loading-card, .error-card {
        border-radius: 12px;
        margin-top: 32px;
    }

    .loading-state, .error-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 24px;
    }

    .add-exercise-btn {
        height: 48px;
        border-radius: 12px;
        text-transform: none;
        font-weight: 500;
    }
</style>

@code {
    [Parameter] public Guid WorkoutId { get; set; }

    private Workout? workout;
    private WorkoutHistory? activeWorkoutHistory;
    private bool isLoading = true;
    private bool isStartingWorkout = false;
    private bool isDeleting = false;
    private bool isReordering = false;
    private string? errorMessage;
    private List<WorkoutExerciseItem> exerciseItems = new();

    private class WorkoutExerciseItem
    {
        public WorkoutExercise WorkoutExercise { get; set; } = null!;
        public string Zone { get; set; } = "exercises-zone";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await WaitForInitializationAsync(AppInitializationService);
            await TelegramBackButtonService.ShowAsync();
            await LoadWorkout();
            await CheckActiveWorkout();
            StateHasChanged();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await CheckActiveWorkout();
    }

    private async Task LoadWorkout()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            workout = await WorkoutService.GetWorkoutDetailsAsync(WorkoutId);
            if (workout == null)
            {
                errorMessage = "Тренировка не найдена.";
            }
            else
            {
                UpdateExerciseItems();
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Ошибка сети при подключении к API: {ex.Message}. " +
                          "Убедитесь, что API сервер запущен и доступен.";
            workout = null;
        }
        catch (TaskCanceledException ex) when (ex.InnerException is TimeoutException)
        {
            errorMessage = "Превышено время ожидания ответа от API. Сервер может быть перегружен или недоступен.";
            workout = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось загрузить тренировку: {ex.Message}";
            workout = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CheckActiveWorkout()
    {
        try
        {
            Guid userId = Guid.Empty;
            if (TelegramWebAppStateService.ValidationResult?.Data?.User != null)
            {
                userId = TelegramWebAppStateService.ValidationResult.Data.User.Id;
            }

            if (userId == Guid.Empty)
            {
                return;
            }

            var workoutHistories = await WorkoutService.GetWorkoutHistoryByWorkoutIdAsync(WorkoutId);
            if (workoutHistories != null)
            {
                activeWorkoutHistory = workoutHistories
                    .FirstOrDefault(wh => wh.UserId == userId && wh.EndTime == null);

                if (activeWorkoutHistory != null)
                {
                    StateHasChanged();
                }
            }
        }
        catch
        {
            // Игнорируем ошибки при проверке активной тренировки
        }
    }

    private async Task StartWorkout()
    {
        if (workout == null || isStartingWorkout)
        {
            return;
        }

        isStartingWorkout = true;
        StateHasChanged();

        try
        {
            Guid userId = Guid.Empty;
            if (TelegramWebAppStateService.ValidationResult?.Data?.User != null)
            {
                userId = TelegramWebAppStateService.ValidationResult.Data.User.Id;
            }

            if (userId == Guid.Empty)
            {
                Snackbar.Add("Не удалось определить пользователя", Severity.Error);
                return;
            }

            var workoutHistory = await WorkoutHistoryService.StartWorkoutAsync(WorkoutId, userId);

            if (workoutHistory != null)
            {
                await WorkoutHistoryService.CopySetsFromWorkoutAsync(workoutHistory.Id, WorkoutId);

                activeWorkoutHistory = workoutHistory;

                Navigation.NavigateTo($"/workouts/{WorkoutId}/active/{workoutHistory.Id}");
            }
            else
            {
                Snackbar.Add("Не удалось начать тренировку", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка при запуске тренировки: {ex.Message}", Severity.Error);
        }
        finally
        {
            isStartingWorkout = false;
            StateHasChanged();
        }
    }

    private void ContinueWorkout()
    {
        if (activeWorkoutHistory != null)
        {
            Navigation.NavigateTo($"/workouts/{WorkoutId}/active/{activeWorkoutHistory.Id}");
        }
    }

    private void ViewWorkoutExercise(Guid workoutExerciseId)
    {
        Navigation.NavigateTo($"/workouts/{WorkoutId}/exercises/{workoutExerciseId}");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/workouts");
    }

    private async Task OpenEditDialog()
    {
        if (workout == null || isDeleting)
        {
            return;
        }

        var parameters = new DialogParameters<EditWorkoutDialog>
        {
            { nameof(EditWorkoutDialog.Workout), workout }
        };
        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true, 
            MaxWidth = MaxWidth.Small, 
            FullWidth = true 
        };

        var dialogReference = await DialogService.ShowAsync<EditWorkoutDialog>("Редактировать тренировку", parameters, options);
        var result = await dialogReference.Result;

        if (!result.Canceled)
        {
            await LoadWorkout();
        }
    }

    private async Task ConfirmDeleteWorkout()
    {
        if (workout == null || isDeleting)
        {
            return;
        }

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { nameof(ConfirmDialog.Title), "Подтверждение удаления" },
            { nameof(ConfirmDialog.ContentText), $"Вы уверены, что хотите удалить тренировку \"{workout.Name}\"? Это действие нельзя отменить." },
            { nameof(ConfirmDialog.ButtonText), "Удалить" },
            { nameof(ConfirmDialog.Color), Color.Error }
        };

        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true, 
            MaxWidth = MaxWidth.Small, 
            FullWidth = true 
        };

        var dialogReference = await DialogService.ShowAsync<ConfirmDialog>("Подтверждение удаления", parameters, options);
        var result = await dialogReference.Result;

        if (!result.Canceled)
        {
            await DeleteWorkout();
        }
    }

    private async Task DeleteWorkout()
    {
        if (workout == null || isDeleting)
        {
            return;
        }

        isDeleting = true;
        StateHasChanged();

        try
        {
            if (activeWorkoutHistory != null)
            {
                var endSuccess = await WorkoutHistoryService.EndWorkoutAsync(activeWorkoutHistory.Id);
                if (!endSuccess)
                {
                    Snackbar.Add("Не удалось завершить активную тренировку. Удаление отменено.", Severity.Error);
                    return;
                }

                activeWorkoutHistory = null;
            }

            var success = await WorkoutService.DeleteWorkoutAsync(WorkoutId);
            if (success)
            {
                Navigation.NavigateTo("/workouts");
            }
            else
            {
                Snackbar.Add("Ошибка при удалении тренировки", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка при удалении тренировки: {ex.Message}", Severity.Error);
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    private void UpdateExerciseItems()
    {
        if (workout?.WorkoutExercises == null)
        {
            exerciseItems = new List<WorkoutExerciseItem>();
            return;
        }

        exerciseItems = workout.WorkoutExercises
            .OrderBy(we => we.Order)
            .Select(we => new WorkoutExerciseItem
            {
                WorkoutExercise = we,
                Zone = "exercises-zone"
            })
            .ToList();
    }

    private async Task OpenSelectExercisesDialog()
    {
        if (workout == null)
            return;

        var parameters = new DialogParameters<SelectExercisesDialog>();
        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true, 
            MaxWidth = MaxWidth.Medium, 
            FullWidth = true 
        };

        var dialogReference = await DialogService.ShowAsync<SelectExercisesDialog>("Выберите упражнения", parameters, options);
        var result = await dialogReference.Result;

        if (!result.Canceled && result.Data is List<Exercise> exercises)
        {
            await AddExercisesToWorkout(exercises);
        }
    }

    private async Task AddExercisesToWorkout(List<Exercise> exercises)
    {
        if (workout == null || exercises == null || !exercises.Any())
            return;

        try
        {
            int maxOrder = workout.WorkoutExercises?.Any() == true 
                ? workout.WorkoutExercises.Max(we => we.Order) + 1 
                : 0;

            var existingExerciseIds = workout.WorkoutExercises?
                .Select(we => we.ExerciseId)
                .ToHashSet() ?? new HashSet<Guid>();

            var exercisesToAdd = exercises
                .Where(e => !existingExerciseIds.Contains(e.Id))
                .ToList();

            if (!exercisesToAdd.Any())
            {
                Snackbar.Add("Все выбранные упражнения уже добавлены в тренировку", Severity.Info);
                return;
            }

            int order = maxOrder;
            int successCount = 0;
            var createdWorkoutExercises = new List<WorkoutExercise>();
            
            foreach (var exercise in exercisesToAdd)
            {
                var workoutExerciseDto = new CreateWorkoutExerciseDto
                {
                    WorkoutId = workout.Id,
                    ExerciseId = exercise.Id,
                    Order = order++
                };

                var createdWorkoutExercise = await WorkoutExerciseService.CreateWorkoutExerciseAsync(workoutExerciseDto);
                if (createdWorkoutExercise != null)
                {
                    createdWorkoutExercise.Exercise = exercise;
                    createdWorkoutExercises.Add(createdWorkoutExercise);
                    successCount++;
                }
                else
                {
                    Snackbar.Add($"Ошибка при добавлении упражнения '{exercise.Name}' в тренировку", Severity.Error);
                }
            }

            if (successCount > 0)
            {
                await Task.Delay(200);
                
                var reloadedWorkout = await WorkoutService.GetWorkoutDetailsAsync(workout.Id);
                if (reloadedWorkout != null)
                {
                    workout = reloadedWorkout;
                    
                    exerciseItems = new List<WorkoutExerciseItem>();
                    UpdateExerciseItems();

                    StateHasChanged();

                    await InvokeAsync(StateHasChanged);
                    
                }
                else
                {
                    var existingExercises = workout.WorkoutExercises?.ToList() ?? new List<WorkoutExercise>();
                    var updatedExercises = existingExercises.Concat(createdWorkoutExercises).ToList();
                    workout.WorkoutExercises = updatedExercises;
                    
                    exerciseItems = new List<WorkoutExerciseItem>();
                    UpdateExerciseItems();
                    StateHasChanged();
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка при добавлении упражнений: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnExerciseDropped(MudItemDropInfo<WorkoutExerciseItem> dropInfo)
    {
        if (isReordering || workout?.WorkoutExercises == null || dropInfo.Item == null)
        {
            return;
        }

        isReordering = true;
        StateHasChanged();

        try
        {
            var newIndex = dropInfo.IndexInZone;
            var item = dropInfo.Item;
            var oldIndex = exerciseItems.IndexOf(item);

            if (oldIndex == newIndex)
            {
                return;
            }

            var orderedExercises = exerciseItems.Select(ei => ei.WorkoutExercise).ToList();
            
            var movedExercise = orderedExercises[oldIndex];
            orderedExercises.RemoveAt(oldIndex);

            orderedExercises.Insert(newIndex, movedExercise);

            var updateTasks = new List<Task<bool>>();
            for (int i = 0; i < orderedExercises.Count; i++)
            {
                var exercise = orderedExercises[i];
                if (exercise.Order != i)
                {
                    updateTasks.Add(WorkoutService.UpdateWorkoutExerciseOrderAsync(exercise.Id, i));
                }
            }

            var results = await Task.WhenAll(updateTasks);
            if (results.All(r => r))
            {
                for (int i = 0; i < orderedExercises.Count; i++)
                {
                    orderedExercises[i].Order = i;
                }

                await LoadWorkout();
            }
            else
            {
                Snackbar.Add("Не удалось обновить порядок упражнений", Severity.Error);
                UpdateExerciseItems();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка при изменении порядка: {ex.Message}", Severity.Error);
            UpdateExerciseItems();
        }
        finally
        {
            isReordering = false;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        await TelegramBackButtonService.HideAsync();
    }
}

