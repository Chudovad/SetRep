@page "/workouts"
@using SetRep.Core.ApiRequestServices
@using SetRep.Core.Entities
@using SetRep.MiniApp.Client.Services
@using SetRep.MiniApp.Components.Dialog
@using SetRep.MiniApp.Options
@using SetRep.Shared.DTO
@using Microsoft.Extensions.Options
@using static SetRep.MiniApp.Client.Services.InitializationHelper

@rendermode InteractiveServer
@inject IWorkoutService WorkoutService
@inject IWorkoutPlanService WorkoutPlanService
@inject IReadyWorkoutPlanService ReadyWorkoutPlanService
@inject IWorkoutExerciseService WorkoutExerciseService
@inject IWorkoutHistoryService WorkoutHistoryService
@inject ITelegramWebAppStateService TelegramWebAppStateService
@inject ITelegramBackButtonService TelegramBackButtonService
@inject IAppInitializationService AppInitializationService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IOptions<ReadyWorkoutPlanOptions> ReadyWorkoutPlanOptions

<PageTitle>SetRep - Тренировки</PageTitle>

<div class="workouts-container">
    @if (isLoading)
    {
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Class="mb-4"
                   Disabled="true">
            <MudSkeleton Width="100%" Height="36px" />
        </MudButton>
        @for (int i = 0; i < 4; i++)
        {
            <MudCard Elevation="2" Class="mb-3 workout-item-card">
                <MudCardContent>
                    <div class="workout-item-header">
                        <div class="workout-item-info">
                            <MudSkeleton Typo="Typo.h6" Width="60%" Height="24px" />
                        </div>
                        <div class="workout-item-right">
                            <MudSkeleton Width="24px" Height="24px" Variant="SkeletonVariant.Circular" />
                        </div>
                    </div>
                </MudCardContent>
            </MudCard>
        }
    }
    else if (errorMessage != null)
    {
        <MudCard Elevation="2" Class="error-card">
            <MudCardContent>
                <div class="error-state">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" Class="mb-4" />
                    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-2">
                        Ошибка загрузки
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4">
                        @errorMessage
                    </MudText>
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadData">
                        Попробовать снова
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
    else if (workouts.Any() || workoutPlans.Any())
    {
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   FullWidth="true"
                   Class="mb-2"
                   StartIcon="@Icons.Material.Filled.Star"
                   OnClick="NavigateToReadyPlans">
            Готовые планы
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   FullWidth="true"
                   Class="mb-4"
                   StartIcon="@Icons.Material.Filled.List"
                   OnClick="AddWorkoutPlan">
            Добавить план тренировок
        </MudButton>

        @if (isDuplicating)
        {
            <MudCard Elevation="2" Class="mb-3 workout-item-card">
                <MudCardContent>
                    <div class="workout-item-header">
                        <div class="workout-item-info">
                            <MudSkeleton Typo="Typo.h6" Width="60%" Height="24px" />
                        </div>
                        <div class="workout-item-right">
                            <MudSkeleton Width="24px" Height="24px" Variant="SkeletonVariant.Circular" />
                        </div>
                    </div>
                </MudCardContent>
            </MudCard>
        }

        <MudExpansionPanels MultiExpansion="true" Class="workout-plans-panels">
            <!-- "Мои тренировки" - тренировки без плана -->
            @{
                var myWorkouts = workouts.Where(w => w.WorkoutPlanId == null).OrderByDescending(w => w.CreatedAt).ToList();
            }
            <MudExpansionPanel Expanded="true">
                <TitleContent>
                    <MudText>
                        Мои тренировки (@myWorkouts.Count)
                    </MudText>
                </TitleContent>
                <ChildContent>
                    @foreach (var workout in myWorkouts)
                    {
                        <WorkoutCard Workout="workout"
                                     IsActive="@(activeWorkoutHistory != null && activeWorkoutHistory.WorkoutId == workout.Id)"
                                     OnView="ViewWorkout"
                                     OnEdit="OpenEditDialog"
                                     OnDuplicate="DuplicateWorkout"
                                     OnAddToPlan="OpenAddWorkoutToPlanDialog"
                                     OnDelete="ConfirmDeleteWorkout" />
                    }
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Class="mt-2"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddWorkout">
                        Добавить тренировку
                    </MudButton>
                </ChildContent>
            </MudExpansionPanel>

            <!-- Планы тренировок -->
            @foreach (var plan in workoutPlans.OrderByDescending(p => p.CreatedAt))
            {
                var planWorkouts = workouts.Where(w => w.WorkoutPlanId == plan.Id).OrderByDescending(w => w.CreatedAt).ToList();
                <MudExpansionPanel Expanded="true">
                    <TitleContent>
                        <div class="d-flex align-center">
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                     Color="Color.Default"
                                     AnchorOrigin="Origin.BottomLeft"
                                     TransformOrigin="Origin.TopLeft"
                                     Variant="Variant.Text"
                                     Size="Size.Small"
                                     Class="mr-3"
                                     StopPropagation="true">
                                <MudMenuItem OnClick="@(() => OpenAddWorkoutsToPlanDialog(plan))" Icon="@Icons.Material.Filled.Add">
                                    Добавить тренировки
                                </MudMenuItem>
                                @if (CanAddToReadyPlans())
                                {
                                    <MudMenuItem OnClick="@(() => OpenAddToReadyPlansDialog(plan))" Icon="@Icons.Material.Filled.Star">
                                        Добавить в готовые
                                    </MudMenuItem>
                                }
                                <MudMenuItem OnClick="@(() => OpenEditPlanDialog(plan))" Icon="@Icons.Material.Filled.Edit">
                                    Редактировать
                                </MudMenuItem>
                                <MudDivider />
                                <MudMenuItem OnClick="@(() => ConfirmDeletePlan(plan))" Icon="@Icons.Material.Filled.Delete" Color="Color.Error">
                                    Удалить план
                                </MudMenuItem>
                            </MudMenu>
                            <MudText>
                                @plan.Name (@planWorkouts.Count)
                            </MudText>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        @if (planWorkouts.Any())
                        {
                            @foreach (var workout in planWorkouts)
                            {
                                <WorkoutCard Workout="workout"
                                             IsActive="@(activeWorkoutHistory != null && activeWorkoutHistory.WorkoutId == workout.Id)"
                                             OnView="ViewWorkout"
                                             OnEdit="OpenEditDialog"
                                             OnDuplicate="DuplicateWorkout"
                                             OnAddToPlan="OpenAddWorkoutToPlanDialog"
                                             OnDelete="ConfirmDeleteWorkout" />
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="py-4">
                                В этом плане пока нет тренировок. Добавьте тренировки, используя меню в заголовке.
                            </MudText>
                        }
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }
    else
    {
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   FullWidth="true"
                   Class="mb-2"
                   StartIcon="@Icons.Material.Filled.Star"
                   OnClick="NavigateToReadyPlans">
            Готовые планы
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   FullWidth="true"
                   Class="mb-4"
                   StartIcon="@Icons.Material.Filled.List"
                   OnClick="AddWorkoutPlan">
            Добавить план тренировок
        </MudButton>

        <MudExpansionPanels MultiExpansion="true" Class="workout-plans-panels">
            <MudExpansionPanel Expanded="true">
                <TitleContent>
                    <MudText>
                        Мои тренировки (0)
                    </MudText>
                </TitleContent>
                <ChildContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="py-4">
                        Пока нет тренировок. Добавьте первую тренировку, чтобы начать отслеживать прогресс.
                    </MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Class="mt-2"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddWorkout">
                        Добавить тренировку
                    </MudButton>
                </ChildContent>
            </MudExpansionPanel>
        </MudExpansionPanels>
    }
</div>

<style>
    .workouts-container {
        max-width: 100%;
    }

    .workout-plans-panels {
        margin-bottom: 16px;
    }

    .empty-state-card {
        border-radius: 12px;
        margin-top: 32px;
    }

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 24px;
    }

    .loading-card, .error-card {
        border-radius: 12px;
        margin-top: 32px;
    }

    .loading-state, .error-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 24px;
    }
</style>

@code {
    private List<Workout> workouts = new();
    private List<WorkoutPlan> workoutPlans = new();
    private WorkoutHistory? activeWorkoutHistory;
    private bool isLoading = true;
    private bool isDeleting = false;
    private bool isDuplicating = false;
    private string? errorMessage;

    private bool CanAddToReadyPlans()
    {
        var telegramId = TelegramWebAppStateService.ValidationResult?.Data?.User?.TelegramId;
        if (!telegramId.HasValue) return false;
        var ids = ReadyWorkoutPlanOptions?.Value?.AllowedEditorTelegramIds;
        return ids != null && ids.Contains(telegramId.Value);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await WaitForInitializationAsync(AppInitializationService);
            await LoadData();
            await TelegramBackButtonService.HideAsync();
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        await LoadWorkouts();
        await LoadWorkoutPlans();
        await LoadActiveWorkout();
    }

    private async Task LoadWorkouts()
    {
        isLoading = true;
        errorMessage = null;
        
        try
        {
            var userId = TelegramWebAppStateService.ValidationResult?.Data?.User?.Id;
            
            if (userId == null || userId == Guid.Empty)
            {
                errorMessage = "Не удалось определить пользователя. Пожалуйста, обновите страницу.";
                workouts = new List<Workout>();
                isLoading = false;
                return;
            }

            var data = await WorkoutService.GetWorkoutsAsync(userId.Value);
            if (data != null)
            {
                workouts = data;
            }
            else
            {
                errorMessage = "Не удалось загрузить тренировки. Проверьте подключение к API.";
                workouts = new List<Workout>();
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Ошибка сети при подключении к API: {ex.Message}. " +
                          "Убедитесь, что API сервер запущен и доступен.";
            workouts = new List<Workout>();
        }
        catch (TaskCanceledException ex) when (ex.InnerException is TimeoutException)
        {
            errorMessage = "Превышено время ожидания ответа от API. Сервер может быть перегружен или недоступен.";
            workouts = new List<Workout>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось загрузить тренировки: {ex.Message}";
            workouts = new List<Workout>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadWorkoutPlans()
    {
        try
        {
            var userId = TelegramWebAppStateService.ValidationResult?.Data?.User?.Id;
            
            if (userId != null && userId != Guid.Empty)
            {
                var data = await WorkoutPlanService.GetWorkoutPlansAsync(userId.Value);
                if (data != null)
                {
                    workoutPlans = data;
                }
            }
        }
        catch
        {
            // Игнорируем ошибки загрузки планов
        }
    }

    private async Task LoadActiveWorkout()
    {
        try
        {
            var userId = TelegramWebAppStateService.ValidationResult?.Data?.User?.Id;
            
            if (userId != null && userId != Guid.Empty)
            {
                activeWorkoutHistory = await WorkoutHistoryService.GetActiveWorkoutAsync(userId.Value);
            }
        }
        catch
        {
            // Игнорируем ошибки загрузки активной тренировки
        }
    }

    private void ViewWorkout(Workout workout)
    {
        Navigation.NavigateTo($"/workouts/{workout.Id}");
    }

    private void AddWorkout()
    {
        Navigation.NavigateTo("/workouts/add");
    }

    private void AddWorkoutPlan()
    {
        Navigation.NavigateTo("/workouts/plans/add");
    }

    private void NavigateToReadyPlans()
    {
        Navigation.NavigateTo("/workouts/ready");
    }

    private async Task OpenAddToReadyPlansDialog(WorkoutPlan plan)
    {
        if (plan == null) return;
        var parameters = new DialogParameters<AddToReadyPlansDialog>
        {
            { nameof(AddToReadyPlansDialog.WorkoutPlan), plan }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<AddToReadyPlansDialog>("Добавить в готовые планы", parameters, options);
    }

    private async Task OpenEditDialog(Workout workout)
    {
        if (workout == null || isDeleting)
        {
            return;
        }

        var parameters = new DialogParameters<EditWorkoutDialog>
        {
            { nameof(EditWorkoutDialog.Workout), workout }
        };
        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true, 
            MaxWidth = MaxWidth.Small, 
            FullWidth = true 
        };

        var dialogReference = await DialogService.ShowAsync<EditWorkoutDialog>("Редактировать тренировку", parameters, options);
        var result = await dialogReference.Result;

        if (!result.Canceled)
        {
            await LoadData();
        }
    }

    private async Task OpenAddWorkoutToPlanDialog(Workout workout)
    {
        if (workout == null)
        {
            return;
        }

        var parameters = new DialogParameters<SelectWorkoutPlanDialog>
        {
            { nameof(SelectWorkoutPlanDialog.ExcludedPlanId), workout.WorkoutPlanId }
        };
        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true, 
            MaxWidth = MaxWidth.Small, 
            FullWidth = true 
        };

        var dialogReference = await DialogService.ShowAsync<SelectWorkoutPlanDialog>("Выберите план тренировки", parameters, options);
        var result = await dialogReference.Result;

        if (!result.Canceled && result.Data is WorkoutPlan selectedPlan)
        {
            await AddWorkoutToPlan(workout, selectedPlan.Id);
        }
    }

    private async Task AddWorkoutToPlan(Workout workout, Guid planId)
    {
        try
        {
            var dto = new CreateWorkoutDto
            {
                UserId = workout.UserId,
                Name = workout.Name,
                Notes = workout.Notes,
                WorkoutPlanId = planId
            };

            var success = await WorkoutService.UpdateWorkoutAsync(workout.Id, dto);
            if (success)
            {
                await LoadData();
            }
            else
            {
                Snackbar.Add($"Не удалось добавить тренировку \"{workout.Name}\" в план", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка при добавлении тренировки в план: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenAddWorkoutsToPlanDialog(WorkoutPlan plan)
    {
        if (plan == null)
        {
            return;
        }

        var excludedIds = workouts.Where(w => w.WorkoutPlanId == plan.Id).Select(w => w.Id).ToList();
        var parameters = new DialogParameters<AddWorkoutsToPlanDialog>
        {
            { nameof(AddWorkoutsToPlanDialog.WorkoutPlanId), plan.Id },
            { nameof(AddWorkoutsToPlanDialog.ExcludedWorkoutIds), excludedIds }
        };
        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true, 
            MaxWidth = MaxWidth.Medium, 
            FullWidth = true 
        };

        var dialogReference = await DialogService.ShowAsync<AddWorkoutsToPlanDialog>("Добавить тренировки в план", parameters, options);
        var result = await dialogReference.Result;

        if (!result.Canceled && result.Data is List<Workout> selectedWorkouts)
        {
            await AddWorkoutsToPlan(plan.Id, selectedWorkouts);
        }
    }

    private async Task AddWorkoutsToPlan(Guid planId, List<Workout> selectedWorkouts)
    {
        try
        {
            foreach (var workout in selectedWorkouts)
            {
                var dto = new CreateWorkoutDto
                {
                    UserId = workout.UserId,
                    Name = workout.Name,
                    Notes = workout.Notes,
                    WorkoutPlanId = planId
                };

                var success = await WorkoutService.UpdateWorkoutAsync(workout.Id, dto);
                if (!success)
                {
                    Snackbar.Add($"Не удалось добавить тренировку \"{workout.Name}\" в план", Severity.Warning);
                }
            }

            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка при добавлении тренировок в план: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenEditPlanDialog(WorkoutPlan plan)
    {
        if (plan == null)
        {
            return;
        }

        var parameters = new DialogParameters<EditWorkoutPlanDialog>
        {
            { nameof(EditWorkoutPlanDialog.WorkoutPlan), plan }
        };
        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true, 
            MaxWidth = MaxWidth.Small, 
            FullWidth = true 
        };

        var dialogReference = await DialogService.ShowAsync<EditWorkoutPlanDialog>("Редактировать план тренировки", parameters, options);
        var result = await dialogReference.Result;

        if (!result.Canceled)
        {
            await LoadData();
        }
    }

    private async Task ConfirmDeletePlan(WorkoutPlan plan)
    {
        if (plan == null)
        {
            return;
        }

        var planWorkouts = workouts.Where(w => w.WorkoutPlanId == plan.Id).ToList();
        var message = planWorkouts.Any() 
            ? $"Вы уверены, что хотите удалить план \"{plan.Name}\"? Все тренировки из этого плана будут перемещены в \"Мои тренировки\". Это действие нельзя отменить."
            : $"Вы уверены, что хотите удалить план \"{plan.Name}\"? Это действие нельзя отменить.";

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { nameof(ConfirmDialog.Title), "Подтверждение удаления" },
            { nameof(ConfirmDialog.ContentText), message },
            { nameof(ConfirmDialog.ButtonText), "Удалить" },
            { nameof(ConfirmDialog.Color), Color.Error }
        };

        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true, 
            MaxWidth = MaxWidth.Small, 
            FullWidth = true 
        };

        var dialogReference = await DialogService.ShowAsync<ConfirmDialog>("Подтверждение удаления", parameters, options);
        var result = await dialogReference.Result;

        if (!result.Canceled)
        {
            await DeletePlan(plan);
        }
    }

    private async Task DeletePlan(WorkoutPlan plan)
    {
        try
        {
            // Убираем привязку тренировок к плану
            var planWorkouts = workouts.Where(w => w.WorkoutPlanId == plan.Id).ToList();
            foreach (var workout in planWorkouts)
            {
                var dto = new CreateWorkoutDto
                {
                    UserId = workout.UserId,
                    Name = workout.Name,
                    Notes = workout.Notes,
                    WorkoutPlanId = null
                };

                await WorkoutService.UpdateWorkoutAsync(workout.Id, dto);
            }

            var success = await WorkoutPlanService.DeleteWorkoutPlanAsync(plan.Id);
            if (success)
            {
                await LoadData();
            }
            else
            {
                Snackbar.Add("Ошибка при удалении плана тренировки", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка при удалении плана тренировки: {ex.Message}", Severity.Error);
        }
    }

    private async Task ConfirmDeleteWorkout(Workout workout)
    {
        if (workout == null || isDeleting)
        {
            return;
        }

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { nameof(ConfirmDialog.Title), "Подтверждение удаления" },
            { nameof(ConfirmDialog.ContentText), $"Вы уверены, что хотите удалить тренировку \"{workout.Name}\"? Это действие нельзя отменить." },
            { nameof(ConfirmDialog.ButtonText), "Удалить" },
            { nameof(ConfirmDialog.Color), Color.Error }
        };

        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true, 
            MaxWidth = MaxWidth.Small, 
            FullWidth = true 
        };

        var dialogReference = await DialogService.ShowAsync<ConfirmDialog>("Подтверждение удаления", parameters, options);
        var result = await dialogReference.Result;

        if (!result.Canceled)
        {
            await DeleteWorkout(workout.Id);
        }
    }

    private async Task DeleteWorkout(Guid workoutId)
    {
        if (isDeleting)
        {
            return;
        }

        isDeleting = true;
        StateHasChanged();

        try
        {
            var workout = workouts.FirstOrDefault(w => w.Id == workoutId);
            if (workout == null)
            {
                return;
            }

            if (activeWorkoutHistory != null && activeWorkoutHistory.WorkoutId == workoutId)
            {
                var endSuccess = await WorkoutHistoryService.EndWorkoutAsync(activeWorkoutHistory.Id);
                if (!endSuccess)
                {
                    Snackbar.Add("Не удалось завершить активную тренировку. Удаление отменено.", Severity.Error);
                    return;
                }

                activeWorkoutHistory = null;
            }

            var success = await WorkoutService.DeleteWorkoutAsync(workoutId);
            if (success)
            {
                await LoadData();
            }
            else
            {
                Snackbar.Add("Ошибка при удалении тренировки", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка при удалении тренировки: {ex.Message}", Severity.Error);
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    private async Task DuplicateWorkout(Workout workout)
    {
        if (workout == null || isDuplicating || isDeleting)
        {
            return;
        }

        isDuplicating = true;
        StateHasChanged();

        try
        {
            var userId = TelegramWebAppStateService.ValidationResult?.Data?.User?.Id;
            if (userId == null || userId == Guid.Empty)
            {
                Snackbar.Add("Не удалось определить пользователя", Severity.Error);
                return;
            }

            var sourceWorkout = await WorkoutService.GetWorkoutDetailsAsync(workout.Id);
            if (sourceWorkout == null)
            {
                Snackbar.Add("Не удалось загрузить информацию о тренировке", Severity.Error);
                return;
            }

            var newWorkoutDto = new CreateWorkoutDto
            {
                UserId = userId.Value,
                Name = $"Копия {sourceWorkout.Name}",
                Notes = sourceWorkout.Notes
            };

            var newWorkout = await WorkoutService.CreateWorkoutAsync(newWorkoutDto);
            if (newWorkout == null)
            {
                Snackbar.Add("Не удалось создать копию тренировки", Severity.Error);
                return;
            }

            if (sourceWorkout.WorkoutExercises != null && sourceWorkout.WorkoutExercises.Any())
            {
                var orderedExercises = sourceWorkout.WorkoutExercises.OrderBy(we => we.Order).ToList();

                foreach (var sourceExercise in orderedExercises)
                {
                    var newWorkoutExerciseDto = new CreateWorkoutExerciseDto
                    {
                        WorkoutId = newWorkout.Id,
                        ExerciseId = sourceExercise.ExerciseId,
                        Order = sourceExercise.Order,
                        Notes = sourceExercise.Notes
                    };

                    var newWorkoutExercise = await WorkoutExerciseService.CreateWorkoutExerciseAsync(newWorkoutExerciseDto);
                    if (newWorkoutExercise == null)
                    {
                        Snackbar.Add($"Не удалось скопировать упражнение", Severity.Warning);
                        continue;
                    }

                    var sets = await WorkoutExerciseService.GetSetsByWorkoutExerciseIdAsync(sourceExercise.Id);
                    if (sets != null && sets.Any())
                    {
                        var orderedSets = sets.OrderBy(s => s.SetNumber).ToList();

                        foreach (var sourceSet in orderedSets)
                        {
                            var newSetDto = new CreateSetDto
                            {
                                WorkoutExerciseId = newWorkoutExercise.Id,
                                SetNumber = sourceSet.SetNumber,
                                Reps = sourceSet.Reps,
                                Weight = sourceSet.Weight,
                                DurationSeconds = sourceSet.DurationSeconds,
                                DistanceMeters = sourceSet.DistanceMeters,
                                IsCompleted = sourceSet.IsCompleted,
                                Notes = sourceSet.Notes,
                                CompletedAt = sourceSet.CompletedAt
                            };

                            var newSet = await WorkoutExerciseService.CreateSetAsync(newSetDto);
                            if (newSet == null)
                            {
                                Snackbar.Add($"Не удалось скопировать подход {sourceSet.SetNumber}", Severity.Warning);
                            }
                        }
                    }
                }
            }

            Snackbar.Add($"Тренировка \"{sourceWorkout.Name}\" успешно скопирована", Severity.Success);
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка при дублировании тренировки: {ex.Message}", Severity.Error);
        }
        finally
        {
            isDuplicating = false;
            StateHasChanged();
        }
    }
}
