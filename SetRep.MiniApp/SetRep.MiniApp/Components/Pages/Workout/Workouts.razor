@page "/workouts"
@using SetRep.Core.ApiRequestServices
@using SetRep.Core.Entities
@using SetRep.MiniApp.Client.Services
@using SetRep.MiniApp.Components.Dialog
@using SetRep.Shared.DTO
@using static SetRep.MiniApp.Client.Services.InitializationHelper

@rendermode InteractiveServer
@inject IWorkoutService WorkoutService
@inject IWorkoutExerciseService WorkoutExerciseService
@inject IWorkoutHistoryService WorkoutHistoryService
@inject ITelegramWebAppStateService TelegramWebAppStateService
@inject ITelegramBackButtonService TelegramBackButtonService
@inject IAppInitializationService AppInitializationService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>SetRep - Тренировки</PageTitle>

<div class="workouts-container">
    @if (isLoading)
    {
        <MudCard Elevation="2" Class="loading-card">
            <MudCardContent>
                <div class="loading-state">
                    <MudProgressCircular Indeterminate="true" Size="Size.Large" Class="mb-4" />
                    <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center">
                        Загрузка тренировок...
                    </MudText>
                </div>
            </MudCardContent>
        </MudCard>
    }
    else if (errorMessage != null)
    {
        <MudCard Elevation="2" Class="error-card">
            <MudCardContent>
                <div class="error-state">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" Class="mb-4" />
                    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-2">
                        Ошибка загрузки
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4">
                        @errorMessage
                    </MudText>
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadWorkouts">
                        Попробовать снова
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
    else if (workouts.Any())
    {
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Class="mb-4"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddWorkout">
            Добавить тренировку
        </MudButton>
        @if (isDuplicating)
        {
            <MudCard Elevation="2" Class="mb-3 workout-item-card">
                <MudCardContent>
                    <div class="workout-item-header">
                        <div class="workout-item-info">
                            <MudSkeleton Typo="Typo.h6" Width="60%" Height="24px" />
                        </div>
                        <div class="workout-item-right">
                            <MudSkeleton Width="24px" Height="24px" Variant="SkeletonVariant.Circular" />
                        </div>
                    </div>
                </MudCardContent>
            </MudCard>
        }
        @foreach (var workout in workouts.OrderByDescending(w => w.CreatedAt))
        {
            var isActive = activeWorkoutHistory != null && activeWorkoutHistory.WorkoutId == workout.Id;
            var wrapperClass = isActive ? "workout-card-wrapper active-workout-wrapper" : "workout-card-wrapper";
            var cardClass = isActive ? "mb-3 workout-item-card active-workout-card" : "mb-3 workout-item-card";
            <div @onclick="() => ViewWorkout(workout.Id)" 
                 class="@wrapperClass">
                <MudCard Elevation="2" Class="@cardClass">
                    <MudCardContent>
                        <div class="workout-item-header">
                            <div class="workout-item-info">
                                <MudText Typo="Typo.h6">
                                    @workout.Name
                                </MudText>
                            </div>
                            <div class="workout-item-right" @onclick:stopPropagation="true">
                                @if (isActive)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Circle"
                                             Color="Color.Info"
                                             Class="active-indicator" />
                                }
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                         Color="Color.Default"
                                         AnchorOrigin="Origin.BottomRight"
                                         TransformOrigin="Origin.TopRight"
                                         Variant="Variant.Text"
                                         Size="Size.Medium"
                                         Class="workout-menu-button"
                                         StopPropagation="true">
                                    <MudMenuItem OnClick="@(() => OpenEditDialog(workout))" Icon="@Icons.Material.Filled.Edit">
                                        Редактировать
                                    </MudMenuItem>
                                    <MudMenuItem OnClick="@(() => DuplicateWorkout(workout))" Icon="@Icons.Material.Filled.ContentCopy">
                                        Дублировать
                                    </MudMenuItem>
                                    <MudDivider />
                                    <MudMenuItem OnClick="@(() => ConfirmDeleteWorkout(workout))" Icon="@Icons.Material.Filled.Delete" Color="Color.Error">
                                        Удалить
                                    </MudMenuItem>
                                </MudMenu>
                            </div>
                        </div>
                    </MudCardContent>
                </MudCard>
            </div>
        }
    }
    else
    {
        <MudCard Elevation="2" Class="empty-state-card">
            <MudCardContent>
                <div class="empty-state">
                    <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Large" Color="Color.Secondary" Class="mb-4" />
                    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-2">
                        Нет тренировок
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4">
                        Добавьте первую тренировку, чтобы начать отслеживать прогресс
                    </MudText>
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddWorkout">
                        Добавить тренировку
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
</div>

<style>
    .workouts-container {
        max-width: 100%;
    }

    .workout-card-wrapper {
        cursor: pointer;
    }


    .workout-item-card {
        border-radius: 12px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .active-workout-card {
        border: 2px solid var(--mud-palette-primary);
    }

    .workout-card-wrapper:hover .workout-item-card:not(.active-workout-card) {
        transform: translateY(-2px);
    }

    .active-workout-wrapper:hover .active-workout-card {
        transform: translateY(-2px);
    }

    .workout-item-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }

    .workout-item-info {
        flex: 1;
    }

    .workout-item-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }


    .active-indicator {
        width: 12px;
        height: 12px;
    }

    .empty-state-card {
        border-radius: 12px;
        margin-top: 32px;
    }

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 24px;
    }

    .loading-card, .error-card {
        border-radius: 12px;
        margin-top: 32px;
    }

    .loading-state, .error-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 24px;
    }
</style>

@code {
    private List<Workout> workouts = new();
    private WorkoutHistory? activeWorkoutHistory;
    private bool isLoading = true;
    private bool isDeleting = false;
    private bool isDuplicating = false;
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await WaitForInitializationAsync(AppInitializationService);
            await LoadWorkouts();
            await LoadActiveWorkout();
            await TelegramBackButtonService.HideAsync();
            StateHasChanged();
        }
    }

    private async Task LoadWorkouts()
    {
        isLoading = true;
        errorMessage = null;
        
        try
        {
            // Получаем userId из валидированных данных Telegram WebApp
            var userId = TelegramWebAppStateService.ValidationResult?.Data?.User?.Id;
            
            if (userId == null || userId == Guid.Empty)
            {
                errorMessage = "Не удалось определить пользователя. Пожалуйста, обновите страницу.";
                workouts = new List<Workout>();
                isLoading = false;
                return;
            }

            var data = await WorkoutService.GetWorkoutsAsync(userId.Value);
            if (data != null)
            {
                workouts = data;
            }
            else
            {
                errorMessage = "Не удалось загрузить тренировки. Проверьте подключение к API.";
                workouts = new List<Workout>();
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Ошибка сети при подключении к API: {ex.Message}. " +
                          "Убедитесь, что API сервер запущен и доступен.";
            workouts = new List<Workout>();
        }
        catch (TaskCanceledException ex) when (ex.InnerException is TimeoutException)
        {
            errorMessage = "Превышено время ожидания ответа от API. Сервер может быть перегружен или недоступен.";
            workouts = new List<Workout>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось загрузить тренировки: {ex.Message}";
            workouts = new List<Workout>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadActiveWorkout()
    {
        try
        {
            var userId = TelegramWebAppStateService.ValidationResult?.Data?.User?.Id;
            
            if (userId != null && userId != Guid.Empty)
            {
                activeWorkoutHistory = await WorkoutHistoryService.GetActiveWorkoutAsync(userId.Value);
            }
        }
        catch
        {
            // Игнорируем ошибки загрузки активной тренировки
        }
    }

    private void ViewWorkout(Guid workoutId)
    {
        // Всегда переходим в детали тренировки
        Navigation.NavigateTo($"/workouts/{workoutId}");
    }

    private void AddWorkout()
    {
        Navigation.NavigateTo("/workouts/add");
    }

    private async Task OpenEditDialog(Workout workout)
    {
        if (workout == null || isDeleting)
        {
            return;
        }

        var parameters = new DialogParameters<EditWorkoutDialog>
        {
            { nameof(EditWorkoutDialog.Workout), workout }
        };
        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true, 
            MaxWidth = MaxWidth.Small, 
            FullWidth = true 
        };

        var dialogReference = await DialogService.ShowAsync<EditWorkoutDialog>("Редактировать тренировку", parameters, options);
        var result = await dialogReference.Result;

        if (!result.Canceled)
        {
            await LoadWorkouts();
        }
    }

    private async Task ConfirmDeleteWorkout(Workout workout)
    {
        if (workout == null || isDeleting)
        {
            return;
        }

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { nameof(ConfirmDialog.Title), "Подтверждение удаления" },
            { nameof(ConfirmDialog.ContentText), $"Вы уверены, что хотите удалить тренировку \"{workout.Name}\"? Это действие нельзя отменить." },
            { nameof(ConfirmDialog.ButtonText), "Удалить" },
            { nameof(ConfirmDialog.Color), Color.Error }
        };

        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true, 
            MaxWidth = MaxWidth.Small, 
            FullWidth = true 
        };

        var dialogReference = await DialogService.ShowAsync<ConfirmDialog>("Подтверждение удаления", parameters, options);
        var result = await dialogReference.Result;

        if (!result.Canceled)
        {
            await DeleteWorkout(workout.Id);
        }
    }

    private async Task DeleteWorkout(Guid workoutId)
    {
        if (isDeleting)
        {
            return;
        }

        isDeleting = true;
        StateHasChanged();

        try
        {
            var workout = workouts.FirstOrDefault(w => w.Id == workoutId);
            if (workout == null)
            {
                return;
            }

            if (activeWorkoutHistory != null && activeWorkoutHistory.WorkoutId == workoutId)
            {
                var endSuccess = await WorkoutHistoryService.EndWorkoutAsync(activeWorkoutHistory.Id);
                if (!endSuccess)
                {
                    Snackbar.Add("Не удалось завершить активную тренировку. Удаление отменено.", Severity.Error);
                    return;
                }

                activeWorkoutHistory = null;
            }

            var success = await WorkoutService.DeleteWorkoutAsync(workoutId);
            if (success)
            {
                await LoadWorkouts();
                await LoadActiveWorkout();
            }
            else
            {
                Snackbar.Add("Ошибка при удалении тренировки", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка при удалении тренировки: {ex.Message}", Severity.Error);
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    private async Task DuplicateWorkout(Workout workout)
    {
        if (workout == null || isDuplicating || isDeleting)
        {
            return;
        }

        isDuplicating = true;
        StateHasChanged();

        try
        {
            var userId = TelegramWebAppStateService.ValidationResult?.Data?.User?.Id;
            if (userId == null || userId == Guid.Empty)
            {
                Snackbar.Add("Не удалось определить пользователя", Severity.Error);
                return;
            }

            // Загружаем полную информацию о тренировке с упражнениями
            var sourceWorkout = await WorkoutService.GetWorkoutDetailsAsync(workout.Id);
            if (sourceWorkout == null)
            {
                Snackbar.Add("Не удалось загрузить информацию о тренировке", Severity.Error);
                return;
            }

            // Создаем новую тренировку
            var newWorkoutDto = new CreateWorkoutDto
            {
                UserId = userId.Value,
                Name = $"Копия {sourceWorkout.Name}",
                Notes = sourceWorkout.Notes
            };

            var newWorkout = await WorkoutService.CreateWorkoutAsync(newWorkoutDto);
            if (newWorkout == null)
            {
                Snackbar.Add("Не удалось создать копию тренировки", Severity.Error);
                return;
            }

            // Копируем упражнения и подходы
            if (sourceWorkout.WorkoutExercises != null && sourceWorkout.WorkoutExercises.Any())
            {
                // Сортируем упражнения по порядку
                var orderedExercises = sourceWorkout.WorkoutExercises.OrderBy(we => we.Order).ToList();

                foreach (var sourceExercise in orderedExercises)
                {
                    // Создаем новую связь тренировки и упражнения
                    var newWorkoutExerciseDto = new CreateWorkoutExerciseDto
                    {
                        WorkoutId = newWorkout.Id,
                        ExerciseId = sourceExercise.ExerciseId,
                        Order = sourceExercise.Order,
                        Notes = sourceExercise.Notes
                    };

                    var newWorkoutExercise = await WorkoutExerciseService.CreateWorkoutExerciseAsync(newWorkoutExerciseDto);
                    if (newWorkoutExercise == null)
                    {
                        Snackbar.Add($"Не удалось скопировать упражнение", Severity.Warning);
                        continue;
                    }

                    // Загружаем подходы для исходного упражнения
                    var sets = await WorkoutExerciseService.GetSetsByWorkoutExerciseIdAsync(sourceExercise.Id);
                    if (sets != null && sets.Any())
                    {
                        // Сортируем подходы по номеру
                        var orderedSets = sets.OrderBy(s => s.SetNumber).ToList();

                        foreach (var sourceSet in orderedSets)
                        {
                            // Создаем новый подход
                            var newSetDto = new CreateSetDto
                            {
                                WorkoutExerciseId = newWorkoutExercise.Id,
                                SetNumber = sourceSet.SetNumber,
                                Reps = sourceSet.Reps,
                                Weight = sourceSet.Weight,
                                DurationSeconds = sourceSet.DurationSeconds,
                                DistanceMeters = sourceSet.DistanceMeters,
                                RestSeconds = sourceSet.RestSeconds,
                                IsCompleted = sourceSet.IsCompleted,
                                Notes = sourceSet.Notes,
                                CompletedAt = sourceSet.CompletedAt
                            };

                            var newSet = await WorkoutExerciseService.CreateSetAsync(newSetDto);
                            if (newSet == null)
                            {
                                Snackbar.Add($"Не удалось скопировать подход {sourceSet.SetNumber}", Severity.Warning);
                            }
                        }
                    }
                }
            }

            Snackbar.Add($"Тренировка \"{sourceWorkout.Name}\" успешно скопирована", Severity.Success);
            await LoadWorkouts();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка при дублировании тренировки: {ex.Message}", Severity.Error);
        }
        finally
        {
            isDuplicating = false;
            StateHasChanged();
        }
    }
}

