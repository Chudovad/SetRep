@page "/workouts/add"
@using System.Text.Json
@using System.Text.Json.Serialization
@using SetRep.Core.ApiRequestServices
@using SetRep.Core.Entities
@using SetRep.MiniApp.Components.Dialog
@using SetRep.Shared.DTO
@using SetRep.MiniApp.Client.Services
@using static SetRep.MiniApp.Client.Services.InitializationHelper
@rendermode InteractiveServer
@inject IWorkoutService WorkoutService
@inject IWorkoutExerciseService WorkoutExerciseService
@inject IUserService UserService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ITelegramBackButtonService TelegramBackButtonService
@inject ITelegramWebAppStateService TelegramWebAppStateService
@inject IAppInitializationService AppInitializationService
@implements IAsyncDisposable

<PageTitle>SetRep - Добавить тренировку</PageTitle>

<div class="add-workout-container">
    <MudCard Elevation="2" Class="mb-4">
        <MudCardContent>
            <MudForm @ref="form" @bind-IsValid="@isFormValid">
                <MudTextField T="string"
                            Label="Название тренировки"
                            @bind-Value="workoutDto.Name"
                            Variant="Variant.Outlined"
                            Placeholder="Например: Тренировка груди"
                            Required="true"
                            RequiredError="Название обязательно для заполнения"
                            Class="mb-3" />
                <MudTextField T="string"
                              Label="Заметки к тренировке"
                              @bind-Value="workoutDto.Notes"
                              Variant="Variant.Outlined"
                              Class="mb-3" />
            </MudForm>
        </MudCardContent>
    </MudCard>

    <!-- Список добавленных упражнений -->
    @if (selectedExercises.Any())
    {
        <MudCard Elevation="2" Class="mb-4">
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-3">Добавленные упражнения (@selectedExercises.Count)</MudText>
                <MudList T="List<Exercise>" Dense="true">
                    @for (int i = 0; i < selectedExercises.Count; i++)
                    {
                        var exercise = selectedExercises[i];
                        <MudListItem>
                            <div class="exercise-list-item">
                                @if (!string.IsNullOrWhiteSpace(exercise.MainImage))
                                {
                                    <div class="exercise-image-container">
                                        <img src="@exercise.MainImage" alt="@exercise.Name" class="exercise-image" />
                                    </div>
                                }
                                <div class="exercise-info">
                                    <MudText Typo="Typo.body1" Class="exercise-name">@exercise.Name</MudText>
                                </div>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                             Color="Color.Error" 
                                             Size="Size.Small"
                                             OnClick="() => RemoveExercise(exercise.Id)" />
                            </div>
                        </MudListItem>
                    }
                </MudList>
            </MudCardContent>
        </MudCard>
    }

    <!-- Кнопка добавления упражнений -->
    <MudButton Variant="Variant.Filled" 
               Color="Color.Primary" 
               FullWidth="true" 
               Class="mb-4 add-exercise-btn"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenSelectExercisesDialog">
        Добавить новое упражнение
    </MudButton>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
    }

    <!-- Кнопки действий -->
    <div class="action-buttons">

        <MudStack Row="true">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       FullWidth="true"
                       OnClick="Cancel">
                Отмена
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       OnClick="SaveWorkout"
                       Disabled="@(!isFormValid || isSaving || !selectedExercises.Any())">
                @if (isSaving)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Сохранение...</MudText>
                }
                else
                {
                    <MudText>Сохранить</MudText>
                }
            </MudButton>
        </MudStack>
    </div>
</div>

<style>
    .add-workout-container {
        max-width: 100%;
    }

    .exercise-list-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        gap: 16px;
    }

    .exercise-image-container {
        flex-shrink: 0;
        width: 48px;
        height: 48px;
        border-radius: 8px;
        overflow: hidden;
    }

    .exercise-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .exercise-info {
        flex: 1;
    }

    .exercise-name {
        font-weight: 500;
    }

    .add-exercise-btn {
        height: 48px;
        border-radius: 12px;
        text-transform: none;
        font-weight: 500;
    }

    .action-buttons {
        margin-top: 16px;
    }


</style>

@code {
    private MudForm? form;
    private bool isFormValid;
    private bool isSaving = false;
    private string? errorMessage;

    private CreateWorkoutDto workoutDto = new()
    {
        Name = string.Empty,
        UserId = Guid.Empty,
    };

    private List<Exercise> selectedExercises = new();


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await WaitForInitializationAsync(AppInitializationService);
            await TelegramBackButtonService.ShowAsync();
        }
    }

    private async Task OpenSelectExercisesDialog()
    {
        var parameters = new DialogParameters<SelectExercisesDialog>();
        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true, 
            MaxWidth = MaxWidth.Medium, 
            FullWidth = true 
        };

        var dialogReference = await DialogService.ShowAsync<SelectExercisesDialog>("Выберите упражнения", parameters, options);
        var result = await dialogReference.Result;

        if (!result.Canceled && result.Data is List<Exercise> exercises)
        {
            foreach (var exercise in exercises)
            {
                if (!selectedExercises.Any(e => e.Id == exercise.Id))
                {
                    selectedExercises.Add(exercise);
                }
            }
            StateHasChanged();
        }
    }

    private void RemoveExercise(Guid exerciseId)
    {
        selectedExercises.RemoveAll(e => e.Id == exerciseId);
        StateHasChanged();
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/workouts");
    }

    private async Task SaveWorkout()
    {
        await form!.Validate();

        if (!isFormValid || isSaving || !selectedExercises.Any())
            return;

        isSaving = true;
        errorMessage = null;

        try
        {
            if (workoutDto.UserId == Guid.Empty && TelegramWebAppStateService.ValidationResult?.Data?.User != null)
            {
                var telegramId = TelegramWebAppStateService.ValidationResult.Data.User.TelegramId;
                var user = await UserService.GetUserByTelegramIdAsync(telegramId);

                if (user != null)
                {
                    workoutDto.UserId = user.Id;
                }
                else
                {
                    errorMessage = "Пользователь не найден. Пожалуйста, перезагрузите страницу.";
                    return;
                }
            }

            // Создаем тренировку через DTO
            var createdWorkout = await WorkoutService.CreateWorkoutAsync(workoutDto);
            if (createdWorkout == null)
            {
                errorMessage = "Ошибка при создании тренировки.";
                return;
            }

            //TODO переделать на добавление одним запросом и тренировку и упражнения.
            // Добавляем упражнения в тренировку
            int order = 0;
            foreach (var exercise in selectedExercises)
            {
                var workoutExerciseDto = new CreateWorkoutExerciseDto
                {
                    WorkoutId = createdWorkout.Id,
                    ExerciseId = exercise.Id,
                    Order = order++
                };

                var createdWorkoutExercise = await WorkoutExerciseService.CreateWorkoutExerciseAsync(workoutExerciseDto);
                if (createdWorkoutExercise == null)
                {
                    errorMessage = $"Ошибка при добавлении упражнения '{exercise.Name}' в тренировку.";
                    return;
                }
            }

            Navigation.NavigateTo("/workouts");
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Ошибка сети: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось создать тренировку: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }


    public async ValueTask DisposeAsync()
    {

    }
}
