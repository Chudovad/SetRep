    private async Task ReplaceExercise()
    {
        if (currentExercise == null || workout == null)
            return;

        // Получаем список ID упражнений, которые уже есть в тренировке — с учётом замен в истории
        var excludedExerciseIds = workout.WorkoutExercises?
            .Select(we => GetEffectiveExerciseId(we))
            .Distinct()
            .ToList() ?? new List<Guid>();

        var parameters = new DialogParameters<ReplaceExerciseDialog>
        {
            { nameof(ReplaceExerciseDialog.CurrentWorkoutExercise), currentExercise },
            { nameof(ReplaceExerciseDialog.ExcludedExerciseIds), excludedExerciseIds }
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialogReference = await DialogService.ShowAsync<ReplaceExerciseDialog>("Заменить упражнение", parameters, options);
        var result = await dialogReference.Result;

        if (result != null && !result.Canceled && result.Data is Exercise selectedExercise)
        {
            // Проверяем, что выбранное упражнение не совпадает с текущим (с учётом замены)
            if (selectedExercise.Id == GetEffectiveExerciseId(currentExercise))
            {
                Snackbar.Add("Выбрано то же самое упражнение", Severity.Info);
                return;
            }

            // Проверяем, что выбранное упражнение еще не добавлено в тренировку (с учётом замен)
            var existingExerciseIds = workout.WorkoutExercises?
                .Where(we => we.Id != currentExercise.Id)
                .Select(we => GetEffectiveExerciseId(we))
                .ToHashSet() ?? new HashSet<Guid>();

            if (existingExerciseIds.Contains(selectedExercise.Id))
            {
                Snackbar.Add("Это упражнение уже есть в тренировке", Severity.Warning);
                return;
            }

            await ReplaceCurrentExercise(selectedExercise);
        }
    }

    private async Task ReplaceCurrentExercise(Exercise newExercise)
    {
        if (currentExercise == null)
            return;

        try
        {
            // Обновляем только подходы в истории, не трогая шаблон тренировки
            var oldExerciseId = GetEffectiveExerciseId(currentExercise);
            foreach (var set in currentSets)
            {
                var updateDto = new CreateWorkoutHistorySetDto
                {
                    WorkoutHistoryId = WorkoutHistoryId,
                    ExerciseId = newExercise.Id,
                    SetNumber = set.SetNumber,
                    Reps = set.Reps,
                    Weight = set.Weight,
                    DurationSeconds = set.DurationSeconds,
                    DistanceMeters = set.DistanceMeters,
                    RestSeconds = set.RestSeconds,
                    IsCompleted = set.IsCompleted,
                    Notes = set.Notes,
                    CompletedAt = set.CompletedAt
                };
                await WorkoutHistorySetService.UpdateSetAsync(set.Id, updateDto);
            }

            exerciseReplacementsInHistory[currentExercise.Id] = newExercise;
            await SaveExerciseReplacementsToStorage();
            weightLabel = $"Вес ({newExercise.WeightUnit})";
            await LoadSetsForCurrentExercise();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await TelegramHapticService.NotificationErrorAsync();
            Snackbar.Add($"Ошибка при замене упражнения: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadExerciseReplacementsFromStorage()
    {
        try
        {
            var key = $"activeWorkout_{WorkoutHistoryId}_exerciseReplacements";
            var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", key);
            if (string.IsNullOrEmpty(json) || workout?.WorkoutExercises == null)
                return;

            var dict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(json);
            if (dict == null) return;

            foreach (var (weIdStr, exerciseIdStr) in dict)
            {
                if (!Guid.TryParse(weIdStr, out var weId) || !Guid.TryParse(exerciseIdStr, out var exerciseId))
                    continue;
                var exercise = await ExerciseService.GetExerciseByIdAsync(exerciseId);
                if (exercise != null)
                    exerciseReplacementsInHistory[weId] = exercise;
            }
        }
        catch { /* игнорируем */ }
    }

    private async Task SaveExerciseReplacementsToStorage()
    {
        try
        {
            var key = $"activeWorkout_{WorkoutHistoryId}_exerciseReplacements";
            var dict = exerciseReplacementsInHistory.ToDictionary(kv => kv.Key.ToString(), kv => kv.Value.Id.ToString());
            var json = System.Text.Json.JsonSerializer.Serialize(dict);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", key, json);
        }
        catch { /* игнорируем */ }
    }

    private async Task ClearWorkoutDataFromStorage()
    {
        try
        {
            var replacementsKey = $"activeWorkout_{WorkoutHistoryId}_exerciseReplacements";
            var exerciseIndexKey = $"activeWorkout_{WorkoutHistoryId}_exerciseIndex";
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", replacementsKey);
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", exerciseIndexKey);
        }
        catch { /* игнорируем */ }
    }

