@page "/workouts/{WorkoutId:guid}/active/{WorkoutHistoryId:guid}"
@using SetRep.Core.ApiRequestServices
@using SetRep.Core.Entities
@using SetRep.MiniApp.Client.Services
@using SetRep.Shared.DTO
@using static SetRep.MiniApp.Client.Services.InitializationHelper
@rendermode InteractiveServer
@inject IWorkoutService WorkoutService
@inject IWorkoutHistoryService WorkoutHistoryService
@inject IActiveWorkoutService ActiveWorkoutService
@inject IWorkoutHistorySetService WorkoutHistorySetService
@inject NavigationManager Navigation
@inject ITelegramBackButtonService TelegramBackButtonService
@inject IAppInitializationService AppInitializationService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>SetRep - Тренировка</PageTitle>

@if (isLoading)
{
    <div class="active-workout-container">
        <MudCard Elevation="2" Class="loading-card">
            <MudCardContent>
                <div class="loading-state">
                    <MudProgressCircular Indeterminate="true" Size="Size.Large" Class="mb-4" />
                    <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center">
                        Загрузка тренировки...
                    </MudText>
                </div>
            </MudCardContent>
        </MudCard>
    </div>
}
else if (errorMessage != null)
{
    <div class="active-workout-container">
        <MudCard Elevation="2" Class="error-card">
            <MudCardContent>
                <div class="error-state">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" Class="mb-4" />
                    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-2">
                        Ошибка загрузки
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4">
                        @errorMessage
                    </MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadWorkout">
                        Попробовать снова
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    </div>
}
else if (workout != null && currentExercise != null)
{
    <div class="active-workout-container">
        <!-- Таймер и навигация -->
        <MudCard Elevation="2" Class="mb-4 timer-card">
            <MudCardContent>
                <div class="timer-header">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                   Color="Color.Primary"
                                   OnClick="PreviousExercise"
                                   Disabled="currentExerciseIndex == 0" />
                    <div class="timer-display">
                        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-1">
                            @FormatDuration(workoutDuration)
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                            @(currentExerciseIndex + 1) из @exercises.Count
                        </MudText>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowForward"
                                   Color="Color.Primary"
                                   OnClick="NextExercise"
                                   Disabled="currentExerciseIndex >= exercises.Count - 1" />
                </div>
            </MudCardContent>
        </MudCard>

        <!-- Картинка упражнения -->
        @if (!string.IsNullOrWhiteSpace(currentExercise.Exercise.Image))
        {
            <MudCard Elevation="2" Class="mb-4 exercise-image-card">
                <MudCardContent Class="pa-0">
                    @if (currentExercise.Exercise.Image.EndsWith(".mp4"))
                    {
                        <video src="@currentExercise.Exercise.Image"
                               autoplay
                               loop
                               playsinline
                               muted
                               class="exercise-video"
                               title="@currentExercise.Exercise.Name"></video>
                    }
                    else
                    {
                        <img src="@currentExercise.Exercise.Image" alt="@currentExercise.Exercise.Name" class="exercise-image" />
                    }
                </MudCardContent>
            </MudCard>
        }
        else
        {
            <MudCard Elevation="2" Class="mb-4 exercise-image-card">
                <MudCardContent>
                    <div class="exercise-image-placeholder">
                        <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Large" Color="Color.Secondary" />
                    </div>
                </MudCardContent>
            </MudCard>
        }

        <!-- Название и описание упражнения -->
        <MudExpansionPanels Class="mb-4">
            <MudExpansionPanel Text="@currentExercise.Exercise.Name" MaxHeight="150">
                @currentExercise.Exercise.Description
            </MudExpansionPanel>
        </MudExpansionPanels>

        @if (!string.IsNullOrEmpty(currentExercise.Exercise.VideoUrl))
        {
            <MudExpansionPanels Class="mb-4">
                <MudExpansionPanel Text="Как делать упражнение">
                    <video src="@currentExercise.Exercise.VideoUrl"
                           loop
                           playsinline
                           muted
                           controls
                           class="exercise-video"
                           title="@currentExercise.Exercise.Name"></video>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }

        <!-- Форма добавления подхода -->
        <AddSetForm WeightLabel="@weightLabel"
                    Weight="@newSetWeight"
                    WeightChanged="@((decimal? value) => newSetWeight = value)"
                    Reps="@newSetReps"
                    RepsChanged="@((int value) => newSetReps = value)"
                    IsAddingSet="@isAddingSet"
                    OnAddSet="@AddSet"
                    WeightStep="@GetWeightStep()" />

        <!-- Таблица подходов -->
        @if (currentSets != null && currentSets.Any())
        {
            <MudCard Elevation="2" Class="mb-4 sets-table-card">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-3">Подходы</MudText>
                    <MudTable Items="@currentSets" Hover="true" Dense="true" Striped="true" Class="compact-table" Breakpoint="Breakpoint.None">
                        <HeaderContent>
                            <MudTh> </MudTh>
                            <MudTh>№</MudTh>
                            <MudTh>Вес</MudTh>
                            <MudTh>Повт.</MudTh>
                            <MudTh> </MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Выполнено">
                                @if (editingSetId != context.Id)
                                {
                                    <MudCheckBox T="bool" Color="Color.Success" Value="@context.IsCompleted" ValueChanged="(bool value) => ToggleSetCompletion(context.Id, value)" />
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="№">@context.SetNumber</MudTd>
                            <MudTd DataLabel="Вес">
                                @if (editingSetId == context.Id && editingField == "weight")
                                {
                                    <MudNumericField T="decimal?"
                                                     @bind-Value="editingWeight"
                                                     Variant="Variant.Outlined"
                                                     Min="0"
                                                     Step="@((decimal?)GetWeightStep())"
                                                     Immediate="true"
                                                     Style="width: 80px;"
                                                     Margin="Margin.Dense"
                                                     @onblur="() => SaveSet(context.Id)" />
                                }
                                else
                                {
                                    <span @onclick="() => StartEditing(context.Id, weightString, context.Weight)" style="cursor: pointer;">
                                        @if (context.Weight.HasValue)
                                        {
                                            @context.Weight.Value.ToString("0.##")@(currentExercise.Exercise.WeightUnit)
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                                        }
                                    </span>
                                }
                            </MudTd>
                            <MudTd DataLabel="Повторения">
                                @if (editingSetId == context.Id && editingField == "reps")
                                {
                                    <MudNumericField T="int"
                                                     @bind-Value="editingReps"
                                                     Variant="Variant.Outlined"
                                                     Min="0"
                                                     Step="1"
                                                     Immediate="true"
                                                     Style="width: 80px;"
                                                     Margin="Margin.Dense"
                                                     @onblur="() => SaveSet(context.Id)" />
                                }
                                else
                                {
                                    <span @onclick="() => StartEditing(context.Id, repsString, context.Reps)" style="cursor: pointer;">
                                        @if (context.Reps > 0)
                                        {
                                            @context.Reps
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                                        }
                                    </span>
                                }
                            </MudTd>
                            <MudTd DataLabel="Действия">
                                @if (editingSetId == context.Id)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Check"
                                                   Color="Color.Success"
                                                   Size="Size.Small"
                                                   OnClick="() => SaveSet(context.Id)" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Color="Color.Default"
                                                   Size="Size.Small"
                                                   OnClick="CancelEditing" />
                                }
                                else
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="() => DeleteSet(context.Id)" />
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        }
        else
        {
            <MudCard Elevation="2" Class="empty-state-card">
                <MudCardContent>
                    <div class="empty-state">
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                            Нет подходов. Добавьте первый подход выше.
                        </MudText>
                    </div>
                </MudCardContent>
            </MudCard>
        }

        <!-- Кнопка завершения тренировки -->
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   FullWidth="true"
                   Class="mt-4"
                   StartIcon="@Icons.Material.Filled.Stop"
                   OnClick="EndWorkout"
                   Disabled="isEndingWorkout">
            @if (isEndingWorkout)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <span class="ms-2">Завершение тренировки...</span>
            }
            else
            {
                <span>Завершить тренировку</span>
            }
        </MudButton>
    </div>
}

<style>
    .active-workout-container {
        max-width: 100%;
        padding-bottom: 20px;
    }

    .timer-card {
        border-radius: 12px;
        position: sticky;
        top: 0;
        z-index: 10;
        background-color: var(--mud-palette-background);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }

    .timer-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }

    .timer-display {
        flex: 1;
        text-align: center;
    }

    .exercise-image {
        max-height: 250px;
    }

    .exercise-video {
        max-height: 250px;
    }

    .exercise-image-placeholder {
        padding: 32px 24px;
        min-height: 150px;
    }

    .exercise-info-card {
        border-radius: 12px;
    }

    .exercise-description {
        white-space: pre-wrap;
        word-wrap: break-word;
    }

</style>

@code {
    [Parameter] public Guid WorkoutId { get; set; }
    [Parameter] public Guid WorkoutHistoryId { get; set; }

    private Workout? workout;
    private WorkoutHistory? workoutHistory;
    private List<WorkoutExercise> exercises = new();
    private WorkoutExercise? currentExercise;
    private int currentExerciseIndex = 0;
    private List<WorkoutHistorySet> currentSets = new();
    private TimeSpan workoutDuration = TimeSpan.Zero;
    private bool isLoading = true;
    private bool isAddingSet = false;
    private bool isEndingWorkout = false;
    private string? errorMessage;
    private decimal? newSetWeight;
    private int newSetReps;
    private string weightLabel = "Вес (кг)";
    private string weightString = "weight";
    private string repsString = "reps";

    // Редактирование подхода
    private Guid? editingSetId;
    private string? editingField;
    private decimal? editingWeight;
    private int editingReps;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await WaitForInitializationAsync(AppInitializationService);
            await TelegramBackButtonService.ShowAsync();
            ActiveWorkoutService.DurationUpdated += OnDurationUpdated;
            await LoadWorkout();
            StateHasChanged();
        }
    }

    private void OnDurationUpdated(TimeSpan duration)
    {
        workoutDuration = duration;
        InvokeAsync(StateHasChanged);
    }

    private async Task LoadWorkout()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            workout = await WorkoutService.GetWorkoutDetailsAsync(WorkoutId);
            if (workout == null || workout.WorkoutExercises == null || !workout.WorkoutExercises.Any())
            {
                errorMessage = "В тренировке нет упражнений";
                return;
            }

            exercises = workout.WorkoutExercises.OrderBy(we => we.Order).ToList();
            
            var savedIndex = await LoadSavedExerciseIndex();
            if (savedIndex.HasValue && savedIndex.Value >= 0 && savedIndex.Value < exercises.Count)
            {
                currentExerciseIndex = savedIndex.Value;
            }
            else
            {
                currentExerciseIndex = 0;
            }
            
            currentExercise = exercises[currentExerciseIndex];

            if (currentExercise?.Exercise != null)
            {
                weightLabel = $"Вес ({currentExercise.Exercise.WeightUnit})";
            }

            workoutHistory = await WorkoutHistoryService.GetWorkoutHistoryDetailsAsync(WorkoutHistoryId);
            if (workoutHistory != null)
            {
                workoutDuration = ActiveWorkoutService.GetWorkoutDuration(workoutHistory);
            }

            await LoadSetsForCurrentExercise();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка при загрузке: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadSetsForCurrentExercise()
    {
        if (currentExercise == null)
        {
            return;
        }

        try
        {
            var sets = await WorkoutHistorySetService.GetSetsByWorkoutHistoryAndExerciseAsync(WorkoutHistoryId, currentExercise.ExerciseId);
            currentSets = sets?.OrderBy(s => s.SetNumber).ToList() ?? new List<WorkoutHistorySet>();
        }
        catch
        {
            currentSets = new List<WorkoutHistorySet>();
        }
    }

    private async Task PreviousExercise()
    {
        if (currentExerciseIndex > 0)
        {
            currentExerciseIndex--;
            currentExercise = exercises[currentExerciseIndex];
            if (currentExercise?.Exercise != null)
            {
                weightLabel = $"Вес ({currentExercise.Exercise.WeightUnit})";
            }
            await SaveExerciseIndex();
            await LoadSetsForCurrentExercise();
            CancelEditing();
        }
    }

    private async Task NextExercise()
    {
        if (currentExerciseIndex < exercises.Count - 1)
        {
            currentExerciseIndex++;
            currentExercise = exercises[currentExerciseIndex];
            if (currentExercise?.Exercise != null)
            {
                weightLabel = $"Вес ({currentExercise.Exercise.WeightUnit})";
            }
            await SaveExerciseIndex();
            await LoadSetsForCurrentExercise();
            CancelEditing();
        }
    }

    private async Task AddSet()
    {
        if (currentExercise == null || newSetReps <= 0)
        {
            return;
        }

        isAddingSet = true;

        try
        {
            var nextSetNumber = currentSets.Any() ? currentSets.Max(s => s.SetNumber) + 1 : 1;

            var createSetDto = new CreateWorkoutHistorySetDto
            {
                WorkoutHistoryId = WorkoutHistoryId,
                ExerciseId = currentExercise.ExerciseId,
                SetNumber = nextSetNumber,
                Reps = newSetReps,
                Weight = newSetWeight,
                IsCompleted = true,
                CompletedAt = DateTime.UtcNow
            };

            var createdSet = await WorkoutHistorySetService.CreateSetAsync(createSetDto);
            if (createdSet != null)
            {
                await LoadSetsForCurrentExercise();
                newSetWeight = null;
                newSetReps = 0;
            }
            else
            {
                Snackbar.Add("Ошибка при добавлении подхода", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
        finally
        {
            isAddingSet = false;
        }
    }

    private void StartEditing(Guid setId, string field, object? value)
    {
        editingSetId = setId;
        editingField = field;

        if (field == "weight" && value is decimal weight)
        {
            editingWeight = weight;
        }
        else if (field == "reps" && value is int reps)
        {
            editingReps = reps;
        }
    }

    private void CancelEditing()
    {
        editingSetId = null;
        editingField = null;
        editingWeight = null;
        editingReps = 0;
    }

    private async Task SaveSet(Guid setId)
    {
        if (currentExercise == null || editingSetId != setId)
        {
            return;
        }

        try
        {
            var set = currentSets.FirstOrDefault(s => s.Id == setId);
            if (set == null)
            {
                return;
            }

            var updateDto = new CreateWorkoutHistorySetDto
            {
                WorkoutHistoryId = WorkoutHistoryId,
                ExerciseId = currentExercise.ExerciseId,
                SetNumber = set.SetNumber,
                Reps = editingField == "reps" ? editingReps : set.Reps,
                Weight = editingField == "weight" ? editingWeight : set.Weight,
                DurationSeconds = set.DurationSeconds,
                DistanceMeters = set.DistanceMeters,
                RestSeconds = set.RestSeconds,
                IsCompleted = set.IsCompleted,
                Notes = set.Notes,
                CompletedAt = set.CompletedAt
            };

            var success = await WorkoutHistorySetService.UpdateSetAsync(setId, updateDto);
            if (success)
            {
                await LoadSetsForCurrentExercise();
                CancelEditing();
            }
            else
            {
                Snackbar.Add("Ошибка при обновлении подхода", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
    }

    private async Task ToggleSetCompletion(Guid setId, bool isCompleted)
    {
        try
        {
            var success = await WorkoutHistorySetService.ToggleSetCompletionAsync(setId, isCompleted);

            if (success)
            {
                await LoadSetsForCurrentExercise();
            }
            else
            {
                Snackbar.Add("Ошибка при обновлении статуса подхода", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteSet(Guid setId)
    {
        try
        {
            var success = await WorkoutHistorySetService.DeleteSetAsync(setId);

            if (success)
            {
                await LoadSetsForCurrentExercise();
            }
            else
            {
                Snackbar.Add("Ошибка при удалении подхода", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
    }

    private async Task EndWorkout()
    {
        isEndingWorkout = true;
        StateHasChanged();

        try
        {
            var success = await WorkoutHistoryService.EndWorkoutAsync(WorkoutHistoryId);
            if (success)
            {
                Navigation.NavigateTo($"/workouts/{WorkoutId}");
            }
            else
            {
                Snackbar.Add("Ошибка при завершении тренировки", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
        finally
        {
            isEndingWorkout = false;
        }
    }

    private string FormatDuration(TimeSpan duration)
    {
        return $"{(int)duration.TotalHours:D2}:{duration.Minutes:D2}:{duration.Seconds:D2}";
    }

    private async Task SaveExerciseIndex()
    {
        try
        {
            var key = $"activeWorkout_{WorkoutHistoryId}_exerciseIndex";
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", key, currentExerciseIndex.ToString());
        }
        catch
        {
            // Игнорируем ошибки при сохранении в localStorage
        }
    }

    private async Task<int?> LoadSavedExerciseIndex()
    {
        try
        {
            var key = $"activeWorkout_{WorkoutHistoryId}_exerciseIndex";
            var savedIndexStr = await JSRuntime.InvokeAsync<string>("localStorage.getItem", key);
            if (!string.IsNullOrEmpty(savedIndexStr) && int.TryParse(savedIndexStr, out var index))
            {
                return index;
            }
        }
        catch
        {
            // Игнорируем ошибки при загрузке из localStorage
        }
        return null;
    }

    private decimal GetWeightStep()
    {
        return ExerciseStepHelper.GetWeightStep(currentExercise?.Exercise?.MuscleGroup);
    }

    public async ValueTask DisposeAsync()
    {
        ActiveWorkoutService.DurationUpdated -= OnDurationUpdated;
    }
}
