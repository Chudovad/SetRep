@page "/workouts/{WorkoutId:guid}/active/{WorkoutHistoryId:guid}"
@using SetRep.Core.ApiRequestServices
@using SetRep.Core.Entities
@using SetRep.Core.Enums
@using SetRep.MiniApp.Client.Services
@using SetRep.MiniApp.Components.Controls
@using SetRep.MiniApp.Components.Dialog
@using SetRep.Shared.DTO
@using static SetRep.MiniApp.Client.Services.InitializationHelper
@rendermode InteractiveWebAssembly
@inject IWorkoutService WorkoutService
@inject IWorkoutHistoryService WorkoutHistoryService
@inject IActiveWorkoutService ActiveWorkoutService
@inject IWorkoutHistorySetService WorkoutHistorySetService
@inject IExerciseService ExerciseService
@inject IWorkoutExerciseService WorkoutExerciseService
@inject NavigationManager Navigation
@inject ITelegramBackButtonService TelegramBackButtonService
@inject ITelegramHapticService TelegramHapticService
@inject IAppInitializationService AppInitializationService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>SetRep - Тренировка</PageTitle>

@if (isLoading)
{
    <div class="active-workout-container">
        @* Скелетон таймера и навигации *@
        <MudCard Elevation="2" Class="mb-4 timer-card">
            <MudCardContent>
                <div class="timer-header">
                    <MudSkeleton Width="40px" Height="40px" SkeletonType="SkeletonType.Circle" />
                    <div class="d-flex flex-column align-center justify-center flex-grow-1">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="100px" Height="32px" Class="mb-1" />
                        <MudSkeleton Width="80px" Height="20px" />
                    </div>
                    <MudSkeleton Width="40px" Height="40px" SkeletonType="SkeletonType.Circle" />
                </div>
            </MudCardContent>
        </MudCard>

        @* Скелетон изображения упражнения *@
        <MudCard Elevation="2" Class="mb-4 exercise-image-card">
            <MudCardContent Class="pa-0">
                <MudSkeleton Height="250px" Width="100%" />
            </MudCardContent>
        </MudCard>

        @* Скелетон названия и описания упражнения *@
        <MudCard Elevation="2" Class="mb-4">
            <MudCardContent>
                <div class="exercise-header-with-actions">
                    <MudSkeleton Width="70%" Height="24px" />
                    <MudSkeleton Width="40px" Height="40px" SkeletonType="SkeletonType.Circle" />
                </div>
                <MudSkeleton Width="100%" Height="60px" Class="mt-2" />
            </MudCardContent>
        </MudCard>

        @* Скелетон таблицы подходов *@
        <MudCard Elevation="2" Class="mb-4 sets-table-card">
            <MudCardContent>
                <MudSkeleton Width="100px" Height="24px" Class="mb-3" />
                @* Скелетон таблицы *@
                <div class="skeleton-table">
                    <div class="skeleton-table-header">
                        <MudSkeleton Width="30px" Height="20px" />
                        <MudSkeleton Width="30px" Height="20px" />
                        <MudSkeleton Width="50px" Height="20px" />
                        <MudSkeleton Width="60px" Height="20px" />
                        <MudSkeleton Width="40px" Height="20px" />
                    </div>
                    @for (int j = 0; j < 3; j++)
                    {
                        <div class="skeleton-table-row">
                            <MudSkeleton Width="20px" Height="20px" />
                            <MudSkeleton Width="20px" Height="20px" />
                            <MudSkeleton Width="40px" Height="20px" />
                            <MudSkeleton Width="30px" Height="20px" />
                            <MudSkeleton Width="30px" Height="30px" SkeletonType="SkeletonType.Circle" />
                        </div>
                    }
                </div>
            </MudCardContent>
        </MudCard>

        @* Скелетон кнопки завершения тренировки *@
        <MudSkeleton Width="100%" Height="48px" Class="mt-4" />
    </div>
}
else if (errorMessage != null)
{
    <div class="active-workout-container">
        <MudCard Elevation="2" Class="error-card">
            <MudCardContent>
                <div class="error-state">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" Class="mb-4" />
                    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-2">
                        Ошибка загрузки
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4">
                        @errorMessage
                    </MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadWorkout">
                        Попробовать снова
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    </div>
}
else if (workout != null && currentExercise != null)
{
    <div class="active-workout-container">
        <!-- Таймер и навигация -->
        <MudCard Elevation="2" Class="mb-4 timer-card">
            <MudCardContent>
                <div class="timer-header">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                   Color="Color.Primary"
                                   OnClick="PreviousExercise"
                                   Disabled="currentExerciseIndex == 0" />
                    <div class="timer-display">
                        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-1">
                            @FormatDuration(workoutDuration)
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                            @(currentExerciseIndex + 1) из @exercises.Count
                        </MudText>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowForward"
                                   Color="Color.Primary"
                                   OnClick="NextExercise"
                                   Disabled="currentExerciseIndex >= exercises.Count - 1" />  
                </div>
            </MudCardContent>
        </MudCard>

        <!-- Табы -->
        <MudTabs Elevation="2" Class="mb-4 tabs-sticky" @bind-ActivePanelIndex="activeTabIndex" Centered="true">
            <!-- Таб 1: Подходы -->
            <MudTabPanel Text="Подходы">
                <!-- Картинка упражнения -->
                @if (!string.IsNullOrWhiteSpace(DisplayExercise.Image))
                {
                    <MudCard Elevation="2" Class="mb-4 mt-4 exercise-image-card">
                        <MudCardContent Class="pa-0">
                            @if (DisplayExercise.Image.EndsWith(".mp4"))
                            {
                                <video src="@DisplayExercise.Image"
                                       autoplay
                                       loop
                                       playsinline
                                       muted
                                       class="exercise-video"
                                       title="@DisplayExercise.Name"></video>
                            }
                            else
                            {
                                <img src="@DisplayExercise.Image" alt="@DisplayExercise.Name" class="exercise-image" />
                            }
                        </MudCardContent>
                    </MudCard>
                }
                else
                {
                    <MudCard Elevation="2" Class="mb-4 exercise-image-card">
                        <MudCardContent>
                            <div class="exercise-image-placeholder">
                                <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Large" Color="Color.Secondary" />
                            </div>
                        </MudCardContent>
                    </MudCard>
                }

                <!-- Название упражнения -->
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardContent>
                        <div class="exercise-header-with-actions">
                            <MudText Typo="Typo.h6" Class="exercise-name-header">@DisplayExercise.Name</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz"
                                           Color="Color.Primary"
                                           Size="Size.Medium"
                                           OnClick="ReplaceExercise"
                                           Title="Заменить упражнение" />
                        </div>
                    </MudCardContent>
                </MudCard>

                <!-- Заметки к упражнению в тренировке -->
                @if (!string.IsNullOrWhiteSpace(currentExercise.Notes))
                {
                    <MudExpansionPanels Class="mb-4">
                        <MudExpansionPanel Text="Заметки к упражнению">
                            <MudText Typo="Typo.body1" Style="white-space: pre-wrap;">@currentExercise.Notes</MudText>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                }

                <!-- Таблица подходов -->
                @if (currentSets != null && currentSets.Any())
                {
                    <MudCard Elevation="2" Class="mb-4 sets-table-card">
                        <MudCardContent>
                            <MudText Typo="Typo.h6" Class="mb-3">Подходы</MudText>
                            <MudTable Items="@currentSets" Hover="true" Dense="true" Class="compact-table sets-table" Breakpoint="Breakpoint.None" RowClassFunc="@GetRowClass">
                                <HeaderContent>
                                    <MudTh Class="checkbox-column"> </MudTh>
                                    <MudTh>№</MudTh>
                                    <MudTh>Вес</MudTh>
                                    <MudTh>Повт.</MudTh>
                                    <MudTh> </MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Выполнено" Class="checkbox-column">
                                        @if (editingSetId != context.Id)
                                        {
                                            <MudCheckBox T="bool" Color="Color.Success" Value="@context.IsCompleted" ValueChanged="(bool value) => ToggleSetCompletion(context.Id, value)" />
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="№">@context.SetNumber</MudTd>
                                    <MudTd DataLabel="Вес">
                                        @if (editingSetId == context.Id && editingField == "weight")
                                        {
                                            <MudNumericField T="decimal?"
                                                             @bind-Value="editingWeight"
                                                             Variant="Variant.Outlined"
                                                             Min="0"
                                                             Step="@((decimal?)GetWeightStep())"
                                                             Immediate="true"
                                                             Style="width: 80px;"
                                                             Margin="Margin.Dense" />
                                        }
                                        else
                                        {
                                            <span @onclick="() => StartEditing(context.Id, weightString, context.Weight)" style="cursor: pointer;">
                                                @if (context.Weight.HasValue)
                                                {
                                                    @context.Weight.Value.ToString("0.##")
                                                    @(DisplayExercise.WeightUnit)
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                                                }
                                            </span>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Повторения" Style="width: 60px">
                                        @if (editingSetId == context.Id && editingField == "reps")
                                        {
                                            <MudNumericField T="int"
                                                             @bind-Value="editingReps"
                                                             Variant="Variant.Outlined"
                                                             Min="0"
                                                             Step="1"
                                                             Immediate="true"
                                                             Style="width: 60px;"
                                                             Margin="Margin.Dense" />
                                        }
                                        else
                                        {
                                            <span @onclick="() => StartEditing(context.Id, repsString, context.Reps)" style="cursor: pointer;">
                                                @if (context.Reps > 0)
                                                {
                                                    @context.Reps
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                                                }
                                            </span>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Действия">
                                        <div class="action-buttons">
                                            @if (editingSetId == context.Id)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Check"
                                                               Color="Color.Success"
                                                               Size="Size.Small"
                                                               OnClick="() => SaveSet(context.Id)" />
                                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                               Color="Color.Default"
                                                               Size="Size.Small"
                                                               OnClick="CancelEditing" />
                                            }
                                            else
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                               Color="Color.Error"
                                                               Size="Size.Small"
                                                               OnClick="() => DeleteSet(context.Id)" />
                                            }
                                        </div>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="AddSet"
                                       Disabled="@isAddingSet"
                                       Class="mt-2">
                                @if (isAddingSet)
                                {
                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                    <span class="ms-2">Добавление...</span>
                                }
                                else
                                {
                                    <span>Добавить подход</span>
                                }
                            </MudButton>
                        </MudCardContent>
                    </MudCard>
                }
                else
                {
                    <MudCard Elevation="2" Class="empty-state-card mb-4">
                        <MudCardContent>
                            <div class="empty-state">
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4">
                                    Нет подходов. Добавьте первый подход.
                                </MudText>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="AddSet"
                                           Disabled="@isAddingSet">
                                    @if (isAddingSet)
                                    {
                                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                        <span class="ms-2">Добавление...</span>
                                    }
                                    else
                                    {
                                        <span>Добавить подход</span>
                                    }
                                </MudButton>
                            </div>
                        </MudCardContent>
                    </MudCard>
                }

                <!-- Таймер отдыха для упражнения -->
                <RestTimerInput RestMinutes="restTimerMinutes"
                                RestSeconds="restTimerSeconds"
                                OnTimerSaved="SaveRestTimer"
                                Class="mb-4" />

            </MudTabPanel>

            <!-- Таб 2: Инструкция -->
            <MudTabPanel Text="Инструкция">
                <!-- Как делать упражнение -->
                <MudCard Elevation="2" Class="mb-4 mt-4">
                    <MudCardContent>
                        <MudText Typo="Typo.h6">Как делать упражнение</MudText>
                    </MudCardContent>
                </MudCard>

                <!-- Видео как делать упражнение -->
                @if (!string.IsNullOrEmpty(DisplayExercise.VideoUrl))
                {
                    <MudCard Elevation="2" Class="mb-4">
                        <MudCardContent Class="pa-0">
                            <video src="@DisplayExercise.VideoUrl"
                                   loop
                                   playsinline
                                   muted
                                   controls
                                   class="exercise-video"
                                   title="@DisplayExercise.Name"></video>
                        </MudCardContent>
                    </MudCard>
                }

                <!-- Название упражнения -->
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardContent>
                        <MudText Typo="Typo.h6">@DisplayExercise.Name</MudText>
                    </MudCardContent>
                </MudCard>

                <!-- Описание упражнения -->
                @if (!string.IsNullOrWhiteSpace(currentExercise.Exercise.Description))
                {
                    <MudCard Elevation="2" Class="mb-4">
                        <MudCardContent>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Style="white-space: pre-wrap;">
                                @DisplayExercise.Description
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                }
            </MudTabPanel>
        </MudTabs>

        <!-- Кнопка завершения тренировки -->
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   FullWidth="true"
                   Class="mt-4"
                   StartIcon="@Icons.Material.Filled.Stop"
                   OnClick="OpenEndActiveWorkoutDialog"
                   Disabled="isEndingWorkout">
            @if (isEndingWorkout)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <span class="ms-2">Завершение тренировки...</span>
            }
            else
            {
                <span>Завершить тренировку</span>
            }
        </MudButton>
    </div>
}

