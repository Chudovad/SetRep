</style>

@code {
    [Parameter] public Guid WorkoutId { get; set; }
    [Parameter] public Guid WorkoutHistoryId { get; set; }

    private Workout? workout;
    private WorkoutHistory? workoutHistory;
    private List<WorkoutExercise> exercises = new();
    private WorkoutExercise? currentExercise;
    private int currentExerciseIndex = 0;
    private List<WorkoutHistorySet> currentSets = new();
    private TimeSpan workoutDuration = TimeSpan.Zero;

    private Dictionary<Guid, Exercise> exerciseReplacementsInHistory = new();
    private bool isLoading = true;
    private bool isAddingSet = false;
    private bool isEndingWorkout = false;
    private string? errorMessage;
    private string weightLabel = "Вес (кг)";
    private string weightString = "weight";
    private string repsString = "reps";
    private int activeTabIndex = 0;

    // Таймер отдыха (минуты/секунды) для текущего упражнения
    private int restTimerMinutes = 1;
    private int restTimerSeconds = 0;

    // Редактирование подхода
    private Guid? editingSetId;
    private string? editingField;
    private decimal? editingWeight;
    private int editingReps;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await WaitForInitializationAsync(AppInitializationService);
            await TelegramBackButtonService.ShowAsync();
            ActiveWorkoutService.DurationUpdated += OnDurationUpdated;
            await LoadWorkout();
            StateHasChanged();
        }

    }

    private async Task SaveRestTimer((int minutes, int seconds) timerValues)
    {
        if (currentExercise == null)
            return;

        var total = timerValues.minutes * 60 + timerValues.seconds;

        var updateDto = new CreateWorkoutExerciseDto
        {
            WorkoutId = currentExercise.WorkoutId,
            ExerciseId = currentExercise.ExerciseId,
            Order = currentExercise.Order,
            Notes = currentExercise.Notes,
            RestSeconds = total
        };

        var success = await WorkoutExerciseService.UpdateWorkoutExerciseAsync(currentExercise.Id, updateDto);
        if (success)
        {
            currentExercise.RestSeconds = total;
            restTimerMinutes = timerValues.minutes;
            restTimerSeconds = timerValues.seconds;
            await TelegramHapticService.NotificationSuccessAsync();
            Snackbar.Add("Время отдыха сохранено", Severity.Success);
        }
        else
        {
            await TelegramHapticService.NotificationErrorAsync();
            Snackbar.Add("Ошибка при сохранении времени отдыха", Severity.Error);
        }
    }

    private async Task OpenRestTimerDialog(int initialSeconds)
    {
        var parameters = new DialogParameters<RestTimerDialog>
        {
            { nameof(RestTimerDialog.InitialSeconds), initialSeconds }
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = false,
            CloseButton = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialogReference = await DialogService.ShowAsync<RestTimerDialog>("", parameters, options);
        await dialogReference.Result;
    }

    private void OnDurationUpdated(TimeSpan duration)
    {
        workoutDuration = duration;
        InvokeAsync(StateHasChanged);
    }

    private async Task LoadWorkout()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            workout = await WorkoutService.GetWorkoutDetailsAsync(WorkoutId);
            if (workout == null || workout.WorkoutExercises == null || !workout.WorkoutExercises.Any())
            {
                errorMessage = "В тренировке нет упражнений";
                return;
            }

            exercises = workout.WorkoutExercises.OrderBy(we => we.Order).ToList();

            var savedIndex = await LoadSavedExerciseIndex();
            if (savedIndex.HasValue && savedIndex.Value >= 0 && savedIndex.Value < exercises.Count)
            {
                currentExerciseIndex = savedIndex.Value;
            }
            else
            {
                currentExerciseIndex = 0;
            }

            currentExercise = exercises[currentExerciseIndex];

            // Инициализируем значения таймера отдыха из сущности упражнения в тренировке
            if (currentExercise != null)
            {
                var rest = currentExercise.RestSeconds;
                restTimerMinutes = rest / 60;
                restTimerSeconds = rest % 60;
            }

            workoutHistory = await WorkoutHistoryService.GetWorkoutHistoryDetailsAsync(WorkoutHistoryId);
            if (workoutHistory != null)
            {
                workoutDuration = ActiveWorkoutService.GetWorkoutDuration(workoutHistory);
            }

            await LoadExerciseReplacementsFromStorage();
            if (currentExercise != null)
            {
                weightLabel = $"Вес ({DisplayExercise.WeightUnit})";
            }
            await LoadSetsForCurrentExercise();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка при загрузке: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private Guid GetEffectiveExerciseId(WorkoutExercise we)
    {
        return exerciseReplacementsInHistory.TryGetValue(we.Id, out var ex) ? ex.Id : we.ExerciseId;
    }

    private Exercise DisplayExercise => currentExercise != null && exerciseReplacementsInHistory.TryGetValue(currentExercise.Id, out var ex)
        ? ex
        : currentExercise!.Exercise;

    private async Task LoadSetsForCurrentExercise()
    {
        if (currentExercise == null)
        {
            return;
        }

        try
        {
            var effectiveExerciseId = GetEffectiveExerciseId(currentExercise);
            var sets = await WorkoutHistorySetService.GetSetsByWorkoutHistoryAndExerciseAsync(WorkoutHistoryId, effectiveExerciseId);
            currentSets = sets?.OrderBy(s => s.SetNumber).ToList() ?? new List<WorkoutHistorySet>();
        }
        catch
        {
            currentSets = new List<WorkoutHistorySet>();
        }
    }

    private async Task PreviousExercise()
    {
        if (currentExerciseIndex > 0)
        {
            currentExerciseIndex--;
            currentExercise = exercises[currentExerciseIndex];
            weightLabel = $"Вес ({DisplayExercise.WeightUnit})";
            if (currentExercise != null)
            {
                var rest = currentExercise.RestSeconds;
                restTimerMinutes = rest / 60;
                restTimerSeconds = rest % 60;
            }
            await SaveExerciseIndex();
            await LoadSetsForCurrentExercise();
            CancelEditing();
        }
    }

    private async Task NextExercise()
    {
        if (currentExerciseIndex < exercises.Count - 1)
        {
            currentExerciseIndex++;
            currentExercise = exercises[currentExerciseIndex];
            weightLabel = $"Вес ({DisplayExercise.WeightUnit})";
            if (currentExercise != null)
            {
                var rest = currentExercise.RestSeconds;
                restTimerMinutes = rest / 60;
                restTimerSeconds = rest % 60;
            }
            await SaveExerciseIndex();
            await LoadSetsForCurrentExercise();
            CancelEditing();
        }
    }

    private async Task AddSet()
    {
        if (currentExercise == null)
        {
            return;
        }

        isAddingSet = true;

        try
        {
            var nextSetNumber = currentSets.Any() ? currentSets.Max(s => s.SetNumber) + 1 : 1;
            var lastSet = currentSets.OrderBy(s => s.SetNumber).LastOrDefault();
            var reps = lastSet?.Reps ?? 0;
            var weight = lastSet?.Weight;

            var createSetDto = new CreateWorkoutHistorySetDto
            {
                WorkoutHistoryId = WorkoutHistoryId,
                ExerciseId = GetEffectiveExerciseId(currentExercise),
                SetNumber = nextSetNumber,
                Reps = reps,
                Weight = weight,
                IsCompleted = false,
                CompletedAt = DateTime.UtcNow
            };

            var createdSet = await WorkoutHistorySetService.CreateSetAsync(createSetDto);
            if (createdSet != null)
            {
                await LoadSetsForCurrentExercise();
            }
            else
            {
                await TelegramHapticService.NotificationErrorAsync();
                Snackbar.Add("Ошибка при добавлении подхода", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            await TelegramHapticService.NotificationErrorAsync();
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
        finally
        {
            isAddingSet = false;
        }
    }

    private void StartEditing(Guid setId, string field, object? value)
    {
        editingSetId = setId;
        editingField = field;

        if (field == "weight" && value is decimal weight)
        {
            editingWeight = weight;
        }
        else if (field == "reps" && value is int reps)
        {
            editingReps = reps;
        }
    }

    private void CancelEditing()
    {
        editingSetId = null;
        editingField = null;
        editingWeight = null;
        editingReps = 0;
    }

    private async Task SaveSet(Guid setId)
    {
        if (currentExercise == null || editingSetId != setId)
        {
            return;
        }

        try
        {
            var set = currentSets.FirstOrDefault(s => s.Id == setId);
            if (set == null)
            {
                return;
            }

            var updateDto = new CreateWorkoutHistorySetDto
            {
                WorkoutHistoryId = WorkoutHistoryId,
                ExerciseId = GetEffectiveExerciseId(currentExercise),
                SetNumber = set.SetNumber,
                Reps = editingField == "reps" ? editingReps : set.Reps,
                Weight = editingField == "weight" ? editingWeight : set.Weight,
                DurationSeconds = set.DurationSeconds,
                DistanceMeters = set.DistanceMeters,
                RestSeconds = set.RestSeconds,
                Notes = set.Notes,
                IsCompleted = set.IsCompleted,
            };

            var success = await WorkoutHistorySetService.UpdateSetAsync(setId, updateDto);
            if (success)
            {
                await LoadSetsForCurrentExercise();
                CancelEditing();
            }
            else
            {
                await TelegramHapticService.NotificationErrorAsync();
                Snackbar.Add("Ошибка при обновлении подхода", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            await TelegramHapticService.NotificationErrorAsync();
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
    }

    private async Task ToggleSetCompletion(Guid setId, bool isCompleted)
    {
        try
        {
            var success = await WorkoutHistorySetService.ToggleSetCompletionAsync(setId, isCompleted);

            if (success)
            {
                await LoadSetsForCurrentExercise();

                if (isCompleted)
                {
                    await TelegramHapticService.NotificationSuccessAsync();

                    int totalSeconds = (restTimerMinutes * 60) + restTimerSeconds;
                    if (totalSeconds > 0)
                    {
                        await OpenRestTimerDialog(totalSeconds);
                    }
                }
            }
            else
            {
                Snackbar.Add("Ошибка при обновлении статуса подхода", Severity.Error);
                await TelegramHapticService.NotificationErrorAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
            await TelegramHapticService.NotificationErrorAsync();
        }
    }

    private async Task DeleteSet(Guid setId)
    {
        try
        {
            var success = await WorkoutHistorySetService.DeleteSetAsync(setId);

            if (success)
            {
                await LoadSetsForCurrentExercise();
            }
