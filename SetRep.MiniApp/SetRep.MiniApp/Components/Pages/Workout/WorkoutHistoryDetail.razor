@page "/workout/history/{WorkoutHistoryId:guid}"
@using SetRep.Core.ApiRequestServices
@using SetRep.Core.Entities
@using SetRep.MiniApp.Client.Services
@using SetRep.MiniApp.Components.Dialog
@using static SetRep.MiniApp.Client.Services.InitializationHelper
@using MudBlazor
@rendermode InteractiveServer
@inject IWorkoutHistoryService WorkoutHistoryService
@inject NavigationManager Navigation
@inject ITelegramBackButtonService TelegramBackButtonService
@inject IAppInitializationService AppInitializationService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<PageTitle>SetRep - Детали тренировки</PageTitle>

@if (isLoading)
{
    <div class="workout-history-detail-container">
        @* Скелетон карточки информации о тренировке *@
        <MudCard Elevation="2" Class="mb-4 workout-info-card">
            <MudCardContent>
                <MudSkeleton Typo="Typo.h5" Width="60%" Height="32px" Class="mb-3" />
                <div class="workout-meta">
                    <MudSkeleton Typo="Typo.body2" Width="70%" Height="20px" Class="mb-1" />
                    <MudSkeleton Typo="Typo.body2" Width="70%" Height="20px" Class="mb-1" />
                    <MudSkeleton Typo="Typo.body2" Width="60%" Height="20px" />
                </div>
            </MudCardContent>
        </MudCard>

        @* Скелетон карточек упражнений *@
        <MudSkeleton Typo="Typo.h6" Width="200px" Height="24px" Class="mb-3" />
        @for (int i = 0; i < 3; i++)
        {
            <MudCard Elevation="2" Class="mb-3 exercise-card">
                <MudCardContent>
                    <MudSkeleton Typo="Typo.h6" Width="50%" Height="24px" Class="mb-3" />
                    @* Скелетон таблицы *@
                    <div class="skeleton-table">
                        <div class="skeleton-table-header">
                            <MudSkeleton Width="30px" Height="20px" />
                            <MudSkeleton Width="50px" Height="20px" />
                            <MudSkeleton Width="60px" Height="20px" />
                        </div>
                        @for (int j = 0; j < 3; j++)
                        {
                            <div class="skeleton-table-row">
                                <MudSkeleton Width="20px" Height="20px" />
                                <MudSkeleton Width="40px" Height="20px" />
                                <MudSkeleton Width="30px" Height="20px" />
                            </div>
                        }
                    </div>
                </MudCardContent>
            </MudCard>
        }
    </div>
}
else if (errorMessage != null)
{
    <div class="workout-history-detail-container">
        <MudCard Elevation="2" Class="error-card">
            <MudCardContent>
                <div class="error-state">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" Class="mb-4" />
                    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-2">
                        Ошибка загрузки
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4">
                        @errorMessage
                    </MudText>
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadWorkoutHistory">
                        Попробовать снова
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    </div>
}
else if (workoutHistory != null)
{
    <div class="workout-history-detail-container">
        <!-- Информация о тренировке -->
        <MudCard Elevation="2" Class="mb-4 workout-info-card">
            <MudCardContent>
                <div class="workout-title-row">
                    <MudText Typo="Typo.h5" Class="mb-3 workout-title">@(workoutHistory.Workout?.Name ?? workoutHistory.WorkoutName ?? "Тренировка")</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                   Color="Color.Error" 
                                   Variant="Variant.Text"
                                   Size="Size.Small"
                                   OnClick="ConfirmDeleteWorkoutHistory"
                                   Class="delete-button" />
                </div>
                
                <div class="workout-meta">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="meta-row">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="meta-icon" />
                        @FormatDate(workoutHistory.StartTime)
                    </MudText>
                    @if (workoutHistory.EndTime.HasValue)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="meta-row">
                            <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" Class="meta-icon" />
                            Длительность: @FormatDuration(workoutHistory.EndTime.Value - workoutHistory.StartTime)
                        </MudText>
                        var volume = CalculateVolume(workoutHistory);

                        @if (volume > 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="meta-row">
                                <MudIcon Icon="@Icons.Material.Filled.Layers" Class="meta-icon" />
                                Объём: @volume.ToString("0") кг
                            </MudText>
                        }
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(workoutHistory.Notes))
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="workout-notes">
                        @workoutHistory.Notes
                    </MudText>
                }
            </MudCardContent>
        </MudCard>

        <!-- Упражнения и подходы -->
        @if (workoutHistory.Sets != null && workoutHistory.Sets.Any())
        {
            <MudText Typo="Typo.h6" Class="mb-3">Выполненные упражнения</MudText>
            
            @foreach (var exerciseGroup in GetOrderedExerciseGroups(workoutHistory))
            {
                var firstSet = exerciseGroup.First();
                var exercise = firstSet.Exercise;
                var sets = exerciseGroup.OrderBy(s => s.SetNumber).ToList();
                var weightUnit = exercise?.WeightUnit ?? "кг";
                
                <MudCard Elevation="2" Class="mb-3 exercise-card">
                    <MudCardContent>
                        <div class="exercise-header">
                            @if (!string.IsNullOrWhiteSpace(exercise.MainImage))
                            {
                                <MudAvatar Size="Size.Medium" Class="exercise-header-image">
                                    <img src="@exercise.MainImage" alt="@exercise.Name" />
                                </MudAvatar>
                            }
                            <div class="exercise-header-content">
                                @if (exercise != null)
                                {
                                    <MudLink Href="@($"/exercises/{exercise.Id}")"
                                             Typo="Typo.h6"
                                             Class="md-3"
                                             Color="Color.Inherit"
                                             Underline="Underline.Hover">
                                        @exercise.Name
                                    </MudLink>
                                }
                                else
                                {
                                    <MudText Typo="Typo.h6" Class="md-3">@(exercise?.Name ?? "Неизвестное упражнение")</MudText>
                                }
                            </div>
                        </div>
                        <MudTable Items="@sets" Hover="true" Dense="true" Class="compact-table" Breakpoint="Breakpoint.None">
                            <HeaderContent>
                                <MudTh>№</MudTh>
                                <MudTh>Вес</MudTh>
                                <MudTh>Повт.</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="№">@context.SetNumber</MudTd>
                                <MudTd DataLabel="Вес">
                                    @if (context.Weight.HasValue)
                                    {
                                        <span>@context.Weight.Value.ToString("0.##") @weightUnit</span>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                                    }
                                </MudTd>
                                <MudTd DataLabel="Повторения">
                                    @if (context.Reps > 0)
                                    {
                                        <span>@context.Reps</span>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudCardContent>
                </MudCard>
            }
        }
        else
        {
            <MudCard Elevation="2" Class="empty-state-card">
                <MudCardContent>
                    <div class="empty-state">
                        <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Large" Color="Color.Secondary" Class="mb-4" />
                        <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-2">
                            Нет данных о подходах
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                            В этой тренировке нет записей о выполненных подходах
                        </MudText>
                    </div>
                </MudCardContent>
            </MudCard>
        }
    </div>
}

<style>
    .exercise-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
    }

    .exercise-header-image {
        flex-shrink: 0;
        border-radius: 50%;
        overflow: hidden;
        margin-bottom: 12px;
    }

        .exercise-header-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .exercise-header-content {
        flex: 1;
    }

    .workout-history-detail-container {
        max-width: 100%;
    }

    .workout-info-card {
        border-radius: 12px;
    }

    .workout-meta {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .workout-notes {
        white-space: pre-wrap;
        word-wrap: break-word;
    }

    .exercise-card {
        border-radius: 12px;
    }

    .compact-table {
        font-size: 0.875rem;
    }

    .compact-table .mud-table-cell {
        padding: 8px 12px;
    }

    .empty-state-card {
        border-radius: 12px;
        margin-top: 16px;
    }

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 24px;
    }

    .loading-card, .error-card {
        border-radius: 12px;
        margin-top: 32px;
    }

    .loading-state, .error-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 24px;
    }

    .skeleton-table {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .skeleton-table-header {
        display: flex;
        gap: 16px;
        padding: 8px 0;
        border-bottom: 1px solid var(--mud-palette-divider);
    }

    .skeleton-table-row {
        display: flex;
        gap: 16px;
        padding: 8px 0;
    }

    .meta-row {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 2px;
    }

    .meta-icon {
        margin: 0;
    }

    .workout-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .workout-title {
        flex: 1;
        margin-bottom: 0 !important;
    }

    .delete-button {
        flex-shrink: 0;
    }
</style>

@code {
    [Parameter] public Guid WorkoutHistoryId { get; set; }

    private WorkoutHistory? workoutHistory;
    private bool isLoading = true;
    private string? errorMessage;
    private bool isDeleting = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await WaitForInitializationAsync(AppInitializationService);
            await TelegramBackButtonService.ShowAsync();
            await LoadWorkoutHistory();
            StateHasChanged();
        }
    }

    private async Task LoadWorkoutHistory()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            workoutHistory = await WorkoutHistoryService.GetWorkoutHistoryDetailsAsync(WorkoutHistoryId);
            if (workoutHistory == null)
            {
                errorMessage = "Тренировка не найдена.";
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Ошибка сети при подключении к API: {ex.Message}. " +
                          "Убедитесь, что API сервер запущен и доступен.";
            workoutHistory = null;
        }
        catch (TaskCanceledException ex) when (ex.InnerException is TimeoutException)
        {
            errorMessage = "Превышено время ожидания ответа от API. Сервер может быть перегружен или недоступен.";
            workoutHistory = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось загрузить тренировку: {ex.Message}";
            workoutHistory = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private string FormatDate(DateTime date)
    {
        var localDate = date.AddHours(3); // UTC+3
        return localDate.ToString("dd MMM yyyy HH:mm");
    }

    private string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalHours >= 1)
        {
            return $"{(int)duration.TotalHours}ч {duration.Minutes}м";
        }
        return $"{duration.Minutes}м {duration.Seconds}с";
    }

    private decimal CalculateVolume(WorkoutHistory workoutHistory)
    {
        if (workoutHistory.Sets == null || !workoutHistory.Sets.Any())
            return 0;

        return workoutHistory.Sets
            .Where(s => s.IsCompleted && s.Weight.HasValue && s.Weight.Value > 0)
            .Sum(s => s.Weight!.Value * s.Reps);
    }

    private IEnumerable<IGrouping<Guid, WorkoutHistorySet>> GetOrderedExerciseGroups(WorkoutHistory workoutHistory)
    {
        if (workoutHistory.Sets == null || !workoutHistory.Sets.Any())
        {
            return Enumerable.Empty<IGrouping<Guid, WorkoutHistorySet>>();
        }

        var groupedSets = workoutHistory.Sets.Where(s => s.IsCompleted).GroupBy(s => s.ExerciseId).ToList();

        if (workoutHistory.Workout?.WorkoutExercises != null && workoutHistory.Workout.WorkoutExercises.Any())
        {
            return groupedSets.OrderBy(g =>
            {
                var exerciseId = g.Key;
                var workoutExercise = workoutHistory.Workout.WorkoutExercises
                    .FirstOrDefault(we => we.ExerciseId == exerciseId);
                return workoutExercise?.Order ?? int.MaxValue;
            }).ThenBy(g => g.Min(s => s.CompletedAt));
        }

        return groupedSets.OrderBy(g => g.Min(s => s.CompletedAt));
    }

    private async Task ConfirmDeleteWorkoutHistory()
    {
        if (workoutHistory == null || isDeleting)
        {
            return;
        }

        var workoutName = workoutHistory.Workout?.Name ?? workoutHistory.WorkoutName ?? "Тренировка";
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { nameof(ConfirmDialog.Title), "Подтверждение удаления" },
            { nameof(ConfirmDialog.ContentText), $"Вы уверены, что хотите удалить тренировку \"{workoutName}\" из истории? Это действие нельзя отменить." },
            { nameof(ConfirmDialog.ButtonText), "Удалить" },
            { nameof(ConfirmDialog.Color), Color.Error }
        };

        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true, 
            MaxWidth = MaxWidth.Small, 
            FullWidth = true 
        };

        var dialogReference = await DialogService.ShowAsync<ConfirmDialog>("Подтверждение удаления", parameters, options);
        var result = await dialogReference.Result;

        if (!result.Canceled)
        {
            await DeleteWorkoutHistory();
        }
    }

    private async Task DeleteWorkoutHistory()
    {
        if (workoutHistory == null || isDeleting)
        {
            return;
        }

        isDeleting = true;
        StateHasChanged();

        try
        {
            var success = await WorkoutHistoryService.DeleteWorkoutHistoryAsync(WorkoutHistoryId);
            if (success)
            {
                Navigation.NavigateTo("/workout/history");
            }
            else
            {
                Snackbar.Add("Ошибка при удалении тренировки", Severity.Error);
                isDeleting = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка при удалении тренировки: {ex.Message}", Severity.Error);
            isDeleting = false;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {

    }
}
