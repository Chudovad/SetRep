@page "/workouts/plans/add"
@using SetRep.Core.ApiRequestServices
@using SetRep.Core.Entities
@using SetRep.MiniApp.Client.Services
@using SetRep.Shared.DTO
@using static SetRep.MiniApp.Client.Services.InitializationHelper
@rendermode InteractiveWebAssembly
@inject IWorkoutPlanService WorkoutPlanService
@inject IUserService UserService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ITelegramBackButtonService TelegramBackButtonService
@inject ITelegramWebAppStateService TelegramWebAppStateService
@inject IAppInitializationService AppInitializationService
@implements IAsyncDisposable

<PageTitle>SetRep - Добавить план тренировки</PageTitle>

<div class="add-workout-plan-container">
    <MudCard Elevation="2" Class="mb-4">
        <MudCardContent>
            <MudForm @ref="form" @bind-IsValid="@isFormValid">
                <MudTextField T="string"
                            Label="Название плана тренировки"
                            @bind-Value="workoutPlanDto.Name"
                            Variant="Variant.Outlined"
                            Placeholder="Например: План на неделю"
                            Required="true"
                            RequiredError="Название обязательно для заполнения"
                            Class="mb-3" />
            </MudForm>
        </MudCardContent>
    </MudCard>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
    }

    <!-- Кнопки действий -->
    <div class="action-buttons">
        <MudStack Row="true">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       FullWidth="true"
                       OnClick="Cancel">
                Отмена
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       OnClick="SaveWorkoutPlan"
                       Disabled="@(!isFormValid || isSaving)">
                @if (isSaving)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Сохранение...</MudText>
                }
                else
                {
                    <MudText>Сохранить</MudText>
                }
            </MudButton>
        </MudStack>
    </div>
</div>

<style>
    .add-workout-plan-container {
        max-width: 100%;
    }

    .action-buttons {
        margin-top: 16px;
    }
</style>

@code {
    private MudForm? form;
    private bool isFormValid;
    private bool isSaving = false;
    private string? errorMessage;

    private CreateWorkoutPlanDto workoutPlanDto = new()
    {
        Name = string.Empty,
        UserId = Guid.Empty,
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await WaitForInitializationAsync(AppInitializationService);
            await TelegramBackButtonService.ShowAsync();
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/workouts");
    }

    private async Task SaveWorkoutPlan()
    {
        await form!.Validate();

        if (!isFormValid || isSaving)
            return;

        isSaving = true;
        errorMessage = null;

        try
        {
            if (workoutPlanDto.UserId == Guid.Empty && TelegramWebAppStateService.ValidationResult?.Data?.User != null)
            {
                var telegramId = TelegramWebAppStateService.ValidationResult.Data.User.TelegramId;
                var user = await UserService.GetUserByTelegramIdAsync(telegramId);

                if (user != null)
                {
                    workoutPlanDto.UserId = user.Id;
                }
                else
                {
                    errorMessage = "Пользователь не найден. Пожалуйста, перезагрузите страницу.";
                    return;
                }
            }

            var createdWorkoutPlan = await WorkoutPlanService.CreateWorkoutPlanAsync(workoutPlanDto);
            if (createdWorkoutPlan == null)
            {
                errorMessage = "Ошибка при создании плана тренировки.";
                return;
            }

            Navigation.NavigateTo("/workouts");
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Ошибка сети: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось создать план тренировки: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        // Cleanup if needed
    }
}
