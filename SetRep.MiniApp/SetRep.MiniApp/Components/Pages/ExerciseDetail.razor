@page "/exercises/{ExerciseId:guid}"
@using SetRep.Core.Entities
@using SetRep.Core.Enums
@using SetRep.Core.Extensions
@using SetRep.MiniApp.Client.Services
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ITelegramBackButtonService TelegramBackButtonService
@implements IAsyncDisposable

<PageTitle>SetRep - @(exercise?.Name ?? "Упражнение")</PageTitle>

@if (isLoading)
{
    <div class="exercise-detail-container">
        <MudCard Elevation="2" Class="loading-card">
            <MudCardContent>
                <div class="loading-state">
                    <MudProgressCircular Indeterminate="true" Size="Size.Large" Class="mb-4" />
                    <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center">
                        Загрузка упражнения...
                    </MudText>
                </div>
            </MudCardContent>
        </MudCard>
    </div>
}
else if (errorMessage != null)
{
    <div class="exercise-detail-container">
        <MudCard Elevation="2" Class="error-card">
            <MudCardContent>
                <div class="error-state">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" Class="mb-4" />
                    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-2">
                        Ошибка загрузки
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4">
                        @errorMessage
                    </MudText>
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadExercise">
                        Попробовать снова
                    </MudButton>
                    <MudButton Variant="Variant.Text" 
                               Color="Color.Primary" 
                               Class="mt-2"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="GoBack">
                        Вернуться к списку
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    </div>
}
else if (exercise != null)
{
    <div class="exercise-detail-container">
        <!-- Картинка упражнения -->
        @if (!string.IsNullOrWhiteSpace(exercise.Image))
        {
            <MudCard Elevation="2" Class="mb-4 exercise-image-card">
                <MudCardContent Class="pa-0">
                    <img src="@exercise.Image" alt="@exercise.Name" class="exercise-image" />
                </MudCardContent>
            </MudCard>
        }
        else
        {
            <MudCard Elevation="2" Class="mb-4 exercise-image-card">
                <MudCardContent>
                    <div class="exercise-image-placeholder">
                        <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Large" Color="Color.Secondary" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mt-2">
                            Изображение отсутствует
                        </MudText>
                    </div>
                </MudCardContent>
            </MudCard>
        }

        <!-- Название и описание -->
        <MudCard Elevation="2" Class="mb-4 exercise-info-card">
            <MudCardContent>
                <MudText Typo="Typo.h4" Class="mb-3">@exercise.Name</MudText>
                
                @if (!string.IsNullOrWhiteSpace(exercise.Description))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="exercise-description">
                        @exercise.Description
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Описание отсутствует
                    </MudText>
                }
                @if (exercise.MuscleGroup.HasValue)
                {
                    <MudChip T="string" Size="Size.Medium" Color="Color.Primary" Variant="Variant.Filled" Style="margin-top: 15px">
                        @exercise.MuscleGroup.Value.GetDescription()
                    </MudChip>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Не указана
                    </MudText>
                }
            </MudCardContent>
        </MudCard>
    </div>
}

<style>
    .exercise-detail-container {
        max-width: 100%;
    }

    .exercise-image-card {
        border-radius: 12px;
        overflow: hidden;
    }

    .exercise-image {
        width: 100%;
        height: auto;
        display: block;
        max-height: 400px;
        object-fit: contain;
        background-color: #f5f5f5;
    }

    .exercise-image-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 48px 24px;
        min-height: 200px;
        background-color: #f5f5f5;
        border-radius: 12px;
    }

    .exercise-info-card, .exercise-muscle-group-card {
        border-radius: 12px;
    }

    .exercise-description {
        white-space: pre-wrap;
        word-wrap: break-word;
    }

    .loading-card, .error-card {
        border-radius: 12px;
        margin-top: 32px;
    }

    .loading-state, .error-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 24px;
    }
</style>

@code {
    [Parameter] public Guid ExerciseId { get; set; }

    private Exercise? exercise;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadExercise();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await TelegramBackButtonService.ShowAsync();
        }
    }

    private async Task LoadExercise()
    {
        isLoading = true;
        errorMessage = null;
        
        try
        {
            var response = await Http.GetAsync($"api/exercises/{ExerciseId}");
            
            if (response.IsSuccessStatusCode)
            {
                exercise = await response.Content.ReadFromJsonAsync<Exercise>();
            }
            else
            {
                var statusCode = (int)response.StatusCode;
                var statusText = response.StatusCode.ToString();
                
                errorMessage = statusCode switch
                {
                    404 => "Упражнение не найдено.",
                    502 => "Сервер API недоступен (Bad Gateway). Убедитесь, что API сервер запущен и доступен.",
                    503 => "Сервис временно недоступен. Попробуйте позже.",
                    401 => "Требуется авторизация для доступа к API.",
                    403 => "Доступ запрещен.",
                    _ => $"Ошибка при загрузке упражнения: {statusText} (код {statusCode})"
                };
                
                exercise = null;
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Ошибка сети при подключении к API: {ex.Message}. " +
                          "Убедитесь, что API сервер запущен и доступен.";
            exercise = null;
        }
        catch (TaskCanceledException ex) when (ex.InnerException is TimeoutException)
        {
            errorMessage = "Превышено время ожидания ответа от API. Сервер может быть перегружен или недоступен.";
            exercise = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось загрузить упражнение: {ex.Message}";
            exercise = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/exercises");
    }

    public async ValueTask DisposeAsync()
    {
        await TelegramBackButtonService.HideAsync();
    }
}
