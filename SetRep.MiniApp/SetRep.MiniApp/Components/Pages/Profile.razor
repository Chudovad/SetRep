@page "/profile"
@rendermode InteractiveServer
@using SetRep.MiniApp.Components.Layout
@using SetRep.MiniApp.Client.Services
@using static SetRep.MiniApp.Client.Services.InitializationHelper
@inject IAppInitializationService AppInitializationService
@inject ITelegramWebAppStateService TelegramWebAppStateService
@inject ITelegramBackButtonService TelegramBackButtonService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>SetRep - Профиль</PageTitle>

<div class="profile-container">
    <!-- Информация о пользователе -->
    <MudCard Elevation="2" Class="mb-4 profile-card">
        <MudCardContent>
            <div class="profile-header">
                <MudAvatar Size="Size.Large" Color="Color.Primary" Class="profile-avatar">
                    @if (string.IsNullOrEmpty(TelegramWebAppStateService.ValidationResult?.Data?.User.PhotoUrl))
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" />
                    }
                    else
                    {
                        <MudImage Src="@TelegramWebAppStateService.ValidationResult?.Data?.User.PhotoUrl" Alt="@TelegramWebAppStateService.ValidationResult?.Data?.User.Username"></MudImage>
                    }
                </MudAvatar>
                <div class="profile-info">
                    <MudStack Row>
                        @if (string.IsNullOrEmpty(TelegramWebAppStateService.ValidationResult?.Data?.User.LastName))
                        {
                            <MudText Typo="Typo.h6">@TelegramWebAppStateService.ValidationResult?.Data?.User.FirstName</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.h6">@TelegramWebAppStateService.ValidationResult?.Data?.User.FirstName @TelegramWebAppStateService.ValidationResult?.Data?.User.LastName</MudText>
                        }
                    </MudStack>
                    @if (!string.IsNullOrEmpty(TelegramWebAppStateService.ValidationResult?.Data?.User.Username))
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@TelegramWebAppStateService.ValidationResult?.Data?.User.Username</MudText>
                    }
                </div>
            </div>
        </MudCardContent>
    </MudCard>

    <!-- Дополнительно -->
    <MudCard Elevation="2" Class="mb-4 settings-card">
        <MudCardContent>
            <MudText Typo="Typo.h6" GutterBottom="true">Дополнительно</MudText>
            <MudButton Variant="Variant.Text"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Assessment"
                       OnClick="NavigateToMeasurements"
                       Class="nav-button">
                Замеры
            </MudButton>
            <MudDivider Class="my-2" />
            <MudButton Variant="Variant.Text"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.History"
                       OnClick="NavigateToWorkoutHistory"
                       Class="nav-button">
                История тренировок
            </MudButton>
            <MudDivider Class="my-2" />
            <MudButton Variant="Variant.Text"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Help"
                       OnClick="NavigateToHelp"
                       Class="nav-button">
                Помощь
            </MudButton>
        </MudCardContent>
    </MudCard>
</div>

<style>
    .profile-container {
        max-width: 100%;
    }

    .profile-card {
        border-radius: 12px;
    }

    .profile-header {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .profile-avatar {
        width: 64px;
        height: 64px;
    }

    .profile-info {
        flex: 1;
    }

    .settings-card {
        border-radius: 12px;
    }

    .nav-button {
        justify-content: flex-start;
        text-transform: none;
        padding: 12px 16px;
    }
</style>

@code {
    private string UserName { get; set; } = "Пользователь";
    private string UserEmail { get; set; } = "user@example.com";
    private string WeightUnit { get; set; } = "kg";

    private void NavigateToMeasurements()
    {
        Navigation.NavigateTo("/measurements");
    }

    private void NavigateToWorkoutHistory()
    {
        Navigation.NavigateTo("/workout/history");
    }

    private async void NavigateToHelp()
    {
        await JSRuntime.InvokeVoidAsync("openTelegramLinkHelper.openTelegramLink", "https://t.me/set_rep_helper");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await WaitForInitializationAsync(AppInitializationService);
            await TelegramBackButtonService.ShowAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {

    }
}

