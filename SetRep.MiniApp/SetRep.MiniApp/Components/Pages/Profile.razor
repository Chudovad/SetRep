@page "/profile"
@rendermode InteractiveServer
@using SetRep.MiniApp.Components.Layout
@using SetRep.MiniApp.Client.Services
@using static SetRep.MiniApp.Client.Services.InitializationHelper
@inject IAppInitializationService AppInitializationService

<PageTitle>SetRep - Профиль</PageTitle>

<div class="profile-container">
    <!-- Информация о пользователе -->
    <MudCard Elevation="2" Class="mb-4 profile-card">
        <MudCardContent>
            <div class="profile-header">
                <MudAvatar Size="Size.Large" Color="Color.Primary" Class="profile-avatar">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" />
                </MudAvatar>
                <div class="profile-info">
                    <MudText Typo="Typo.h6">@UserName</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@UserEmail</MudText>
                </div>
            </div>
        </MudCardContent>
    </MudCard>

    <!-- Цель по весу -->
    <MudCard Elevation="2" Class="mb-4 settings-card">
        <MudCardContent>
            <MudText Typo="Typo.h6" GutterBottom="true">Цель по весу</MudText>
            <MudNumericField T="double" 
                             @bind-Value="TargetWeight" 
                             Label="Целевой вес (кг)" 
                             Variant="Variant.Outlined"
                             Adornment="Adornment.End"
                             AdornmentIcon="@Icons.Material.Filled.Scale"
                             Class="mb-3" />
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       FullWidth="true"
                       OnClick="SaveTargetWeight">
                Сохранить
            </MudButton>
        </MudCardContent>
    </MudCard>

    <!-- Единицы измерения -->
    <MudCard Elevation="2" Class="mb-4 settings-card">
        <MudCardContent>
            <MudText Typo="Typo.h6" GutterBottom="true">Единицы измерения</MudText>
            <MudSelect T="string" 
                       @bind-Value="WeightUnit" 
                       Label="Единица веса" 
                       Variant="Variant.Outlined"
                       Class="mb-3">
                <MudSelectItem T="string" Value="@("kg")">Килограммы (кг)</MudSelectItem>
                <MudSelectItem T="string" Value="@("lb")">Фунты (lb)</MudSelectItem>
            </MudSelect>
        </MudCardContent>
    </MudCard>

    <!-- Дополнительные настройки -->
    <MudCard Elevation="2" Class="mb-4 settings-card">
        <MudCardContent>
            <MudText Typo="Typo.h6" GutterBottom="true">Дополнительно</MudText>
            <MudListItem T="string" Href="exercises" Icon="@Icons.Material.Filled.Notifications" Text="Упражнения" />
            <MudDivider Class="my-2" />
            <MudListItem T="string" Href="/workout/history" Icon="@Icons.Material.Filled.History" Text="История тренировок" />
            <MudDivider Class="my-2" />
            <MudListItem T="string" Href="#" Icon="@Icons.Material.Filled.Help" Text="Помощь" />
            <MudDivider Class="my-2" />
            <MudListItem T="string" Href="#" Icon="@Icons.Material.Filled.Info" Text="О приложении" />
        </MudCardContent>
    </MudCard>
</div>

<style>
    .profile-container {
        max-width: 100%;
    }

    .profile-card {
        border-radius: 12px;
    }

    .profile-header {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .profile-avatar {
        width: 64px;
        height: 64px;
    }

    .profile-info {
        flex: 1;
    }

    .settings-card {
        border-radius: 12px;
    }
</style>

@code {
    private string UserName { get; set; } = "Пользователь";
    private string UserEmail { get; set; } = "user@example.com";
    private double TargetWeight { get; set; } = 70.0;
    private string WeightUnit { get; set; } = "kg";

    private void SaveTargetWeight()
    {
        // TODO: Сохранение цели по весу
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await WaitForInitializationAsync(AppInitializationService);
        }
    }
}

