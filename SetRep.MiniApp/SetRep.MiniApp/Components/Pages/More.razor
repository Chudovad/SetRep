@page "/more"
@rendermode InteractiveServer
@using SetRep.MiniApp.Client.Services
@using static SetRep.MiniApp.Client.Services.InitializationHelper
@inject IAppInitializationService AppInitializationService
@inject ITelegramBackButtonService TelegramBackButtonService
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>SetRep - Ещё</PageTitle>

<MudCard Elevation="2" Class="mb-4 settings-card">
    <MudCardContent>
        <MudText Typo="Typo.h6" GutterBottom="true">Дополнительно</MudText>
        <MudListItem T="string" Href="profile" Icon="@Icons.Material.Filled.Person" Text="Профиль" />
        <MudDivider Class="my-2" />
        <MudListItem T="string" Href="/workout/history" Icon="@Icons.Material.Filled.History" Text="История тренировок" />
        <MudDivider Class="my-2" />
        <MudListItem T="string" Href="https://t.me/Chud0vad" Icon="@Icons.Material.Filled.Help" Text="Помощь" />
        <MudDivider Class="my-2" />
        <MudListItem T="string" Href="#" Icon="@Icons.Material.Filled.Info" Text="О приложении" />
    </MudCardContent>
</MudCard>

<style>
    .more-container {
        max-width: 100%;
    }

    .settings-card {
        border-radius: 12px;
    }

    .nav-item-wrapper {
        cursor: pointer;
    }

    .nav-list-item {
        border-radius: 8px;
        transition: background-color 0.2s ease;
    }

    .nav-item-wrapper:hover .nav-list-item {
        background-color: var(--mud-palette-action-hover);
    }
</style>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await WaitForInitializationAsync(AppInitializationService);
            await TelegramBackButtonService.ShowAsync();
        }
    }

    private void NavigateToProfile()
    {
        Navigation.NavigateTo("/profile");
    }

    private void NavigateToWorkoutHistory()
    {
        Navigation.NavigateTo("/workout/history");
    }

    public async ValueTask DisposeAsync()
    {
        await TelegramBackButtonService.HideAsync();
    }
}

