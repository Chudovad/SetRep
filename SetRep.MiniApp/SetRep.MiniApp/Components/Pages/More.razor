@page "/more"
@rendermode InteractiveServer
@using SetRep.MiniApp.Client.Services
@using static SetRep.MiniApp.Client.Services.InitializationHelper
@inject IAppInitializationService AppInitializationService
@inject ITelegramBackButtonService TelegramBackButtonService
@inject NavigationManager Navigation
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<PageTitle>SetRep - Ещё</PageTitle>

<MudCard Elevation="2" Class="mb-4 settings-card">
    <MudCardContent>
        <MudText Typo="Typo.h6" GutterBottom="true">Дополнительно</MudText>
        <MudButton Variant="Variant.Text" FullWidth="true" StartIcon="@Icons.Material.Filled.Person" OnClick="NavigateToProfile" Class="nav-button">
            Профиль
        </MudButton>
        <MudDivider Class="my-2" />
        <MudButton Variant="Variant.Text" FullWidth="true" StartIcon="@Icons.Material.Filled.History" OnClick="NavigateToWorkoutHistory" Class="nav-button">
            История тренировок
        </MudButton>
        <MudDivider Class="my-2" />
        <MudButton Variant="Variant.Text" FullWidth="true" StartIcon="@Icons.Material.Filled.Help" OnClick="NavigateToHelp" Class="nav-button">
            Помощь
        </MudButton>
    </MudCardContent>
</MudCard>

<style>
    .more-container {
        max-width: 100%;
    }

    .settings-card {
        border-radius: 12px;
    }

    .nav-item-wrapper {
        cursor: pointer;
    }

    .nav-list-item {
        border-radius: 8px;
        transition: background-color 0.2s ease;
    }

    .nav-button {
        justify-content: flex-start;
        text-transform: none;
        padding: 12px 16px;
    }
</style>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await WaitForInitializationAsync(AppInitializationService);
            await TelegramBackButtonService.HideAsync();
        }
    }

    private void NavigateToProfile()
    {
        Navigation.NavigateTo("/profile");
    }

    private void NavigateToWorkoutHistory()
    {
        Navigation.NavigateTo("/workout/history");
    }

    private async void NavigateToHelp()
    {
        await JSRuntime.InvokeVoidAsync("openTelegramLinkHelper.openTelegramLink", "https://t.me/set_rep_helper");
    }

    public async ValueTask DisposeAsync()
    {

    }
}

