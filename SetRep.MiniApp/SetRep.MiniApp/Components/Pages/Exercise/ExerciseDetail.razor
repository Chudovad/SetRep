@page "/exercises/{ExerciseId:guid}"
@using SetRep.Core.ApiRequestServices
@using SetRep.Core.Entities
@using SetRep.Core.Enums
@using SetRep.Core.Extensions
@using SetRep.MiniApp.Client.Services
@using SetRep.MiniApp.Components.Dialog
@using SetRep.Shared.DTO
@using MudBlazor
@using static SetRep.MiniApp.Client.Services.InitializationHelper
@rendermode InteractiveWebAssembly
@inject IExerciseService ExerciseService
@inject IWorkoutService WorkoutService
@inject IWorkoutExerciseService WorkoutExerciseService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ITelegramBackButtonService TelegramBackButtonService
@inject ITelegramHapticService TelegramHapticService
@inject ITelegramWebAppStateService TelegramWebAppStateService
@inject IAppInitializationService AppInitializationService
@implements IAsyncDisposable

<PageTitle>SetRep - @(exercise?.Name ?? "Упражнение")</PageTitle>

@if (isLoading)
{
    <div class="exercise-detail-container">
        @* Скелетон изображения упражнения *@
        <MudCard Elevation="2" Class="mb-4 exercise-image-card">
            <MudCardContent Class="pa-0">
                <MudSkeleton Height="300px" Width="100%" />
            </MudCardContent>
        </MudCard>

        @* Скелетон карточки информации *@
        <MudCard Elevation="2" Class="mb-4 exercise-info-card">
            <MudCardContent>
                <div class="exercise-header">
                    <MudSkeleton Width="70%" Height="32px" />
                    <MudSkeleton Width="40px" Height="40px" SkeletonType="SkeletonType.Circle" />
                </div>
                <MudSkeleton Width="100%" Height="60px" Class="mb-2" />
                <MudSkeleton Width="80%" Height="60px" Class="mb-2" />
                <MudSkeleton Width="120px" Height="32px" Style="margin-top: 15px" />
            </MudCardContent>
        </MudCard>
    </div>
}
else if (errorMessage != null)
{
    <div class="exercise-detail-container">
        <MudCard Elevation="2" Class="error-card">
            <MudCardContent>
                <div class="error-state">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" Class="mb-4" />
                    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-2">
                        Ошибка загрузки
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4">
                        @errorMessage
                    </MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadExercise">
                        Попробовать снова
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               Class="mt-2"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="GoBack">
                        Вернуться к списку
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    </div>
}
else if (exercise != null)
{
    <div class="exercise-detail-container">
        <!-- Картинка упражнения -->
        @if (!string.IsNullOrWhiteSpace(exercise.Image))
        {
            <MudCard Elevation="2" Class="mb-4 exercise-image-card">
                <MudCardContent Class="pa-0">
                    @if (exercise.Image.EndsWith(".mp4"))
                    {
                        <video src="@exercise.Image"
                               autoplay
                               loop
                               playsinline
                               muted
                               class="exercise-video"
                               title="@exercise.Name"></video>
                    }
                    else
                    {
                        <img src="@exercise.Image" alt="@exercise.Name" class="exercise-image" />
                    }
                </MudCardContent>
            </MudCard>
        }
        else if (!string.IsNullOrWhiteSpace(exercise.MainImage))
        {
            <MudCard Elevation="2" Class="mb-4 exercise-image-card">
                <MudCardContent Class="pa-0">
                    <img src="@exercise.MainImage" alt="@exercise.Name" class="exercise-image" />
                </MudCardContent>
            </MudCard>
        }
        else 
        {
            <MudCard Elevation="2" Class="mb-4 exercise-image-card">
                <MudCardContent>
                    <div class="exercise-image-placeholder">
                        <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Large" Color="Color.Secondary" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mt-2">
                            Изображение отсутствует
                        </MudText>
                    </div>
                </MudCardContent>
            </MudCard>
        }

        <!-- Название и описание -->
        <MudCard Elevation="2" Class="mb-4 exercise-info-card">
            <MudCardContent>
                <div class="exercise-header">
                    <MudText Typo="Typo.h5" Class="exercise-title">@exercise.Name</MudText>
                    <div class="exercise-actions">
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                 Color="Color.Default"
                                 AnchorOrigin="Origin.BottomRight"
                                 TransformOrigin="Origin.TopRight"
                                 Variant="Variant.Text"
                                 Size="Size.Medium"
                                 Class="exercise-menu-button"
                                 StopPropagation="true">
                            @if (CanEditExercise)
                            {
                                <MudMenuItem OnClick="OpenEditDialog" Icon="@Icons.Material.Filled.Edit">
                                    Редактировать
                                </MudMenuItem>
                            }
                            <MudMenuItem OnClick="OpenSelectWorkoutDialog" Icon="@Icons.Material.Filled.Add" Disabled="isAddingToWorkout">
                                @(isAddingToWorkout ? "Добавление..." : "Добавить в тренировку")
                            </MudMenuItem>
                            @if (CanEditExercise)
                            {
                                <MudDivider />
                                <MudMenuItem OnClick="OpenDeleteDialog" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Disabled="isDeleting">
                                    @(isDeleting ? "Удаление..." : "Удалить")
                                </MudMenuItem>
                            }
                        </MudMenu>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(exercise.Description))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="exercise-description">
                        @exercise.Description
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Описание отсутствует
                    </MudText>
                }
                @if (exercise.MuscleGroup.HasValue)
                {
                    <MudChip T="string" Size="Size.Medium" Color="Color.Primary" Variant="Variant.Filled" Style="margin-top: 15px">
                        @exercise.MuscleGroup.Value.GetDescription()
                    </MudChip>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Не указана
                    </MudText>
                }
            </MudCardContent>
        </MudCard>

        @if (!string.IsNullOrEmpty(exercise.VideoUrl))
        {
            <MudExpansionPanels Class="mb-4">
                <MudExpansionPanel Text="Как делать упражнение">
                    <video src="@exercise.VideoUrl"
                           loop
                           playsinline
                           muted
                           controls
                           class="exercise-video"
                           title="@exercise.Name"></video>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    </div>
}

<style>
    .exercise-detail-container {
        max-width: 100%;
    }

    .exercise-image {
        max-height: 400px;
    }

    .exercise-video {
        max-height: 400px;
    }

    .exercise-image-placeholder {
        padding: 48px 24px;
        min-height: 200px;
    }

    .exercise-info-card, .exercise-muscle-group-card {
        border-radius: 12px;
    }

    .exercise-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .exercise-title {
        flex: 1;
        margin: 0;
    }

    .exercise-actions {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .exercise-menu-button {
        min-width: 40px;
    }

    .exercise-description {
        white-space: pre-wrap;
        word-wrap: break-word;
    }
</style>

@code {
    [Parameter] public Guid ExerciseId { get; set; }

    private Exercise? exercise;
    private bool isLoading = true;
    private bool isDeleting = false;
    private bool isAddingToWorkout = false;
    private string? errorMessage;

    private bool CanEditExercise
    {
        get
        {
            if (exercise == null || exercise.IsSystem)
                return false;

            // Проверяем, что упражнение создано текущим пользователем
            Guid? currentUserId = null;
            if (TelegramWebAppStateService?.ValidationResult?.Data?.User != null)
            {
                currentUserId = TelegramWebAppStateService.ValidationResult.Data.User.Id;
            }

            return currentUserId.HasValue && exercise.CreatedByUserId == currentUserId.Value;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await WaitForInitializationAsync(AppInitializationService);
            await TelegramBackButtonService.ShowAsync();
            await LoadExercise();
            StateHasChanged();
        }
    }

    private async Task LoadExercise()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            exercise = await ExerciseService.GetExerciseByIdAsync(ExerciseId);
            if (exercise == null)
            {
                errorMessage = "Упражнение не найдено.";
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Ошибка сети при подключении к API: {ex.Message}. " +
                          "Убедитесь, что API сервер запущен и доступен.";
            exercise = null;
        }
        catch (TaskCanceledException ex) when (ex.InnerException is TimeoutException)
        {
            errorMessage = "Превышено время ожидания ответа от API. Сервер может быть перегружен или недоступен.";
            exercise = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось загрузить упражнение: {ex.Message}";
            exercise = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/exercises");
    }

    private async Task OpenEditDialog()
    {
        if (exercise == null)
            return;

        var parameters = new DialogParameters<AddExerciseDialog>
        {
            { nameof(AddExerciseDialog.Exercise), exercise }
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialogReference = await DialogService.ShowAsync<AddExerciseDialog>("Редактировать упражнение", parameters, options);
        var result = await dialogReference.Result;

        if (!result.Canceled)
        {
            await LoadExercise();
        }
    }

    private async Task OpenDeleteDialog()
    {
        if (exercise == null)
            return;

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { nameof(ConfirmDialog.Title), "Подтверждение удаления" },
            { nameof(ConfirmDialog.ContentText), $"Вы уверены, что хотите удалить упражнение \"{exercise.Name}\"? Это действие нельзя отменить." },
            { nameof(ConfirmDialog.ButtonText), "Удалить" },
            { nameof(ConfirmDialog.Color), Color.Error }
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialogReference = await DialogService.ShowAsync<ConfirmDialog>("Подтверждение удаления", parameters, options);
        var result = await dialogReference.Result;

        if (!result.Canceled)
        {
            await DeleteExercise();
        }
    }

    private async Task DeleteExercise()
    {
        if (exercise == null)
            return;

        isDeleting = true;
        StateHasChanged();

        try
        {
            var success = await ExerciseService.DeleteExerciseAsync(exercise.Id);
            if (success)
            {
                Navigation.NavigateTo("/exercises");
            }
            else
            {
                await TelegramHapticService.NotificationErrorAsync();
                Snackbar.Add("Ошибка при удалении упражнения. Проверьте подключение к API.", Severity.Error);
            }
        }
        catch (HttpRequestException ex)
        {
            await TelegramHapticService.NotificationErrorAsync();
            Snackbar.Add($"Ошибка сети: {ex.Message}", Severity.Error);
        }
        catch (Exception ex)
        {
            await TelegramHapticService.NotificationErrorAsync();
            Snackbar.Add($"Не удалось удалить упражнение: {ex.Message}", Severity.Error);
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    private async Task OpenSelectWorkoutDialog()
    {
        if (exercise == null || isAddingToWorkout)
            return;

        var parameters = new DialogParameters<SelectWorkoutDialog>();
        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true, 
            MaxWidth = MaxWidth.Medium, 
            FullWidth = true 
        };

        var dialogReference = await DialogService.ShowAsync<SelectWorkoutDialog>("Выберите тренировку", parameters, options);
        var result = await dialogReference.Result;

        if (!result.Canceled && result.Data is SetRep.Core.Entities.Workout selectedWorkout)
        {
            await AddExerciseToWorkout(selectedWorkout);
        }
    }

    private async Task AddExerciseToWorkout(SetRep.Core.Entities.Workout workout)
    {
        if (exercise == null || workout == null || isAddingToWorkout)
            return;

        isAddingToWorkout = true;
        StateHasChanged();

        try
        {
            // Получаем детали тренировки, чтобы узнать текущий максимальный порядок
            var workoutDetails = await WorkoutService.GetWorkoutDetailsAsync(workout.Id);
            if (workoutDetails == null)
            {
                await TelegramHapticService.NotificationErrorAsync();
                Snackbar.Add("Не удалось загрузить детали тренировки", Severity.Error);
                return;
            }

            // Проверяем, не добавлено ли уже это упражнение в тренировку
            var existingExerciseIds = workoutDetails.WorkoutExercises?
                .Select(we => we.ExerciseId)
                .ToHashSet() ?? new HashSet<Guid>();

            if (existingExerciseIds.Contains(exercise.Id))
            {
                Snackbar.Add($"Упражнение \"{exercise.Name}\" уже добавлено в тренировку \"{workout.Name}\"", Severity.Info);
                return;
            }

            // Определяем порядок для нового упражнения
            int maxOrder = workoutDetails.WorkoutExercises?.Any() == true 
                ? workoutDetails.WorkoutExercises.Max(we => we.Order) + 1 
                : 0;

            var workoutExerciseDto = new CreateWorkoutExerciseDto
            {
                WorkoutId = workout.Id,
                ExerciseId = exercise.Id,
                Order = maxOrder
            };

            var createdWorkoutExercise = await WorkoutExerciseService.CreateWorkoutExerciseAsync(workoutExerciseDto);
            if (createdWorkoutExercise != null)
            {
                Snackbar.Add($"Упражнение успешно добавлено в тренировку \"{workout.Name}\"", Severity.Success);
            }
            else
            {
                await TelegramHapticService.NotificationErrorAsync();
                Snackbar.Add($"Ошибка при добавлении упражнения в тренировку", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            await TelegramHapticService.NotificationErrorAsync();
            Snackbar.Add($"Ошибка при добавлении упражнения в тренировку: {ex.Message}", Severity.Error);
        }
        finally
        {
            isAddingToWorkout = false;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        
    }
}
