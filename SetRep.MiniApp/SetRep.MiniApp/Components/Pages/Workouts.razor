@page "/workouts"
@rendermode InteractiveServer

<PageTitle>SetRep - Тренировки</PageTitle>

<div class="workouts-container">
    @if (WorkoutsItems.Any())
    {
        @foreach (var workout in WorkoutsItems)
        {
            <MudCard Elevation="2" Class="mb-3 workout-item-card">
                <MudCardContent>
                    <div class="workout-item-header">
                        <div class="workout-item-info">
                            <MudText Typo="Typo.h6" Class="mb-1">@workout.Date.ToString("dd MMMM yyyy")</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @workout.ExerciseCount упражнений
                            </MudText>
                        </div>
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">
                            @workout.TotalVolume.ToString("F0") кг
                        </MudChip>
                    </div>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" 
                               Color="Color.Primary" 
                               Size="Size.Small"
                               EndIcon="@Icons.Material.Filled.ChevronRight"
                               OnClick="() => ViewWorkout(workout.Id)">
                        Подробнее
                    </MudButton>
                </MudCardActions>
            </MudCard>
        }
    }
    else
    {
        <MudCard Elevation="2" Class="empty-state-card">
            <MudCardContent>
                <div class="empty-state">
                    <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Large" Color="Color.Secondary" Class="mb-4" />
                    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-2">
                        Нет тренировок
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4">
                        Добавьте первую тренировку, чтобы начать отслеживать прогресс
                    </MudText>
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddWorkout">
                        Добавить тренировку
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
</div>

<style>
    .workouts-container {
        max-width: 100%;
    }

    .workout-item-card {
        border-radius: 12px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .workout-item-card:hover {
        transform: translateY(-2px);
    }

    .workout-item-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
    }

    .workout-item-info {
        flex: 1;
    }

    .empty-state-card {
        border-radius: 12px;
        margin-top: 32px;
    }

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 24px;
    }
</style>

