@page "/exercises/group/{SelectedMuscleGroup:int}"
@using SetRep.Core.ApiRequestServices
@using SetRep.Core.Entities
@using SetRep.Core.Enums
@using SetRep.Core.Extensions
@using SetRep.MiniApp.Client.Services
@using SetRep.MiniApp.Components.Dialog
@using static SetRep.MiniApp.Client.Services.InitializationHelper
@rendermode InteractiveServer
@inject IExerciseService ExerciseService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ITelegramBackButtonService TelegramBackButtonService
@inject ITelegramWebAppStateService TelegramWebAppStateService
@inject IAppInitializationService AppInitializationService
@implements IAsyncDisposable

<PageTitle>SetRep - @GetMuscleGroupName(SelectedMuscleGroup)</PageTitle>

<div class="exercises-container">
    <!-- Заголовок с кнопкой добавления -->
    <div class="d-flex align-center mb-4 header-with-action">
        <MudText Typo="Typo.h5" Class="flex-grow-1 mb-0">
            @GetMuscleGroupName(SelectedMuscleGroup)
        </MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Add" 
                       Color="Color.Primary" 
                       Variant="Variant.Text"
                       OnClick="OpenAddExerciseDialog"
                       Class="add-exercise-icon-btn" />
    </div>
    
    <!-- Поле поиска -->
    <MudTextField @bind-Value="searchQuery"
                  Variant="Variant.Outlined"
                  Placeholder="Поиск упражнений..."
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  IconSize="Size.Medium"
                  Class="mb-4 search-field"
                  Immediate="true">
    </MudTextField>
    
    @if (isLoading)
    {
        @for (int i = 0; i < 4; i++)
        {
            <div class="exercise-card-wrapper">
                <MudCard Elevation="2" Class="mb-3 exercise-item-card">
                    <MudCardContent>
                        <div class="exercise-item-header">
                            <MudSkeleton Width="64px" Height="64px" Variant="SkeletonVariant.Rectangular" Class="exercise-image-skeleton" />
                            <div class="exercise-item-info">
                                <MudSkeleton Typo="Typo.body1" Width="70%" Height="20px" />
                                <MudSkeleton Width="100px" Height="16px" />
                            </div>
                            <MudSkeleton Width="24px" Height="24px" Class="exercise-arrow-skeleton" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </div>
        }
    }
    else if (errorMessage != null)
    {
        <MudCard Elevation="2" Class="error-card">
            <MudCardContent>
                <div class="error-state">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" Class="mb-4" />
                    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-2">
                        Ошибка загрузки
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4">
                        @errorMessage
                    </MudText>
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadExercises">
                        Попробовать снова
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
    else if (filteredExercises.Any())
    {
        @foreach (var exercise in filteredExercises)
        {
            <div @onclick="() => ViewExercise(exercise.Id)" class="exercise-card-wrapper">
                <MudCard Elevation="2" Class="mb-3 exercise-item-card">
                    <MudCardContent>
                        <div class="exercise-item-header">
                            @if (!string.IsNullOrWhiteSpace(exercise.MainImage))
                            {
                                <div class="exercise-image-container">
                                    <img src="@exercise.MainImage" alt="@exercise.Name" class="exercise-image" />
                                </div>
                            }
                            <div class="exercise-item-info @(exercise.IsSystem ? "exercise-item-info-centered" : "") @(string.IsNullOrWhiteSpace(exercise.MainImage) ? "exercise-item-info-no-image" : "")">
                                <MudText Typo="Typo.body1" Class="exercise-name">@exercise.Name</MudText>
                                @if (!exercise.IsSystem)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="exercise-tag">
                                        Пользовательское
                                    </MudChip>
                                }
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" 
                                     Color="Color.Secondary" 
                                     Class="exercise-arrow-icon" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </div>
        }
    }
    else
    {
        <MudCard Elevation="2" Class="empty-state-card">
            <MudCardContent>
                <div class="empty-state">
                    <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Large" Color="Color.Secondary" Class="mb-4" />
                    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-2">
                        @(string.IsNullOrWhiteSpace(searchQuery) ? "Нет упражнений" : "Ничего не найдено")
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                        @(string.IsNullOrWhiteSpace(searchQuery) ? "В этой группе мышц пока нет упражнений" : "Попробуйте изменить запрос")
                    </MudText>
                </div>
            </MudCardContent>
        </MudCard>
    }
</div>

<style>
    .exercises-container {
        max-width: 100%;
    }

    .exercise-card-wrapper {
        cursor: pointer;
    }

    .exercise-item-card {
        border-radius: 12px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .exercise-card-wrapper:hover .exercise-item-card {
        transform: translateY(-2px);
    }

    .exercise-item-card .mud-card-content {
        padding: 0 !important;
        min-height: 64px;
    }

    .exercise-item-header {
        display: flex;
        align-items: stretch;
        gap: 0;
        min-height: 64px;
    }

    .exercise-image-container {
        flex-shrink: 0;
        width: 64px;
        align-self: stretch;
        border-radius: 12px 0 0 12px;
        overflow: hidden;
    }

    .exercise-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .exercise-image-skeleton {
        border-radius: 12px 0 0 12px;
    }

    .exercise-item-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 4px;
        padding: 12px;
    }

    .exercise-item-info-no-image {
        padding-left: 16px;
    }

    .exercise-item-info-centered {
        justify-content: center;
    }

    .exercise-name {
        line-height: 1.4;
        margin: 2px;
    }

    .exercise-tag {
        align-self: flex-start;
        width: fit-content;
        margin: 0;
    }

    .exercise-arrow-icon {
        flex-shrink: 0;
        align-self: center;
        margin-right: 12px;
    }

    .exercise-arrow-skeleton {
        align-self: center;
        margin-right: 12px;
    }

    .empty-state-card {
        border-radius: 12px;
        margin-top: 32px;
    }

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 24px;
    }

    .loading-card, .error-card {
        border-radius: 12px;
        margin-top: 32px;
    }

    .loading-state, .error-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 24px;
    }

    .header-with-action {
        gap: 8px;
    }

    .add-exercise-icon-btn {
        flex-shrink: 0;
    }

    .search-field {
        border-radius: 12px;
    }
</style>

@code {
    [Parameter] public int SelectedMuscleGroup { get; set; }
    
    private List<Exercise> allExercises = new();
    private string searchQuery = string.Empty;
    private bool isLoading = true;
    private string? errorMessage;

    private IEnumerable<Exercise> filteredExercises
    {
        get
        {
            Guid? currentUserId = null;
            if (TelegramWebAppStateService?.ValidationResult?.Data?.User != null)
            {
                currentUserId = TelegramWebAppStateService.ValidationResult.Data.User.Id;
            }

            var muscleGroup = (MuscleGroup)SelectedMuscleGroup;
            var availableExercises = allExercises.Where(e =>
                (e.IsSystem || (currentUserId.HasValue && e.CreatedByUserId == currentUserId.Value)) &&
                e.MuscleGroup.HasValue &&
                e.MuscleGroup.Value == muscleGroup
            );

            var sortedExercises = availableExercises.OrderBy(e => e.IsSystem ? 1 : 0)
                                                   .ThenBy(e => e.Name);

            if (string.IsNullOrWhiteSpace(searchQuery))
                return sortedExercises;

            var query = searchQuery.Trim().ToLowerInvariant();
            return sortedExercises.Where(e =>
                e.Name.ToLowerInvariant().Contains(query) ||
                (!string.IsNullOrWhiteSpace(e.Description) && 
                 e.Description.ToLowerInvariant().Contains(query))
            );
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await WaitForInitializationAsync(AppInitializationService);
            await TelegramBackButtonService.ShowAsync();
            await LoadExercises();
            StateHasChanged();
        }
    }

    private async Task LoadExercises()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var data = await ExerciseService.GetExercisesAsync();
            if (data != null)
            {
                allExercises = data;
            }
            else
            {
                errorMessage = "Не удалось загрузить упражнения. Проверьте подключение к API.";
                allExercises = new List<Exercise>();
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Ошибка сети при подключении к API: {ex.Message}. " +
                          "Убедитесь, что API сервер запущен и доступен.";
            allExercises = new List<Exercise>();
        }
        catch (TaskCanceledException ex) when (ex.InnerException is TimeoutException)
        {
            errorMessage = "Превышено время ожидания ответа от API. Сервер может быть перегружен или недоступен.";
            allExercises = new List<Exercise>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось загрузить упражнения: {ex.Message}";
            allExercises = new List<Exercise>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenAddExerciseDialog()
    {
        var parameters = new DialogParameters<AddExerciseDialog>();
        parameters.Add(x => x.PreselectedMuscleGroup, (MuscleGroup)SelectedMuscleGroup);
        
        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true, 
            MaxWidth = MaxWidth.Small, 
            FullWidth = true 
        };

        var dialogReference = await DialogService.ShowAsync<AddExerciseDialog>("Добавить упражнение", parameters, options);
        var result = await dialogReference.Result;

        if (!result.Canceled && result.Data is Exercise createdExercise)
        {
            allExercises.Insert(0, createdExercise);
            StateHasChanged();
        }
    }

    private void ViewExercise(Guid exerciseId)
    {
        Navigation.NavigateTo($"/exercises/{exerciseId}");
    }

    private string TruncateDescription(string description)
    {
        if (string.IsNullOrWhiteSpace(description))
            return string.Empty;

        const int maxLength = 50;
        if (description.Length <= maxLength)
            return description;

        return description.Substring(0, maxLength) + "...";
    }

    private string GetMuscleGroupName(int muscleGroupId)
    {
        if (Enum.IsDefined(typeof(MuscleGroup), muscleGroupId))
        {
            var muscleGroup = (MuscleGroup)muscleGroupId;
            return muscleGroup.GetDescription();
        }
        return "Неизвестная группа";
    }

    public async ValueTask DisposeAsync()
    {
        
    }
}

