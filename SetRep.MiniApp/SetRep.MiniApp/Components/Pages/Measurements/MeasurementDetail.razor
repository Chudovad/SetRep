@page "/measurements/{Id:guid}"
@using SetRep.Core.ApiRequestServices
@using SetRep.Core.Entities
@using SetRep.MiniApp.Client.Services
@using SetRep.MiniApp.Components.Dialog
@using static SetRep.MiniApp.Client.Services.InitializationHelper
@using MudBlazor
@rendermode InteractiveServer
@inject IMeasurementsHistoryService MeasurementsHistoryService
@inject NavigationManager Navigation
@inject ITelegramBackButtonService TelegramBackButtonService
@inject IAppInitializationService AppInitializationService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<PageTitle>SetRep - Детали измерений</PageTitle>

@if (isLoading)
{
    <div class="measurement-detail-container">
        <MudCard Elevation="2" Class="mb-4 measurement-info-card">
            <MudCardContent>
                <MudSkeleton Typo="Typo.h5" Width="60%" Height="32px" Class="mb-3" />
                <MudSkeleton Typo="Typo.body2" Width="70%" Height="20px" Class="mb-1" />
                <MudSkeleton Typo="Typo.body2" Width="60%" Height="20px" />
            </MudCardContent>
        </MudCard>
        <MudSkeleton Typo="Typo.h6" Width="200px" Height="24px" Class="mb-3" />
        @for (int i = 0; i < 5; i++)
        {
            <MudCard Elevation="2" Class="mb-3">
                <MudCardContent>
                    <MudSkeleton Typo="Typo.body1" Width="50%" Height="20px" />
                </MudCardContent>
            </MudCard>
        }
    </div>
}
else if (errorMessage != null)
{
    <div class="measurement-detail-container">
        <MudCard Elevation="2" Class="error-card">
            <MudCardContent>
                <div class="error-state">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" Class="mb-4" />
                    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-2">
                        Ошибка загрузки
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4">
                        @errorMessage
                    </MudText>
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadMeasurement">
                        Попробовать снова
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    </div>
}
else if (measurement != null)
{
    <div class="measurement-detail-container">
        <!-- Информация о замере -->
        <MudCard Elevation="2" Class="mb-4 measurement-info-card">
            <MudCardContent>
                <div class="measurement-title-row">
                    <MudText Typo="Typo.h5" Class="mb-3 measurement-title">@FormatDate(measurement.Date)</MudText>
                    <div class="action-buttons">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                       Color="Color.Primary" 
                                       Variant="Variant.Text"
                                       Size="Size.Small"
                                       OnClick="EditMeasurement"
                                       Class="action-button" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                       Color="Color.Error" 
                                       Variant="Variant.Text"
                                       Size="Size.Small"
                                       OnClick="ConfirmDeleteMeasurement"
                                       Class="action-button" />
                    </div>
                </div>
                
                @if (!string.IsNullOrEmpty(measurement.ProgressImageUrl))
                {
                    <div class="progress-image-container">
                        <MudImage Src="@measurement.ProgressImageUrl"
                                  Alt="Изображение прогресса"
                                  Height="300"
                                  ObjectFit="ObjectFit.Cover"
                                  Class="progress-image" />
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(measurement.Notes))
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="measurement-notes">
                        @measurement.Notes
                    </MudText>
                }
            </MudCardContent>
        </MudCard>

        <!-- Измерения -->
        <MudText Typo="Typo.h6" Class="mb-3">Измерения</MudText>
        
        <MudCard Elevation="2" Class="mb-3">
            <MudCardContent>
                <div class="measurements-grid">
                    @if (measurement.BodyWeight.HasValue)
                    {
                        <div class="measurement-item">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Масса тела</MudText>
                            <MudText Typo="Typo.h6">@measurement.BodyWeight.Value.ToString("0.0") кг</MudText>
                        </div>
                    }
                    @if (measurement.Waist.HasValue)
                    {
                        <div class="measurement-item">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Талия</MudText>
                            <MudText Typo="Typo.h6">@measurement.Waist.Value.ToString("0.0") см</MudText>
                        </div>
                    }
                    @if (measurement.BodyFatPercentage.HasValue)
                    {
                        <div class="measurement-item">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Содержание жира</MudText>
                            <MudText Typo="Typo.h6">@measurement.BodyFatPercentage.Value.ToString("0.0") %</MudText>
                        </div>
                    }
                    @if (measurement.LeanBodyMass.HasValue)
                    {
                        <div class="measurement-item">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Сухая мышечная масса</MudText>
                            <MudText Typo="Typo.h6">@measurement.LeanBodyMass.Value.ToString("0.0") кг</MudText>
                        </div>
                    }
                    @if (measurement.Neck.HasValue)
                    {
                        <div class="measurement-item">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Шея</MudText>
                            <MudText Typo="Typo.h6">@measurement.Neck.Value.ToString("0.0") см</MudText>
                        </div>
                    }
                    @if (measurement.Shoulder.HasValue)
                    {
                        <div class="measurement-item">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Плечо</MudText>
                            <MudText Typo="Typo.h6">@measurement.Shoulder.Value.ToString("0.0") см</MudText>
                        </div>
                    }
                    @if (measurement.Chest.HasValue)
                    {
                        <div class="measurement-item">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Грудь</MudText>
                            <MudText Typo="Typo.h6">@measurement.Chest.Value.ToString("0.0") см</MudText>
                        </div>
                    }
                    @if (measurement.LeftBicep.HasValue)
                    {
                        <div class="measurement-item">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Левый бицепс</MudText>
                            <MudText Typo="Typo.h6">@measurement.LeftBicep.Value.ToString("0.0") см</MudText>
                        </div>
                    }
                    @if (measurement.RightBicep.HasValue)
                    {
                        <div class="measurement-item">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Правый бицепс</MudText>
                            <MudText Typo="Typo.h6">@measurement.RightBicep.Value.ToString("0.0") см</MudText>
                        </div>
                    }
                    @if (measurement.LeftForearm.HasValue)
                    {
                        <div class="measurement-item">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Левое предплечье</MudText>
                            <MudText Typo="Typo.h6">@measurement.LeftForearm.Value.ToString("0.0") см</MudText>
                        </div>
                    }
                    @if (measurement.RightForearm.HasValue)
                    {
                        <div class="measurement-item">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Правое предплечье</MudText>
                            <MudText Typo="Typo.h6">@measurement.RightForearm.Value.ToString("0.0") см</MudText>
                        </div>
                    }
                    @if (measurement.Buttocks.HasValue)
                    {
                        <div class="measurement-item">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Ягодицы</MudText>
                            <MudText Typo="Typo.h6">@measurement.Buttocks.Value.ToString("0.0") см</MudText>
                        </div>
                    }
                    @if (measurement.LeftThigh.HasValue)
                    {
                        <div class="measurement-item">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Левое бедро</MudText>
                            <MudText Typo="Typo.h6">@measurement.LeftThigh.Value.ToString("0.0") см</MudText>
                        </div>
                    }
                    @if (measurement.RightThigh.HasValue)
                    {
                        <div class="measurement-item">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Правое бедро</MudText>
                            <MudText Typo="Typo.h6">@measurement.RightThigh.Value.ToString("0.0") см</MudText>
                        </div>
                    }
                    @if (measurement.LeftCalf.HasValue)
                    {
                        <div class="measurement-item">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Левая икра</MudText>
                            <MudText Typo="Typo.h6">@measurement.LeftCalf.Value.ToString("0.0") см</MudText>
                        </div>
                    }
                    @if (measurement.RightCalf.HasValue)
                    {
                        <div class="measurement-item">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Правая икра</MudText>
                            <MudText Typo="Typo.h6">@measurement.RightCalf.Value.ToString("0.0") см</MudText>
                        </div>
                    }
                </div>
                
                @if (!HasAnyMeasurements())
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mt-4">
                        Нет данных об измерениях
                    </MudText>
                }
            </MudCardContent>
        </MudCard>
    </div>
}

<style>
    .measurement-detail-container {
        max-width: 100%;
    }

    .measurement-info-card {
        border-radius: 12px;
    }

    .measurement-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .measurement-title {
        flex: 1;
        margin-bottom: 0 !important;
    }

    .action-buttons {
        display: flex;
        gap: 4px;
        flex-shrink: 0;
    }

    .action-button {
        margin: 0;
    }

    .progress-image-container {
        margin: 16px 0;
        border-radius: 8px;
        overflow: hidden;
    }

    .progress-image {
        border-radius: 8px;
    }

    .measurement-notes {
        white-space: pre-wrap;
        word-wrap: break-word;
    }

    .measurements-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 16px;
    }

    .measurement-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 12px;
        background-color: var(--mud-palette-surface);
        border-radius: 8px;
        border: 1px solid var(--mud-palette-divider);
    }

    .error-card {
        border-radius: 12px;
        margin-top: 32px;
    }

    .error-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 24px;
    }

    @@media (max-width: 600px) {
        .measurements-grid {
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 12px;
        }
    }
</style>

@code {
    [Parameter] public Guid Id { get; set; }

    private MeasurementsHistory? measurement;
    private bool isLoading = true;
    private string? errorMessage;
    private bool isDeleting = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await WaitForInitializationAsync(AppInitializationService);
            await TelegramBackButtonService.ShowAsync();
            await LoadMeasurement();
            StateHasChanged();
        }
    }

    private async Task LoadMeasurement()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            measurement = await MeasurementsHistoryService.GetMeasurementsHistoryByIdAsync(Id);
            if (measurement == null)
            {
                errorMessage = "Запись измерений не найдена.";
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Ошибка сети при подключении к API: {ex.Message}. " +
                          "Убедитесь, что API сервер запущен и доступен.";
            measurement = null;
        }
        catch (TaskCanceledException ex) when (ex.InnerException is TimeoutException)
        {
            errorMessage = "Превышено время ожидания ответа от API. Сервер может быть перегружен или недоступен.";
            measurement = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось загрузить запись измерений: {ex.Message}";
            measurement = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private string FormatDate(DateTime date)
    {
        var localDate = date.AddHours(3); // UTC+3
        return localDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"));
    }

    private bool HasAnyMeasurements()
    {
        if (measurement == null)
            return false;

        return measurement.BodyWeight.HasValue ||
               measurement.Waist.HasValue ||
               measurement.BodyFatPercentage.HasValue ||
               measurement.LeanBodyMass.HasValue ||
               measurement.Neck.HasValue ||
               measurement.Shoulder.HasValue ||
               measurement.Chest.HasValue ||
               measurement.LeftBicep.HasValue ||
               measurement.RightBicep.HasValue ||
               measurement.LeftForearm.HasValue ||
               measurement.RightForearm.HasValue ||
               measurement.Buttocks.HasValue ||
               measurement.LeftThigh.HasValue ||
               measurement.RightThigh.HasValue ||
               measurement.LeftCalf.HasValue ||
               measurement.RightCalf.HasValue;
    }

    private void EditMeasurement()
    {
        Navigation.NavigateTo($"/measurements/{Id}/edit");
    }

    private async Task ConfirmDeleteMeasurement()
    {
        if (measurement == null || isDeleting)
        {
            return;
        }

        var dateStr = FormatDate(measurement.Date);
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { nameof(ConfirmDialog.Title), "Подтверждение удаления" },
            { nameof(ConfirmDialog.ContentText), $"Вы уверены, что хотите удалить запись измерений от {dateStr}? Это действие нельзя отменить." },
            { nameof(ConfirmDialog.ButtonText), "Удалить" },
            { nameof(ConfirmDialog.Color), Color.Error }
        };

        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true, 
            MaxWidth = MaxWidth.Small, 
            FullWidth = true 
        };

        var dialogReference = await DialogService.ShowAsync<ConfirmDialog>("Подтверждение удаления", parameters, options);
        var result = await dialogReference.Result;

        if (!result.Canceled)
        {
            await DeleteMeasurement();
        }
    }

    private async Task DeleteMeasurement()
    {
        if (measurement == null || isDeleting)
        {
            return;
        }

        isDeleting = true;
        StateHasChanged();

        try
        {
            var success = await MeasurementsHistoryService.DeleteMeasurementsHistoryAsync(Id);
            if (success)
            {
                Snackbar.Add("Запись измерений успешно удалена", Severity.Success);
                Navigation.NavigateTo("/measurements");
            }
            else
            {
                Snackbar.Add("Ошибка при удалении записи измерений", Severity.Error);
                isDeleting = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка при удалении записи измерений: {ex.Message}", Severity.Error);
            isDeleting = false;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {

    }
}
