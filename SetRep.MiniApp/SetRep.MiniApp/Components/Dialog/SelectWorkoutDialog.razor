@using SetRep.Core.Entities
@using SetRep.MiniApp.Client.Services

@inject IWorkoutService WorkoutService
@inject ITelegramWebAppStateService TelegramWebAppStateService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Выберите тренировку</MudText>
    </TitleContent>
    <DialogContent>
        @if (isLoading)
        {
            <div class="loading-container">
                <MudProgressCircular Indeterminate="true" Size="Size.Medium" Class="mb-3" />
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                    Загрузка тренировок...
                </MudText>
            </div>
        }
        else if (errorMessage != null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@errorMessage</MudAlert>
        }
        else if (availableWorkouts.Any())
        {
            <!-- Поле поиска -->
            <MudTextField @bind-Value="searchQuery"
                          Variant="Variant.Outlined"
                          Placeholder="Поиск тренировок..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Class="mb-3 search-field"
                          Immediate="true" />
            
            @if (filteredWorkouts.Any())
            {
                <MudList T="Guid"
                         SelectedValue="selectedWorkoutId"
                         SelectedValueChanged="OnSelectedWorkoutChanged"
                         SelectionMode="SelectionMode.SingleSelection"
                         Dense="true"
                         Class="workout-list">
                    @foreach (var workout in filteredWorkouts)
                    {
                        <MudListItem @key="workout.Id" Value="@workout.Id">
                            <div class="workout-item">
                                <MudText Typo="Typo.body1" Class="workout-name">@workout.Name</MudText>
                                @if (!string.IsNullOrWhiteSpace(workout.Notes))
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="workout-notes">
                                        @TruncateNotes(workout.Notes)
                                    </MudText>
                                }
                            </div>
                        </MudListItem>
                    }
                </MudList>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="py-4">
                    @if (!string.IsNullOrWhiteSpace(searchQuery))
                    {
                        <text>Ничего не найдено по запросу "@searchQuery"</text>
                    }
                    else
                    {
                        <text>Нет доступных тренировок</text>
                    }
                </MudText>
            }
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="py-4">
                Нет доступных тренировок. Создайте тренировку, чтобы добавить упражнение.
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel"
                   Variant="Variant.Text">
            Отмена
        </MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="AddToWorkout"
                   Disabled="@(selectedWorkoutId == Guid.Empty || isAdding)">
            @if (isAdding)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Добавление...</MudText>
            }
            else
            {
                <MudText>Добавить</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 24px;
    }

    .workout-list {
        max-height: 400px;
        overflow-y: auto;
    }

    .workout-item {
        flex: 1;
    }

    .workout-name {
        font-weight: 500;
    }

    .workout-notes {
        margin-top: 4px;
        opacity: 0.7;
    }

    .search-field {
        border-radius: 8px;
    }
</style>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }

    private List<Workout> availableWorkouts = new();
    private string searchQuery = string.Empty;
    private Guid selectedWorkoutId = Guid.Empty;
    private bool isLoading = true;
    private bool isAdding = false;
    private string? errorMessage;

    private IEnumerable<Workout> filteredWorkouts
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchQuery))
                return availableWorkouts;

            var query = searchQuery.Trim().ToLowerInvariant();
            return availableWorkouts.Where(w =>
                w.Name.ToLowerInvariant().Contains(query) ||
                (!string.IsNullOrWhiteSpace(w.Notes) && 
                 w.Notes.ToLowerInvariant().Contains(query))
            );
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkouts();
    }

    private async Task LoadWorkouts()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            Guid userId = Guid.Empty;
            if (TelegramWebAppStateService?.ValidationResult?.Data?.User != null)
            {
                userId = TelegramWebAppStateService.ValidationResult.Data.User.Id;
            }

            if (userId == Guid.Empty)
            {
                errorMessage = "Не удалось определить пользователя";
                isLoading = false;
                return;
            }

            var data = await WorkoutService.GetWorkoutsAsync(userId);
            if (data != null)
            {
                availableWorkouts = data;
            }
            else
            {
                errorMessage = "Не удалось загрузить тренировки. Проверьте подключение к API.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось загрузить тренировки: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnSelectedWorkoutChanged(Guid workoutId)
    {
        selectedWorkoutId = workoutId;
        StateHasChanged();
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }

    private void AddToWorkout()
    {
        if (selectedWorkoutId == Guid.Empty || isAdding)
            return;

        var selectedWorkout = availableWorkouts.FirstOrDefault(w => w.Id == selectedWorkoutId);
        if (selectedWorkout != null)
        {
            MudDialog?.Close(DialogResult.Ok(selectedWorkout));
        }
    }

    private string TruncateNotes(string notes)
    {
        if (string.IsNullOrWhiteSpace(notes))
            return string.Empty;

        const int maxLength = 50;
        if (notes.Length <= maxLength)
            return notes;

        return notes.Substring(0, maxLength) + "...";
    }
}
