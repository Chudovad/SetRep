@using System
@using System.Linq
@using SetRep.Core.ApiRequestServices
@using SetRep.Core.Entities
@using SetRep.Core.Enums
@using SetRep.Core.Extensions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Options
@using SetRep.MiniApp.Options

@inject IExerciseService ExerciseService
@inject IFileUploadService FileUploadService
@inject ISnackbar Snackbar
@inject ILogger<EditExerciseDialog>? Logger
@inject IOptions<FileUploadOptions> FileUploadOptionsAccessor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Редактировать упражнение</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@isFormValid">
            <MudTextField T="string"
                          Label="Название упражнения"
                          @bind-Value="exercise.Name"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Название обязательно для заполнения"
                          Class="mb-3" />

            <MudTextField T="string"
                          Label="Описание"
                          @bind-Value="exercise.Description"
                          Variant="Variant.Outlined"
                          Lines="3"
                          Class="mb-3" />

            <MudSelect T="MuscleGroup ?"
                       Label="Группа мышц"
                       @bind-Value="exercise.MuscleGroup"
                       Variant="Variant.Outlined"
                       AnchorOrigin="Origin.BottomCenter"
                       Class="mb-3">
                @foreach (var muscleGroup in Enum.GetValues<MuscleGroup>())
                {
                    <MudSelectItem T="MuscleGroup ?" Value="@muscleGroup">@muscleGroup.GetDescription()</MudSelectItem>
                }
            </MudSelect>

            <MudFileUpload T="IBrowserFile"
                           Accept="image/*"
                           MaxFileSize="@maxFileSize"
                           FilesChanged="OnMainImageFileChanged"
                           Class="mb-3">
                <ActivatorContent>
                    <MudButton HtmlTag="label"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.CloudUpload">
                        @if (string.IsNullOrEmpty(mainImagePreviewUrl))
                        {
                            <text>Загрузить изображение</text>
                        }
                        else
                        {
                            <text>Заменить изображение</text>
                        }
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
            @if (!string.IsNullOrEmpty(mainImagePreviewUrl))
            {
                <div class="mb-3">
                    <MudImage Src="@mainImagePreviewUrl"
                              Alt="Главная картинка упражнения"
                              Width="150"
                              Height="150"
                              ObjectFit="ObjectFit.Cover"
                              Class="border rounded" />
                </div>
            }

        </MudForm>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Отмена</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Save"
                   Disabled="@(!isFormValid || isSaving)">
            @if (isSaving)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Сохранение...</MudText>
            }
            else
            {
                <MudText>Сохранить</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public Exercise Exercise { get; set; } = null!;

    private MudForm? form;
    private bool isFormValid;
    private bool isSaving = false;
    private bool isUploadingImage = false;
    private bool isUploadingMainImage = false;
    private string? errorMessage;
    private IBrowserFile? selectedMainImageFile;
    private Exercise exercise = null!;
    private string? mainImagePreviewUrl;
    private long maxFileSize;

    protected override void OnInitialized()
    {
        maxFileSize = FileUploadOptionsAccessor.Value.MaxFileSizeBytes;

        exercise = new Exercise
        {
            Id = Exercise.Id,
            Name = Exercise.Name,
            Image = Exercise.Image ?? string.Empty,
            MainImage = Exercise.MainImage,
            Description = Exercise.Description,
            MuscleGroup = Exercise.MuscleGroup,
            WeightUnit = Exercise.WeightUnit,
            IsSystem = Exercise.IsSystem,
            CreatedByUserId = Exercise.CreatedByUserId,
            CreatedAt = Exercise.CreatedAt,
            UpdatedAt = Exercise.UpdatedAt
        };

        mainImagePreviewUrl = exercise.MainImage;
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }

    private async Task OnMainImageFileChanged(IBrowserFile file)
    {
        selectedMainImageFile = file;
        mainImagePreviewUrl = await CreateImagePreviewUrlAsync(file);
        StateHasChanged();
    }

    private async Task OnMainImageFileRemoved()
    {
        selectedMainImageFile = null;
        exercise.MainImage = null;
        mainImagePreviewUrl = null;
        await Task.CompletedTask;
    }

    private async Task<string> CreateImagePreviewUrlAsync(IBrowserFile file)
    {
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: maxFileSize);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var imageBytes = memoryStream.ToArray();
            var base64String = Convert.ToBase64String(imageBytes);
            var contentType = file.ContentType ?? "image/jpeg";
            return $"data:{contentType};base64,{base64String}";
        }
        catch (Exception ex)
        {
            Logger?.LogError(ex, "Ошибка при создании preview изображения");
            return string.Empty;
        }
    }

    private async Task UploadImageAsync(IBrowserFile file, bool isMainImage)
    {
        if (file == null) return;

        // Проверка размера файла
        if (file.Size > maxFileSize)
        {
            var maxSizeMB = maxFileSize / 1024.0 / 1024.0;
            Snackbar.Add($"Размер файла превышает {maxSizeMB:F1} МБ", Severity.Error);
            return;
        }

        try
        {
            if (isMainImage)
            {
                isUploadingMainImage = true;
            }
            else
            {
                isUploadingImage = true;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: maxFileSize);
            var contentType = file.ContentType ?? "image/jpeg";
            var url = await FileUploadService.UploadImageAsync(stream, file.Name, contentType);

            if (!string.IsNullOrEmpty(url))
            {
                if (isMainImage)
                {
                    exercise.MainImage = url;
                    mainImagePreviewUrl = url;
                }
                else
                {
                    exercise.Image = url;
                }
            }
            else
            {
                Snackbar.Add("Ошибка при загрузке изображения", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка при загрузке изображения: {ex.Message}", Severity.Error);
        }
        finally
        {
            if (isMainImage)
            {
                isUploadingMainImage = false;
            }
            else
            {
                isUploadingImage = false;
            }
            StateHasChanged();
        }
    }

    private async Task Save()
    {
        await form!.Validate();

        if (!isFormValid || isSaving)
            return;

        isSaving = true;
        errorMessage = null;

        try
        {
            await UploadImageAsync(selectedMainImageFile!, isMainImage: true);

            exercise.UpdatedAt = DateTime.UtcNow;

            var success = await ExerciseService.UpdateExerciseAsync(exercise);
            if (success)
            {
                MudDialog?.Close(DialogResult.Ok(exercise));
            }
            else
            {
                errorMessage = "Ошибка при обновлении упражнения. Проверьте подключение к API.";
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Ошибка сети: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось обновить упражнение: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
