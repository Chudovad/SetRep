@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1">@ContentText</MudText>
        @if (ShowUpdateWorkoutTemplateCheckbox)
        {
            <MudCheckBox T="bool"
                         Class="mt-3"
                         Color="Color.Primary"
                         Value="_updateWorkoutTemplate"
                         ValueChanged="OnUpdateWorkoutTemplateChanged">
                Обновить подходы и веса в шаблоне тренировки
            </MudCheckBox>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Отмена</MudButton>
        <MudButton Color="@Color" 
                   Variant="Variant.Filled" 
                   OnClick="Confirm">
            @ButtonText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }
    
    [Parameter] public string Title { get; set; } = "Подтверждение";
    [Parameter] public string ContentText { get; set; } = string.Empty;
    [Parameter] public string ButtonText { get; set; } = "Подтвердить";
    [Parameter] public Color Color { get; set; } = Color.Primary;
    [Parameter] public bool ShowUpdateWorkoutTemplateCheckbox { get; set; }

    private bool _updateWorkoutTemplate = true;

    private void OnUpdateWorkoutTemplateChanged(bool value)
    {
        _updateWorkoutTemplate = value;
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }

    private void Confirm()
    {
        var data = ShowUpdateWorkoutTemplateCheckbox ? _updateWorkoutTemplate : true;
        MudDialog?.Close(DialogResult.Ok(data));
    }
}
