@using System
@using System.Linq
@using SetRep.Core.ApiRequestServices
@using SetRep.Core.Entities
@using SetRep.Core.Enums
@using SetRep.Core.Extensions
@using Microsoft.AspNetCore.Components.Forms

@inject ITelegramWebAppStateService TelegramWebAppStateService
@inject IExerciseService ExerciseService
@inject IFileUploadService FileUploadService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Добавить упражнение</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@isFormValid">
            <MudTextField T="string"
                          Label="Название упражнения"
                          @bind-Value="exercise.Name"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Название обязательно для заполнения"
                          Class="mb-3" />

            <MudFileUpload T="IBrowserFile" 
                          Accept="image/*"
                          MaxFileSize="1048576"
                          FilesChanged="OnImageFileChanged"
                          Class="mb-3">
                <ActivatorContent>
                    <MudButton HtmlTag="label" 
                              Variant="Variant.Outlined" 
                              Color="Color.Primary" 
                              StartIcon="@Icons.Material.Filled.CloudUpload">
                        Загрузить изображение
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
            @if (!string.IsNullOrEmpty(exercise.Image))
            {
                <div class="mb-3">
                    <MudImage Src="@exercise.Image" 
                             Alt="Изображение упражнения" 
                             Width="150" 
                             Height="150" 
                             ObjectFit="ObjectFit.Cover"
                             Class="border rounded" />
                </div>
            }

            <MudFileUpload T="IBrowserFile" 
                          Accept="image/*"
                          MaxFileSize="1048576"
                          FilesChanged="OnMainImageFileChanged"
                          Class="mb-3">
                <ActivatorContent>
                    <MudButton HtmlTag="label" 
                              Variant="Variant.Outlined" 
                              Color="Color.Primary" 
                              StartIcon="@Icons.Material.Filled.CloudUpload">
                        Загрузить главную картинку
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
            @if (!string.IsNullOrEmpty(exercise.MainImage))
            {
                <div class="mb-3">
                    <MudImage Src="@exercise.MainImage" 
                             Alt="Главная картинка упражнения" 
                             Width="150" 
                             Height="150" 
                             ObjectFit="ObjectFit.Cover"
                             Class="border rounded" />
                </div>
            }
            
            <MudTextField T="string" 
                         Label="Описание" 
                         @bind-Value="exercise.Description"
                         Variant="Variant.Outlined"
                         Lines="3"
                         Class="mb-3" />

            <MudSelect T="MuscleGroup?"
                       Label="Группа мышц"
                       @bind-Value="exercise.MuscleGroup"
                       Variant="Variant.Outlined"
                       AnchorOrigin="Origin.BottomCenter"
                       Class="mb-3">
                <MudSelectItem T="MuscleGroup?" Value="@((MuscleGroup?)null)">Не выбрано</MudSelectItem>
                @foreach (var muscleGroup in Enum.GetValues<MuscleGroup>())
                {
                    <MudSelectItem T="MuscleGroup?" Value="@muscleGroup">@muscleGroup.GetDescription()</MudSelectItem>
                }
            </MudSelect>
            
            <MudSelect T="string" 
                      Label="Единица измерения веса" 
                      @bind-Value="exercise.WeightUnit"
                      Variant="Variant.Outlined"
                      AnchorOrigin="Origin.BottomCenter"
                      Class="mb-3">
                <MudSelectItem Value="@("кг")">кг</MudSelectItem>
                <MudSelectItem Value="@("lbs")">lbs</MudSelectItem>
            </MudSelect>
        </MudForm>
        
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Отмена</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="Save"
                   Disabled="@(!isFormValid || isSaving)">
            @if (isSaving)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Сохранение...</MudText>
            }
            else
            {
                <MudText>Сохранить</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public MuscleGroup? PreselectedMuscleGroup { get; set; }

    private MudForm? form;
    private bool isFormValid;
    private bool isSaving = false;
    private bool isUploadingImage = false;
    private bool isUploadingMainImage = false;
    private string? errorMessage;
    private IBrowserFile? selectedImageFile;
    private IBrowserFile? selectedMainImageFile;

    private Exercise exercise = new()
    {
        Name = string.Empty,
        Image = string.Empty,
        MainImage = null,
        Description = null,
        MuscleGroup = null,
        WeightUnit = "кг",
        IsSystem = false
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (PreselectedMuscleGroup.HasValue)
        {
            exercise.MuscleGroup = PreselectedMuscleGroup.Value;
        }
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }

    private async Task OnImageFileChanged(IBrowserFile file)
    {
        selectedImageFile = file;
        await UploadImageAsync(file, isMainImage: false);
    }

    private async Task OnMainImageFileChanged(IBrowserFile file)
    {
        selectedMainImageFile = file;
        await UploadImageAsync(file, isMainImage: true);
    }

    private async Task OnImageFileRemoved()
    {
        selectedImageFile = null;
        exercise.Image = string.Empty;
        await Task.CompletedTask;
    }

    private async Task OnMainImageFileRemoved()
    {
        selectedMainImageFile = null;
        exercise.MainImage = null;
        await Task.CompletedTask;
    }

    private async Task UploadImageAsync(IBrowserFile file, bool isMainImage)
    {
        if (file == null) return;

        // Проверка размера файла (1 МБ)
        if (file.Size > 1048576)
        {
            Snackbar.Add("Размер файла превышает 1 МБ", Severity.Error);
            return;
        }

        try
        {
            if (isMainImage)
            {
                isUploadingMainImage = true;
            }
            else
            {
                isUploadingImage = true;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: 1048576);
            var contentType = file.ContentType ?? "image/jpeg";
            var url = await FileUploadService.UploadImageAsync(stream, file.Name, contentType);

            if (!string.IsNullOrEmpty(url))
            {
                if (isMainImage)
                {
                    exercise.MainImage = url;
                }
                else
                {
                    exercise.Image = url;
                }
                Snackbar.Add("Изображение успешно загружено", Severity.Success);
            }
            else
            {
                Snackbar.Add("Ошибка при загрузке изображения", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка при загрузке изображения: {ex.Message}", Severity.Error);
        }
        finally
        {
            if (isMainImage)
            {
                isUploadingMainImage = false;
            }
            else
            {
                isUploadingImage = false;
            }
            StateHasChanged();
        }
    }

    private async Task Save()
    {
        await form!.Validate();

        if (!isFormValid || isSaving)
            return;

        isSaving = true;
        errorMessage = null;

        try
        {
            if (exercise.Id == Guid.Empty)
            {
                exercise.Id = Guid.NewGuid();
            }
            exercise.CreatedAt = DateTime.UtcNow;

            if (TelegramWebAppStateService.ValidationResult?.Data?.User != null)
            {
                exercise.CreatedByUserId = TelegramWebAppStateService.ValidationResult.Data.User.Id;
            }

            var createdExercise = await ExerciseService.CreateExerciseAsync(exercise);
            if (createdExercise != null)
            {
                MudDialog?.Close(DialogResult.Ok(createdExercise));
            }
            else
            {
                errorMessage = "Ошибка при создании упражнения. Проверьте подключение к API.";
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Ошибка сети: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось создать упражнение: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}

