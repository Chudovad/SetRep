@using System
@using System.Linq
@using SetRep.Core.ApiRequestServices
@using SetRep.Core.Entities
@using SetRep.Core.Enums
@using SetRep.Core.Extensions

@inject ITelegramWebAppStateService TelegramWebAppStateService
@inject IExerciseService ExerciseService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Добавить упражнение</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@isFormValid">
            <MudTextField T="string"
                          Label="Название упражнения"
                          @bind-Value="exercise.Name"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Название обязательно для заполнения"
                          Class="mb-3" />

            <MudTextField T="string" 
                         Label="Ссылка на изображение" 
                         @bind-Value="exercise.Image"
                         Variant="Variant.Outlined"
                         Class="mb-3" />

            <MudTextField T="string" 
                         Label="Главная картинка (для карточек)" 
                         @bind-Value="exercise.MainImage"
                         Variant="Variant.Outlined"
                         Class="mb-3" />
            
            <MudTextField T="string" 
                         Label="Описание" 
                         @bind-Value="exercise.Description"
                         Variant="Variant.Outlined"
                         Lines="3"
                         Class="mb-3" />

            <MudSelect T="MuscleGroup?"
                       Label="Группа мышц"
                       @bind-Value="exercise.MuscleGroup"
                       Variant="Variant.Outlined"
                       AnchorOrigin="Origin.BottomCenter"
                       Class="mb-3">
                <MudSelectItem T="MuscleGroup?" Value="@((MuscleGroup?)null)">Не выбрано</MudSelectItem>
                @foreach (var muscleGroup in Enum.GetValues<MuscleGroup>())
                {
                    <MudSelectItem T="MuscleGroup?" Value="@muscleGroup">@muscleGroup.GetDescription()</MudSelectItem>
                }
            </MudSelect>
            
            <MudSelect T="string" 
                      Label="Единица измерения веса" 
                      @bind-Value="exercise.WeightUnit"
                      Variant="Variant.Outlined"
                      AnchorOrigin="Origin.BottomCenter"
                      Class="mb-3">
                <MudSelectItem Value="@("кг")">кг</MudSelectItem>
                <MudSelectItem Value="@("lbs")">lbs</MudSelectItem>
            </MudSelect>
        </MudForm>
        
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Отмена</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="Save"
                   Disabled="@(!isFormValid || isSaving)">
            @if (isSaving)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Сохранение...</MudText>
            }
            else
            {
                <MudText>Сохранить</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public MuscleGroup? PreselectedMuscleGroup { get; set; }

    private MudForm? form;
    private bool isFormValid;
    private bool isSaving = false;
    private string? errorMessage;

    private Exercise exercise = new()
    {
        Name = string.Empty,
        Image = string.Empty,
        MainImage = null,
        Description = null,
        MuscleGroup = null,
        WeightUnit = "кг",
        IsSystem = false
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (PreselectedMuscleGroup.HasValue)
        {
            exercise.MuscleGroup = PreselectedMuscleGroup.Value;
        }
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }

    private async Task Save()
    {
        await form!.Validate();

        if (!isFormValid || isSaving)
            return;

        isSaving = true;
        errorMessage = null;

        try
        {
            if (exercise.Id == Guid.Empty)
            {
                exercise.Id = Guid.NewGuid();
            }
            exercise.CreatedAt = DateTime.UtcNow;

            if (TelegramWebAppStateService.ValidationResult?.Data?.User != null)
            {
                exercise.CreatedByUserId = TelegramWebAppStateService.ValidationResult.Data.User.Id;
            }

            var createdExercise = await ExerciseService.CreateExerciseAsync(exercise);
            if (createdExercise != null)
            {
                MudDialog?.Close(DialogResult.Ok(createdExercise));
            }
            else
            {
                errorMessage = "Ошибка при создании упражнения. Проверьте подключение к API.";
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Ошибка сети: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось создать упражнение: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}

