@using MudBlazor

<MudCard Elevation="2" Class="mb-4">
    <MudCardContent>      
        <MudStack Row AlignItems="AlignItems.Center">
            <MudNumericField T="decimal?"
                             Value="@Weight"
                             ValueChanged="@HandleWeightChanged"
                             Label="@WeightLabel"
                             Variant="Variant.Outlined"
                             Min="0"
                             Step="@((decimal?)WeightStep)" />
            <MudNumericField T="int"
                             Value="@Reps"
                             ValueChanged="@HandleRepsChanged"
                             Label="Повторения"
                             Variant="Variant.Outlined"
                             Min="0"
                             Step="1" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="OnAddSet"
                       Disabled="IsAddingSet || Reps <= 0"
                       Size="Size.Small"
                       Style="height: 56px;">
                <MudIcon Icon="@Icons.Material.Filled.Add" />
            </MudButton>
        </MudStack>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public string WeightLabel { get; set; } = "Вес (кг)";
    [Parameter] public decimal? Weight { get; set; }
    [Parameter] public EventCallback<decimal?> WeightChanged { get; set; }
    [Parameter] public int Reps { get; set; }
    [Parameter] public EventCallback<int> RepsChanged { get; set; }
    [Parameter] public bool IsAddingSet { get; set; }
    [Parameter] public EventCallback OnAddSet { get; set; }
    [Parameter] public decimal WeightStep { get; set; } = 0.5m;

    private async Task HandleWeightChanged(decimal? value)
    {
        Weight = value;
        await WeightChanged.InvokeAsync(value);
    }

    private async Task HandleRepsChanged(int value)
    {
        Reps = value;
        await RepsChanged.InvokeAsync(value);
    }
}
