@namespace SetRep.MiniApp.Components.ImageUpload
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Options
@using SetRep.MiniApp.Options
@using SetRep.MiniApp.Services

@inject IOptions<FileUploadOptions> FileUploadOptionsAccessor
@inject ILogger<ImageUpload>? Logger
@inject IImageConversionService? ImageConversionService

<MudFileUpload T="IBrowserFile"
               Accept="image/*"
               MaxFileSize="@_effectiveMaxFileSize"
               FilesChanged="OnFileChanged"
               Class="@Class">
    <ActivatorContent>
        <MudButton HtmlTag="label"
                   Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@UploadIcon"
                   FullWidth="@FullWidth">
            @if (string.IsNullOrEmpty(DisplayUrl))
            {
                @UploadLabel
            }
            else
            {
                @ReplaceLabel
            }
        </MudButton>
    </ActivatorContent>
</MudFileUpload>
@if (!string.IsNullOrEmpty(DisplayUrl))
{
    <div class="@PreviewWrapperClass">
        <MudImage Src="@DisplayUrl"
                  Alt="@ImageAlt"
                  Fluid="true"
                  ObjectFit="ObjectFit.Cover"
                  Class="border rounded" />
        <MudButton Variant="Variant.Text"
                   Color="Color.Error"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Delete"
                   OnClick="OnRemoveClick"
                   Class="mt-2">
            @RemoveLabel
        </MudButton>
    </div>
}

@code {
    /// <summary>Текущий URL изображения (например, с бэкенда). Отображается как превью, если нет выбранного файла.</summary>
    [Parameter] public string? ImageUrl { get; set; }

    /// <summary>Максимальный размер файла в байтах. По умолчанию из FileUploadOptions.</summary>
    [Parameter] public long? MaxFileSize { get; set; }

    [Parameter] public string UploadLabel { get; set; } = "Загрузить изображение";
    [Parameter] public string ReplaceLabel { get; set; } = "Заменить изображение";
    [Parameter] public string RemoveLabel { get; set; } = "Удалить изображение";
    [Parameter] public string ImageAlt { get; set; } = "Изображение";
    [Parameter] public string UploadIcon { get; set; } = Icons.Material.Filled.CloudUpload;
    [Parameter] public bool FullWidth { get; set; }
    [Parameter] public string Class { get; set; } = "mb-3";
    [Parameter] public string PreviewWrapperClass { get; set; } = "mb-3";

    /// <summary>Вызывается перед установкой нового файла (например, для удаления старого из хранилища).</summary>
    [Parameter] public EventCallback OnBeforeFileSelected { get; set; }

    [Parameter] public EventCallback<IBrowserFile> OnFileSelected { get; set; }
    [Parameter] public EventCallback OnRemoveRequested { get; set; }

    private string? _localPreviewDataUrl;
    private long _effectiveMaxFileSize;

    private string? DisplayUrl => _localPreviewDataUrl ?? ImageUrl;

    protected override void OnInitialized()
    {
        _effectiveMaxFileSize = MaxFileSize ?? FileUploadOptionsAccessor.Value.MaxFileSizeBytes;
    }

    protected override void OnParametersSet()
    {
        if (MaxFileSize.HasValue)
            _effectiveMaxFileSize = MaxFileSize.Value;
        else
            _effectiveMaxFileSize = FileUploadOptionsAccessor.Value.MaxFileSizeBytes;
    }

    private async Task OnFileChanged(IBrowserFile file)
    {
        await OnBeforeFileSelected.InvokeAsync();

        IBrowserFile fileToSend = file;
        if (ImageConversionService != null && ImageConversionService.IsHeicFormat(file))
        {
            var convertedStream = await ImageConversionService.ConvertToJpegIfNeededAsync(file);
            if (convertedStream != null)
            {
                try
                {
                    var jpegFileName = Path.ChangeExtension(file.Name, ".jpg") ?? file.Name + ".jpg";
                    fileToSend = await StreamToBrowserFileAsync(convertedStream, jpegFileName, file.LastModified);
                }
                finally
                {
                    await convertedStream.DisposeAsync();
                }
            }
        }

        _localPreviewDataUrl = await CreatePreviewDataUrlAsync(fileToSend);
        await OnFileSelected.InvokeAsync(fileToSend);
        StateHasChanged();
    }

    private static async Task<IBrowserFile> StreamToBrowserFileAsync(Stream stream, string fileName, DateTimeOffset lastModified)
    {
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var bytes = ms.ToArray();
        return new StreamBrowserFile(bytes, fileName, "image/jpeg", lastModified);
    }

    private async Task OnRemoveClick()
    {
        _localPreviewDataUrl = null;
        await OnRemoveRequested.InvokeAsync();
        StateHasChanged();
    }

    private async Task<string> CreatePreviewDataUrlAsync(IBrowserFile file)
    {
        try
        {
            string contentType = "image/jpeg";

            // Проверяем, нужно ли конвертировать HEIC/HEIF файл
            if (ImageConversionService != null && ImageConversionService.IsHeicFormat(file))
            {
                // Конвертируем HEIC в JPEG
                var convertedStream = await ImageConversionService.ConvertToJpegIfNeededAsync(file);
                if (convertedStream != null)
                {
                    using (convertedStream)
                    {
                        using var memoryStream = new MemoryStream();
                        await convertedStream.CopyToAsync(memoryStream);
                        var base64String = Convert.ToBase64String(memoryStream.ToArray());
                        return $"data:{contentType};base64,{base64String}";
                    }
                }
            }

            // Если конвертация не была выполнена или не требуется, используем исходный файл
            using var stream = file.OpenReadStream(maxAllowedSize: _effectiveMaxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            contentType = file.ContentType ?? "image/jpeg";
            return $"data:{contentType};base64,{base64}";
        }
        catch (Exception ex)
        {
            Logger?.LogError(ex, "Ошибка при создании превью изображения");
            return string.Empty;
        }
    }

    private sealed class StreamBrowserFile : IBrowserFile
    {
        private readonly byte[] _data;

        public StreamBrowserFile(byte[] data, string name, string contentType, DateTimeOffset lastModified)
        {
            _data = data;
            Name = name;
            LastModified = lastModified;
            Size = data.Length;
            ContentType = contentType;
        }

        public string Name { get; }
        public DateTimeOffset LastModified { get; }
        public long Size { get; }
        public string ContentType { get; }

        public Stream OpenReadStream(long maxAllowedSize = 512000, CancellationToken cancellationToken = default)
        {
            if (_data.Length > maxAllowedSize)
                throw new InvalidOperationException($"Размер файла ({_data.Length}) превышает допустимый ({maxAllowedSize}).");
            return new MemoryStream(_data, writable: false);
        }
    }
}
