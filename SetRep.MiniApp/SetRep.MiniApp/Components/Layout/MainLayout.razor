@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<MainLayout>? Logger

<TelegramWebAppInitializer />
<AppInitializationOverlay />
<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout Class="mobile-layout">
    <MudMainContent Class="mobile-content">
        <MudSwipeArea OnSwipeEnd="@HandleSwipe" Class="swipe-area-container">
            <CascadingValue Value="this" Name="MainLayout">
                @Body
            </CascadingValue>
        </MudSwipeArea>
    </MudMainContent>
    <NavMenu />
</MudLayout>

<style>
    .mobile-layout {
        max-width: 420px;
        margin: 0 auto;
        height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--mud-palette-background);
    }

    .mobile-content {
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 16px;
        padding-bottom: 95px;
        min-height: calc(100vh - 79px);
        position: relative;
        -webkit-overflow-scrolling: touch;
    }

    .swipe-area-container {
        width: 100%;
        min-height: 100%;
        position: relative;
        touch-action: pan-y pinch-zoom;
        pointer-events: auto;
        overflow: visible;
    }

    @@media (max-width: 420px) {
        .mobile-layout {
            max-width: 100%;
        }
    }
</style>

@code {

    [Parameter] public string PageTitle { get; set; } = "SetRep";

    private bool _isDarkMode = true;
    private MudTheme? _theme = null;
    private DotNetObjectReference<MainLayout>? _dotNetRef;

    public bool IsDarkMode => _isDarkMode;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties()
            {
                DefaultBorderRadius = "8px",
                DrawerWidthLeft = "280px",
                DrawerWidthRight = "280px",
                AppbarHeight = "48px"
            }
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await InitializeTelegramTheme();
            await DisableVerticalSwipes();
        }
    }

    private async Task InitializeTelegramTheme()
    {
        try
        {
            var startTime = DateTime.UtcNow;
            var timeout = TimeSpan.FromSeconds(3);

            while (DateTime.UtcNow - startTime < timeout)
            {
                try
                {
                    var isReady = await JSRuntime.InvokeAsync<bool>("telegramThemeHelper.isReady");

                    if (isReady)
                    {
                        var theme = await JSRuntime.InvokeAsync<string>("telegramThemeHelper.getTheme");
                        Logger?.LogInformation("Загружена тема Telegram: {Theme}", theme);

                        _isDarkMode = theme == "dark";
                        StateHasChanged();

                        await JSRuntime.InvokeVoidAsync("telegramThemeHelper.setThemeCallback", _dotNetRef);

                        return;
                    }
                }
                catch (Exception ex)
                {
                    Logger?.LogDebug(ex, "Ожидание загрузки веб-приложения Telegram...");
                }

                await Task.Delay(100);
            }

            Logger?.LogWarning("Веб-приложение Telegram не загрузилось вовремя из-за использования темы по умолчанию");
            _isDarkMode = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger?.LogError(ex, "Ошибка при инициализации темы Telegram");
            _isDarkMode = true;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnTelegramThemeChanged(string theme)
    {
        Logger?.LogInformation("Тема изменена на: {Theme}", theme);
        _isDarkMode = theme == "dark";
        StateHasChanged();
    }

    private async Task DisableVerticalSwipes()
    {
        try
        {
            var startTime = DateTime.UtcNow;
            var timeout = TimeSpan.FromSeconds(3);

            while (DateTime.UtcNow - startTime < timeout)
            {
                try
                {
                    var isReady = await JSRuntime.InvokeAsync<bool>("telegramSwipeHelper.isReady");

                    if (isReady)
                    {
                        await JSRuntime.InvokeVoidAsync("telegramSwipeHelper.disableVerticalSwipes");
                        Logger?.LogInformation("Вертикальные свайпы отключены");
                        return;
                    }
                }
                catch (Exception ex)
                {
                    Logger?.LogDebug(ex, "Ожидание загрузки веб-приложения Telegram для отключения свайпов...");
                }

                await Task.Delay(100);
            }

            Logger?.LogWarning("Не удалось отключить вертикальные свайпы: веб-приложение Telegram не загрузилось вовремя");
        }
        catch (Exception ex)
        {
            Logger?.LogError(ex, "Ошибка при отключении вертикальных свайпов");
        }
    }

    private async Task HandleSwipe(SwipeEventArgs e)
    {
        if (e.SwipeDirection == SwipeDirection.LeftToRight)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("navigationHelper.goBack");
                Logger?.LogInformation("Выполнен переход на предыдущую страницу по свайпу");
            }
            catch (Exception ex)
            {
                Logger?.LogError(ex, "Ошибка при переходе на предыдущую страницу");
            }
        }
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Primary = "#6750A4",
        Secondary = "#625B71",
        Tertiary = "#7D5260",
        Surface = "#FFFFFF",
        Background = "#FEFBFF",
        AppbarBackground = "rgba(255,255,255,0.9)",
        AppbarText = "#1C1B1F",
        DrawerBackground = "#FFFFFF",
        DrawerText = "#1C1B1F",
        DrawerIcon = "#49454F",
        Success = "#4CAF50",
        Warning = "#FF9800",
        Error = "#BA1A1A",
        Info = "#2196F3",
        TextPrimary = "#1C1B1F",
        TextSecondary = "#49454F",
        LinesDefault = "#E7E0EC",
        Divider = "#E7E0EC",
        OverlayLight = "rgba(28,27,31,0.4)"
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#D0BCFF",
        Secondary = "#CCC2DC",
        Tertiary = "#EFB8C8",
        Surface = "#1C1B1F",
        Background = "#141218",
        AppbarBackground = "rgba(28,27,31,0.9)",
        AppbarText = "#E6E1E5",
        DrawerBackground = "#1C1B1F",
        DrawerText = "#E6E1E5",
        DrawerIcon = "#CAC4D0",
        Success = "#66BB6A",
        Warning = "#FFB74D",
        Error = "#EF5350",
        Info = "#42A5F5",
        TextPrimary = "#E6E1E5",
        TextSecondary = "#CAC4D0",
        LinesDefault = "#938F99",
        Divider = "#938F99",
        OverlayLight = "rgba(230,225,229,0.4)"
    };
}