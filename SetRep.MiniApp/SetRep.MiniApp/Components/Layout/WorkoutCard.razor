@using SetRep.Core.Entities
@using SetRep.MiniApp.Components.Dialog

<div class="workout-card-wrapper @GetWrapperClass()" 
     @onclick="OnViewWorkout"
     @onclick:stopPropagation="true">
    <MudCard Elevation="2" Class="@GetCardClass()">
        <MudCardContent>
            <div class="workout-item-header">
                <div class="workout-item-info">
                    <MudText Typo="Typo.h6">
                        @Workout.Name
                    </MudText>
                </div>
                <div class="workout-item-right" @onclick:stopPropagation="true">
                    @if (IsActive)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Circle"
                                 Color="Color.Info"
                                 Class="active-indicator" />
                    }
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                             Color="Color.Default"
                             AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight"
                             Variant="Variant.Text"
                             Size="Size.Medium"
                             Class="workout-menu-button"
                             StopPropagation="true">
                        <MudMenuItem OnClick="HandleEdit" Icon="@Icons.Material.Filled.Edit">
                            Редактировать
                        </MudMenuItem>
                        <MudMenuItem OnClick="HandleDuplicate" Icon="@Icons.Material.Filled.ContentCopy">
                            Дублировать
                        </MudMenuItem>
                        <MudDivider />
                        <MudMenuItem OnClick="HandleAddToPlan" Icon="@Icons.Material.Filled.List">
                            Добавить в план
                        </MudMenuItem>
                        <MudDivider />
                        <MudMenuItem OnClick="HandleDelete" Icon="@Icons.Material.Filled.Delete" Color="Color.Error">
                            Удалить
                        </MudMenuItem>
                    </MudMenu>
                </div>
            </div>
        </MudCardContent>
    </MudCard>
</div>

<style>
    .workout-card-wrapper {
        cursor: pointer;
        margin-bottom: 8px;
    }

    .workout-item-card {
        border-radius: 12px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .workout-item-card .mud-card-content {
        padding: 2px 16px !important;
    }

    .active-workout-card {
        border: 2px solid var(--mud-palette-primary);
    }

    .workout-card-wrapper:hover .workout-item-card:not(.active-workout-card) {
        transform: translateY(-2px);
    }

    .active-workout-wrapper:hover .active-workout-card {
        transform: translateY(-2px);
    }

    .workout-item-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 2px;
    }

    .workout-item-info {
        flex: 1;
    }

    .workout-item-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .active-indicator {
        width: 12px;
        height: 12px;
    }
</style>

@code {
    [Parameter] public Workout Workout { get; set; } = null!;
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public EventCallback<Workout> OnView { get; set; }
    [Parameter] public EventCallback<Workout> OnEdit { get; set; }
    [Parameter] public EventCallback<Workout> OnDuplicate { get; set; }
    [Parameter] public EventCallback<Workout> OnAddToPlan { get; set; }
    [Parameter] public EventCallback<Workout> OnDelete { get; set; }

    private string GetWrapperClass()
    {
        return IsActive ? "active-workout-wrapper" : "";
    }

    private string GetCardClass()
    {
        return IsActive ? "mb-2 workout-item-card active-workout-card" : "mb-2 workout-item-card";
    }

    private void OnViewWorkout()
    {
        OnView.InvokeAsync(Workout);
    }

    private void HandleEdit()
    {
        OnEdit.InvokeAsync(Workout);
    }

    private void HandleDuplicate()
    {
        OnDuplicate.InvokeAsync(Workout);
    }

    private void HandleAddToPlan()
    {
        OnAddToPlan.InvokeAsync(Workout);
    }

    private void HandleDelete()
    {
        OnDelete.InvokeAsync(Workout);
    }
}
