@inject NavigationManager Navigation
@implements IDisposable

<MudPaper Elevation="3" Class="mobile-bottom-nav">
    <MudButton Variant="Variant.Text" Class="@GetNavItemClass("/", true)" OnClick="@(() => NavigateTo("/"))" FullWidth="true">
        <div class="nav-content">
            <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Medium" Class="nav-icon" />
            <MudText Typo="Typo.caption" Class="nav-label">Главная</MudText>
        </div>
    </MudButton>
    <MudButton Variant="Variant.Text" Class="@GetNavItemClass("/workouts", false)" OnClick="@(() => NavigateTo("/workouts"))" FullWidth="true">
        <div class="nav-content">
            <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Medium" Class="nav-icon" />
            <MudText Typo="Typo.caption" Class="nav-label">Тренировки</MudText>
        </div>
    </MudButton>
    <MudButton Variant="Variant.Text" Class="@GetNavItemClass("/exercises", false)" OnClick="@(() => NavigateTo("/exercises"))" FullWidth="true">
        <div class="nav-content">
            <MudIcon Icon="@Icons.Material.Filled.List" Size="Size.Medium" Class="nav-icon" />
            <MudText Typo="Typo.caption" Class="nav-label">Упражнения</MudText>
        </div>
    </MudButton>
    @* <MudButton Variant="Variant.Text" Class="@GetNavItemClass("/statistics", false)" OnClick="@(() => NavigateTo("/statistics"))" FullWidth="true">
        <div class="nav-content">
            <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Medium" Class="nav-icon" />
            <MudText Typo="Typo.caption" Class="nav-label">Статистика</MudText>
        </div>
    </MudButton> *@
    <MudButton Variant="Variant.Text" Class="@GetNavItemClass("/more", false)" OnClick="@(() => NavigateTo("/more"))" FullWidth="true">
        <div class="nav-content">
            <MudIcon Icon="@Icons.Material.Filled.MoreVert" Size="Size.Medium" Class="nav-icon" />
            <MudText Typo="Typo.caption" Class="nav-label">Ещё</MudText>
        </div>
    </MudButton>
</MudPaper>

<style>
    .mobile-bottom-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        z-index: 1000;
        display: flex;
        justify-content: space-around;
        align-items: center;
        padding: 0;
        padding-bottom: 15px;
        background: var(--mud-palette-surface);
        border-top: 1px solid var(--mud-palette-divider);
        box-shadow: 0 -2px 8px rgba(0,0,0,0.1);
        height: 79px;
    }

    .nav-item {
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        color: var(--mud-palette-text-secondary);
        transition: color 0.2s ease;
        border-radius: 0;
        flex: 1;
        height: 100%;
        padding: 0;
        min-width: 0;
        text-transform: none;
    }

    .nav-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;
        padding: 8px 4px;
    }

    .nav-item:hover {
        color: var(--mud-palette-primary);
    }

    .nav-item-active {
        color: var(--mud-palette-primary);
    }

        .nav-item-active .nav-icon {
            color: var(--mud-palette-primary);
        }

    .nav-icon {
        font-size: 24px;
    }

    .nav-label {
        font-size: 0.7rem;
        text-align: center;
        white-space: nowrap;
        line-height: 1.2;
        font-weight: 400;
    }

    @@media (max-width: 420px) {
        .nav-label {
            font-size: 0.65rem;
        }
    }
</style>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private void NavigateTo(string route)
    {
        Navigation.NavigateTo(route);
    }

    private string GetNavItemClass(string route, bool exactMatch)
    {
        var currentUri = Navigation.ToBaseRelativePath(Navigation.Uri);
        var routePath = route.TrimStart('/');
        
        bool isActive;
        if (exactMatch)
        {
            isActive = currentUri == routePath || (string.IsNullOrEmpty(routePath) && string.IsNullOrEmpty(currentUri));
        }
        else
        {
            isActive = !string.IsNullOrEmpty(routePath) && currentUri.StartsWith(routePath, StringComparison.OrdinalIgnoreCase);
        }

        return isActive ? "nav-item nav-item-active" : "nav-item";
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}