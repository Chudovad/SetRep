@page "/statistics"
@using static SetRep.MiniApp.Client.Services.InitializationHelper
@inject IAppInitializationService AppInitializationService
@inject ITelegramBackButtonService TelegramBackButtonService

<PageTitle>SetRep - Статистика</PageTitle>

<div class="statistics-container">
    <!-- Статистика веса -->
    <MudCard Elevation="2" Class="mb-4 stat-card">
        <MudCardContent>
            <div class="stat-header">
                <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Size="Size.Large" Color="Color.Primary" />
                <div class="stat-content">
                    <MudText Typo="Typo.h6" GutterBottom="true">Прогресс веса</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">За последние 4 недели</MudText>
                    <div class="stat-values">
                        @foreach (var weight in WeightHistory)
                        {
                            <div class="stat-value-item">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@weight.Week</MudText>
                                <MudText Typo="Typo.body1" Class="font-weight-bold">@weight.Value.ToString("F1") кг</MudText>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </MudCardContent>
    </MudCard>

    <!-- Статистика объёма работы -->
    <MudCard Elevation="2" Class="mb-4 stat-card">
        <MudCardContent>
            <div class="stat-header">
                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Large" Color="Color.Success" />
                <div class="stat-content">
                    <MudText Typo="Typo.h6" GutterBottom="true">Объём работы</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">За последние 4 недели</MudText>
                    <div class="stat-values">
                        @foreach (var volume in VolumeHistory)
                        {
                            <div class="stat-value-item">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@volume.Week</MudText>
                                <MudText Typo="Typo.body1" Class="font-weight-bold">@volume.Value кг</MudText>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </MudCardContent>
    </MudCard>

    <!-- Статистика подходов -->
    <MudCard Elevation="2" Class="mb-4 stat-card">
        <MudCardContent>
            <div class="stat-header">
                <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Large" Color="Color.Info" />
                <div class="stat-content">
                    <MudText Typo="Typo.h6" GutterBottom="true">Количество подходов</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">За последние 4 недели</MudText>
                    <div class="stat-values">
                        @foreach (var sets in SetsHistory)
                        {
                            <div class="stat-value-item">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@sets.Week</MudText>
                                <MudText Typo="Typo.body1" Class="font-weight-bold">@sets.Value</MudText>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </MudCardContent>
    </MudCard>

    <!-- Общая статистика -->
    <MudCard Elevation="2" Class="mb-4 summary-card">
        <MudCardContent>
            <MudText Typo="Typo.h6" GutterBottom="true">Общая статистика</MudText>
            <div class="summary-grid">
                <div class="summary-item">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Всего тренировок</MudText>
                    <MudText Typo="Typo.h5" Class="mt-1">@TotalWorkouts</MudText>
                </div>
                <div class="summary-item">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Средний объём</MudText>
                    <MudText Typo="Typo.h5" Class="mt-1">@AverageVolume.ToString("F0") кг</MudText>
                </div>
                <div class="summary-item">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Тренировок в неделю</MudText>
                    <MudText Typo="Typo.h5" Class="mt-1">@WorkoutsPerWeek.ToString("F1")</MudText>
                </div>
            </div>
        </MudCardContent>
    </MudCard>
</div>

<style>
    .statistics-container {
        max-width: 100%;
    }

    .stat-card {
        border-radius: 12px;
    }

    .stat-header {
        display: flex;
        align-items: flex-start;
        gap: 16px;
    }

    .stat-content {
        flex: 1;
    }

    .stat-values {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        margin-top: 12px;
    }

    .stat-value-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 8px;
        background: var(--mud-palette-surface);
        border-radius: 8px;
    }

    .summary-card {
        border-radius: 12px;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-top: 16px;
    }

    .summary-item {
        text-align: center;
    }

    @@media (max-width: 360px) {
        .stat-values {
            grid-template-columns: 1fr;
        }
        
        .summary-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private List<StatValue> WeightHistory { get; set; } = new()
    {
        new StatValue { Week = "Неделя 1", Value = 75.0 },
        new StatValue { Week = "Неделя 2", Value = 75.2 },
        new StatValue { Week = "Неделя 3", Value = 74.8 },
        new StatValue { Week = "Неделя 4", Value = 74.5 }
    };

    private List<StatValue> VolumeHistory { get; set; } = new()
    {
        new StatValue { Week = "Неделя 1", Value = 1200 },
        new StatValue { Week = "Неделя 2", Value = 1350 },
        new StatValue { Week = "Неделя 3", Value = 1420 },
        new StatValue { Week = "Неделя 4", Value = 1500 }
    };

    private List<StatValue> SetsHistory { get; set; } = new()
    {
        new StatValue { Week = "Неделя 1", Value = 15 },
        new StatValue { Week = "Неделя 2", Value = 18 },
        new StatValue { Week = "Неделя 3", Value = 20 },
        new StatValue { Week = "Неделя 4", Value = 22 }
    };

    private int TotalWorkouts { get; set; } = 24;
    private double AverageVolume { get; set; } = 1350;
    private double WorkoutsPerWeek { get; set; } = 3.5;

    private class StatValue
    {
        public string Week { get; set; } = string.Empty;
        public double Value { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await WaitForInitializationAsync(AppInitializationService);
            await TelegramBackButtonService.HideAsync();
        }
    }
}

