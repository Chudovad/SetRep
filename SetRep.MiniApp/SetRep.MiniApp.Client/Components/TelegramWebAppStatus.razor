@using SetRep.MiniApp.Client.Services
@using SetRep.Shared.Telegram
@rendermode InteractiveServer

@inject ITelegramWebAppStateService TelegramWebAppStateService
@inject ILogger<TelegramWebAppStatus> Logger
@implements IAsyncDisposable

<MudCard Elevation="2" Class="ma-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Telegram WebApp Status</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if (TelegramWebAppStateService.ValidationResult == null)
        {
            <MudProgressLinear Color="Color.Info" Indeterminate="true" Class="mb-4" />
            <MudText Typo="Typo.body2">Проверка данных...</MudText>
        }
        else if (TelegramWebAppStateService.ValidationResult.IsValid)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">
                <MudText Typo="Typo.body1" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-2" />
                    Данные успешно валидированы
                </MudText>
                @if (TelegramWebAppStateService.ValidationResult.Data?.User != null)
                {
                    <MudText Typo="Typo.body2" Class="mt-2">
                        <strong>Пользователь:</strong> @TelegramWebAppStateService.ValidationResult.Data.User.FirstName
                        @if (!string.IsNullOrEmpty(TelegramWebAppStateService.ValidationResult.Data.User.LastName))
                        {
                            <text> @TelegramWebAppStateService.ValidationResult.Data.User.LastName</text>
                        }
                    </MudText>
                    @if (!string.IsNullOrEmpty(TelegramWebAppStateService.ValidationResult.Data.User.Username))
                    {
                        <MudText Typo="Typo.body2">
                            <strong>Username:</strong> @@@TelegramWebAppStateService.ValidationResult.Data.User.Username
                        </MudText>
                    }
                    <MudText Typo="Typo.body2">
                        <strong>ID:</strong> @TelegramWebAppStateService.ValidationResult.Data.User.Id
                    </MudText>
                }
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                <MudText Typo="Typo.body1" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Small" Class="mr-2" />
                    Ошибка валидации
                </MudText>
                <MudText Typo="Typo.body2">
                    @TelegramWebAppStateService.ValidationResult.ErrorMessage
                </MudText>
            </MudAlert>
        }
    </MudCardContent>
</MudCard>

@code {
    protected override void OnInitialized()
    {
        // Подписываемся на изменения статуса валидации
        TelegramWebAppStateService.ValidationResultChanged += OnValidationResultChanged;
    }

    private void OnValidationResultChanged()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        TelegramWebAppStateService.ValidationResultChanged -= OnValidationResultChanged;

        await Task.CompletedTask;
    }
}

