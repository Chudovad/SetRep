@using SetRep.MiniApp.Client.Services
@using SetRep.Shared.Telegram
@using MudBlazor
@inject ITelegramWebAppStateService TelegramWebAppStateService
@inject IAppInitializationService AppInitializationService
@inject ILogger<AppInitializationOverlay> Logger
@implements IDisposable

@if (AppInitializationService.IsInitializing || (_validationFailed && !AppInitializationService.IsInitializing))
{
    <MudOverlay Visible="true" ZIndex="10000" Class="initialization-overlay">
        <div class="overlay-content">
            @if (AppInitializationService.IsInitializing)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Large" />
                <MudText Typo="Typo.h6" Class="mt-4">Загрузка...</MudText>
            }
            else if (_validationFailed)
            {
                <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Large" Color="Color.Error" />
                <MudText Typo="Typo.h6" Class="mt-4" Align="Align.Center">Ошибка валидации</MudText>
                <MudText Typo="Typo.body2" Class="mt-4" Align="Align.Center" Style="opacity: 0.7;">
                    Приложение заблокировано. Пожалуйста, откройте приложение через Telegram.
                </MudText>
            }
        </div>
    </MudOverlay>
}

@if (_validationFailed && !AppInitializationService.IsInitializing)
{
    <div class="ui-blocker"></div>
}

<style>
    .initialization-overlay {
        background-color: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .overlay-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: white;
        text-align: center;
        padding: 2rem;
    }

    .ui-blocker {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 10001;
        background: transparent;
        pointer-events: all;
        cursor: not-allowed;
        user-select: none;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
    }
</style>

@code {
    private bool _validationFailed = false;
    private string _errorMessage = string.Empty;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        
        // Подписываемся на изменения результата валидации
        if (TelegramWebAppStateService != null)
        {
            TelegramWebAppStateService.ValidationResultChanged += OnValidationResultChanged;
            
            // Проверяем текущее состояние
            if (TelegramWebAppStateService.ValidationResult != null)
            {
                _ = InvokeAsync(() => OnValidationResultChanged());
            }
        }

        // Подписываемся на изменения состояния инициализации
        if (AppInitializationService != null)
        {
            AppInitializationService.InitializationStateChanged += OnInitializationStateChanged;
        }
    }

    private void OnValidationResultChanged()
    {
        if (TelegramWebAppStateService?.ValidationResult != null)
        {
            var result = TelegramWebAppStateService.ValidationResult;
            
            if (!result.IsValid)
            {
                _validationFailed = true;
                _errorMessage = result.ErrorMessage ?? "Неизвестная ошибка валидации";
            }
            else
            {
                _validationFailed = false;
            }
            
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnInitializationStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (TelegramWebAppStateService != null)
        {
            TelegramWebAppStateService.ValidationResultChanged -= OnValidationResultChanged;
        }
        
        if (AppInitializationService != null)
        {
            AppInitializationService.InitializationStateChanged -= OnInitializationStateChanged;
        }
    }
}

