@using SetRep.MiniApp.Client.Services
@using SetRep.Shared.DTO
@using SetRep.Shared.Telegram
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop

@inject ITelegramWebAppService? TelegramWebAppService
@inject ITelegramWebAppStateService? TelegramWebAppStateService
@inject IAppInitializationService? AppInitializationService
@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject ILogger<TelegramWebAppInitializer>? Logger
@implements IAsyncDisposable
@rendermode InteractiveServer

@* Компонент для инициализации и валидации Telegram WebApp данных при загрузке приложения *@

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && TelegramWebAppService != null && TelegramWebAppStateService != null)
        {
            await InitializeApplicationAsync();
        }
    }

    private async Task InitializeApplicationAsync()
    {
        try
        {
            AppInitializationService?.SetInitializing(true);
            Logger?.LogInformation("Начало валидации Telegram WebApp данных");
            
            // Валидация Telegram WebApp
            var validationResult = await TelegramWebAppService.GetAndValidateAsync();

            if (!validationResult.IsValid)
            {
                Logger?.LogWarning("Ошибка валидации Telegram WebApp данных: {Error}", 
                    validationResult.ErrorMessage);
                
                TelegramWebAppStateService.SetValidationResult(validationResult);
                AppInitializationService?.SetInitializing(false);
                return;
            }

            if (validationResult.Data?.User == null)
            {
                Logger?.LogWarning("Данные пользователя отсутствуют в результате валидации");
                TelegramWebAppStateService.SetValidationResult(new TelegramWebAppValidationResult
                {
                    IsValid = false,
                    ErrorMessage = "Данные пользователя отсутствуют"
                });
                AppInitializationService?.SetInitializing(false);
                return;
            }

            Logger?.LogInformation("Telegram WebApp данные успешно валидированы. User ID: {UserId}", 
                validationResult.Data.User.TelegramId);

            // Валидация пользователя
            await EnsureUserExistsAsync(validationResult.Data.User);

            // Настройка темы и включение кнопки назад параллельно
            var themeTask = InitializeThemeAsync();

            // Сохраняем успешный результат в сервисе состояния
            TelegramWebAppStateService.SetValidationResult(validationResult);
            
            // Завершаем инициализацию
            AppInitializationService?.SetInitializing(false);
            Logger?.LogInformation("Инициализация приложения завершена успешно");
        }
        catch (Exception ex)
        {
            Logger?.LogError(ex, "Критическая ошибка при инициализации приложения");
            if (TelegramWebAppStateService != null)
            {
                TelegramWebAppStateService.SetValidationResult(new TelegramWebAppValidationResult
                {
                    IsValid = false,
                    ErrorMessage = $"Критическая ошибка: {ex.Message}"
                });
            }
            AppInitializationService?.SetInitializing(false);
        }
    }

    private async Task InitializeThemeAsync()
    {
        try
        {
            var startTime = DateTime.UtcNow;
            var timeout = TimeSpan.FromSeconds(1);

            while (DateTime.UtcNow - startTime < timeout)
            {
                try
                {
                    var isReady = await JSRuntime.InvokeAsync<bool>("telegramThemeHelper.isReady");

                    if (isReady)
                    {
                        var theme = await JSRuntime.InvokeAsync<string>("telegramThemeHelper.getTheme");
                        Logger?.LogInformation("Загружена тема Telegram: {Theme}", theme);
                        return;
                    }
                }
                catch (Exception ex)
                {
                    Logger?.LogDebug(ex, "Ожидание загрузки веб-приложения Telegram...");
                }

                await Task.Delay(50);
            }

            Logger?.LogWarning("Веб-приложение Telegram не загрузилось вовремя, используется тема по умолчанию");
        }
        catch (Exception ex)
        {
            Logger?.LogError(ex, "Ошибка при инициализации темы Telegram");
        }
    }

    private async Task EnsureUserExistsAsync(TelegramUser telegramUser)
    {
        try
        {
            UserDto? foundUser = null;

            // Сначала ищем по TelegramId
            var response = await HttpClient.GetAsync($"api/Users/telegram/{telegramUser.TelegramId}");

            if (response.IsSuccessStatusCode)
            {
                foundUser = await response.Content.ReadFromJsonAsync<UserDto>();
                telegramUser.Id = foundUser.Id;
                Logger?.LogDebug("Пользователь найден по Telegram ID {TelegramId}", telegramUser.TelegramId);
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                Logger?.LogInformation("Пользователь с Telegram ID {TelegramId} не найден, создаем нового", telegramUser.TelegramId);

                var newUser = new UserDto
                {
                    Id = telegramUser.Id != Guid.Empty ? telegramUser.Id : Guid.NewGuid(),
                    TelegramId = telegramUser.TelegramId,
                    Name = string.IsNullOrWhiteSpace(telegramUser.LastName)
                        ? telegramUser.FirstName
                        : $"{telegramUser.FirstName} {telegramUser.LastName}",
                    Username = telegramUser.Username ?? string.Empty,
                    CreatedAt = DateTime.UtcNow
                };

                var createResponse = await HttpClient.PostAsJsonAsync("api/Users", newUser);

                if (createResponse.IsSuccessStatusCode)
                {
                    telegramUser.Id = newUser.Id;
                    Logger?.LogInformation("Пользователь успешно создан с ID {UserId} и сохранен в сервис состояния", newUser.Id);
                }
                else
                {
                    var errorContent = await createResponse.Content.ReadAsStringAsync();
                    Logger?.LogError("Ошибка при создании пользователя: {StatusCode} - {Error}",
                        createResponse.StatusCode, errorContent);
                }
            }
            
        }
        catch (Exception ex)
        {
            Logger?.LogError(ex, "Ошибка при проверке/создании пользователя");
        }
    }

    public async ValueTask DisposeAsync()
    {
        await Task.CompletedTask;
    }
}

